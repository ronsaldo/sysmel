            machoSegmentName: #__DWARF;
            readable: false;
            debugging: true;
            yourself).

    public method dwarf::debugAbbreviationsSection ::=> AsmSectionDirective
        := self addElement: (AsmSectionDirective new
            name: #".debug_abbrev";
            machoSectionName: #__debug_abbrev;
            machoSegmentName: #__DWARF;
