public final class Dwarf::DebugInfoFlagAttribute superclass: Dwarf::DebugInfoEntryAttribute; definition: {
    public field value => Boolean.

    public override method writeAbbreviationFormWith: (writer: Dwarf::AsmWriter) ::=> Void := {
