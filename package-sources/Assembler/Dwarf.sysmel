            yourself).
}.

Dwarf::AsmWriter definition: {
    public field compilationUnit => Dwarf::DebugInfoEntry.
    public field debugInfoProgramEntity => AsmProgramEntity.
    public field dwarfSize => Size.
    public field pointerSize => Size.

    public field sourceObjectCode => AsmObjectCode.
    public field lineWriter => Dwarf::DebugLineWriter.
    public field generateCFI => Boolean.

    public field abbreviationsStart => AsmSymbol.
    public field debugInfoStart => AsmSymbol.
    public field debugInfoEnd => AsmSymbol.
    public field debugLineStart => AsmSymbol.

    public field version => UInt8.
    public field stringTable => OrderedCollection.
    public field stringTableDictionary => Dictionary.
    public field abbreviationsDictionary => PluggableDictionary.
    public field abbreviations => OrderedCollection.
    public field debugInformationEntrySymbolDictionary => ObjectPointerDictionary.

    public field debugLineStream => AsmStreamBuilder.
    public field debugAbbreviationsStream => AsmStreamBuilder.
    public field debugInfoStream => AsmStreamBuilder.
    public field debugFrameStream => AsmStreamBuilder.
    public field activeStream => AsmStreamBuilder.

    public override method initialize => Void := {
        super initialize.
        version := 4u8.
        dwarfSize := 4sz.
        stringTable := OrderedCollection new.
        stringTableDictionary := Dictionary new.
        debugInformationEntrySymbolDictionary := ObjectPointerDictionary new.
        abbreviationsDictionary := PluggableDictionary new
            hashFunction: {:(AnyValue)key :: Size | (key downCastTo: Dwarf::DebugInfoEntry) abbreviationHash };
            equalsFunction: {:(AnyValue)a :(AnyValue)b :: Boolean | (a downCastTo: Dwarf::DebugInfoEntry) abbreviationEquals: (b downCastTo: Dwarf::DebugInfoEntry)};
            yourself.
        abbreviations := OrderedCollection new.
    }.
    
    public method writeCompilationUnit: (compilationUnit: Dwarf::DebugInfoEntry) toProgramEntity: (debugInfoProgramEntity: AsmProgramEntity) pointerSize: (pointerSize: Size) ::=> Void := {
        self
            compilationUnit: compilationUnit;
            debugInfoProgramEntity: debugInfoProgramEntity;
            pointerSize: pointerSize.

        abbreviationsStart := AsmSymbol new
            name: #abbreviationsStart;
            makePrivate;
            yourself.

        debugLineStart := AsmSymbol new
            name: #debugLineStart;
            makePrivate;
            yourself.

        debugInfoStart := AsmSymbol new
            name: #debugInfoStart;
            makePrivate;
            yourself.

        debugInfoEnd := AsmSymbol new
            name: #debugInfoStart;
            makePrivate;
            yourself.

        debugLineStream := debugInfoProgramEntity newStreamBuilder
            dwarf::debugLineSection;
            label: debugLineStart;
            yourself.

        debugFrameStream := debugInfoProgramEntity newStreamBuilder
            dwarf::debugFrameSection;
            yourself.

        compilationUnit stmtList: (debugLineStart immediateSectionRelative: dwarfSize) asConstantExpression.

        sourceObjectCode ifNotNil: {
            ## Generate the line information.
            lineWriter ifNotNil: {
                lineWriter writeSourceLocationForSections: sourceObjectCode sections ontoStreamBuilder: debugLineStream pointerSize: pointerSize.
                debugLineStream endLabel: debugLineStart
            }.

            ## Generate the CFI.
            generateCFI ifTrue: {
                Dwarf::CallFrameInformationWriter new
                    dwarfSize: dwarfSize;
                    compilationTarget: debugInfoProgramEntity compilationTarget;
                    writeCallFrameInformationForSections: sourceObjectCode sections ontoStreamBuilder: debugFrameStream pointerSize: pointerSize
            }
        }.

        self 
            prepareForWriting;
            writeStrings;
            writeAbbreviations;
            writeDebugInfo
    }.

    public method internString: (string: String) ::=> AsmSymbol := {
        stringTableDictionary at: string ifAbsentPut: {:: AsmSymbol |
            let stringSymbol := AsmSymbol new
                name: #debugString;
                makePrivate;
                yourself.
            stringTable add: string -> stringSymbol.
            stringSymbol
        }
    }.

    public method writeString: (string: String) ::=> Void := {
        let stringSymbol => AsmSymbol := stringTableDictionary at: string.
        activeStream expression: (stringSymbol immediateSectionRelative: dwarfSize) asConstantExpression size: dwarfSize
    }.

    public method writeSectionRelativeOffset: (address: AsmConstantExpression) ::=> Void := {
        activeStream expression: address size: dwarfSize
    }.

    public method writeAddress: (address: AsmConstantExpression) ::=> Void := {
        activeStream expression: address size: pointerSize
    }.

    public method writeReferenceToDIE: (die: Dwarf::DebugInfoEntry) ::=> Void := {
        let symbol => AsmSymbol := debugInformationEntrySymbolDictionary at: die.
        activeStream expression: (symbol immediateSectionRelative: dwarfSize) asConstantExpression size: dwarfSize
    }.

    public method recordAbbreviation: (die: Dwarf::DebugInfoEntry) ::=> Void := {
        abbreviationsDictionary at: die ifAbsentPut: {:: Association |
            let assoc := Association key: (abbreviations size + 1sz) value: die.
            abbreviations add: assoc.
            assoc
        }.
    }.

    public method prepareForWriting => Void := {
        compilationUnit withAllChildrenDo: {:(Dwarf::DebugInfoEntry)die :: Void |
            debugInformationEntrySymbolDictionary at: die put: (AsmSymbol new
                name: #die;
                makePrivate;
                yourself).

            self recordAbbreviation: die.
            die attributesDo: {:(Dwarf::DebugInfoEntryAttribute)attribute :: Void |
                attribute prepareForWritingAssemblyWith: self
            }
        }
    }.

    public method writeStrings => Void := {
        let stream := debugInfoProgramEntity newStreamBuilder
            dwarf::debugStringSection;
            yourself.
        stringTable do: {:(Association)stringAndSymbol :: Void |
            stream
                label: stringAndSymbol value;
                string: stringAndSymbol key nullTerminated: true
        }
    }.

    public method writeAbbreviations => Void := {
        debugAbbreviationsStream := debugInfoProgramEntity newStreamBuilder
            dwarf::debugAbbreviationsSection;
            label: abbreviationsStart;
            yourself.
        activeStream := debugAbbreviationsStream.
        abbreviations do: {:(Association)abbreviationIdAndDie :: Void |
            activeStream uleb128: abbreviationIdAndDie key.
            let debugInfoEntry => Dwarf::DebugInfoEntry := abbreviationIdAndDie value.
            abbreviationIdAndDie value writeAbbreviationWith: self
        }.

        activeStream byte: 0u8
    }.

    public method writeDebugInfo => Void := {
        debugInfoStream := debugInfoProgramEntity newStreamBuilder
            dwarf::debugInfoSection;
            yourself.
        activeStream := debugInfoStream.

        dwarfSize = 4sz ifTrue: {
            activeStream dwordExpression: debugInfoEnd dword asConstantExpression - debugInfoStart dword asConstantExpression.
        } ifFalse: {
            activeStream dword: 16rFFFFFFFF u32.
            activeStream qwordExpression: debugInfoEnd qword asConstantExpression - debugInfoStart qword asConstantExpression.
        }.

        debugInfoStream label: debugInfoStart.

        version = 4u8 ifTrue: {
            activeStream
                word: 4u16;
                expression: (abbreviationsStart immediateSectionRelative: dwarfSize) asConstantExpression size: dwarfSize;
                byte: pointerSize asUInt8.
        }.

        version = 5u8 ifTrue: {
            activeStream
                word: 4u16;
                byte: Dwarf::DW_UT_compile asUInt8;
                byte: pointerSize asUInt8;
                expression: (abbreviationsStart immediateSectionRelative: dwarfSize) asConstantExpression size: dwarfSize.
        }.

        self writeDebugInfoEntry: compilationUnit.

        debugInfoStream label: debugInfoEnd.
    }.

    public method writeDebugInfoEntry: (debugInfoEntry: Dwarf::DebugInfoEntry) ::=> Void := {
        let abbreviation := abbreviationsDictionary at: debugInfoEntry.
        let symbol := debugInformationEntrySymbolDictionary at: debugInfoEntry.
        
        activeStream
            label: symbol;
            uleb128: abbreviation key.

        debugInfoEntry attributesDo: {:(Dwarf::DebugInfoEntryAttribute)attribute :: Void |
            attribute writeAttributeWith: self
        }.
        debugInfoEntry shouldEmitSiblingAttribute ifTrue: {
            self writeReferenceToDIE: debugInfoEntry nextSibling
        }.

        debugInfoEntry hasChildren ifTrue: {
            debugInfoEntry childrenDo: {:(Dwarf::DebugInfoEntry)child :: Void |
                self writeDebugInfoEntry: child
            }.
            activeStream byte: 0u8.
        }.
    }.

    public method uleb128Size: (value: UInt64) ::=> Size := {
        let result mutable := 0sz.
        let currentValue mutable := value.
        do: {
            let byte := (currentValue & 127u64) asUInt8.
            currentValue := currentValue >> 7u64.
            result := result + 1sz.
        } while: (currentValue ~= 0u64).

        result
    }.

    public method sleb128Size: (value: Int64) ::=> Size := {
        let result mutable := 0sz.
        let more mutable := true.

        let currentValue mutable := value.
        while: more do: {
            let byte := (currentValue & 127i64) asInt8.
            currentValue := currentValue >> 7i64.
            
            let byteHasSign := (byte & 16r40 i8) ~= 0i8.
            ((currentValue = 0i64) && byteHasSign not) || (currentValue == -1i64 && byteHasSign) ifTrue: {
                more := false
            }.

            result := result + 1sz.
        }.
        result
    }.
}.

AsmProgramEntity extend: {
    public method buildDwarfCompileUnitWith: (aBlock: (Dwarf::DebugInfoEntry, Dwarf::Builder) => Void) ::=> AsmProgramEntity := {
        let compileUnit := Dwarf::Builder new
            compileUnit: aBlock.
        
        let debugInfoProgramEntity := self newProgramEntity.
        debugInfoProgramEntity isDebuggingInformation: true.
        Dwarf::AsmWriter new
            writeCompilationUnit: compileUnit toProgramEntity: debugInfoProgramEntity pointerSize: compilationTarget pointerSize.

        debugInfoProgramEntity
    }.
}.

Dwarf::SectionWriter definition: {
    public field dwarfSize => Size.
    public field pointerSize => Size.
    public field dwarfVersion => UInt16.
    private field programRelocations => OrderedCollection.
    public field out => ByteStream.

    public override method initialize => Void := {
        programRelocations := OrderedCollection new.
        dwarfSize := 4sz.
        dwarfVersion := 4u16.
    }.

    public method alignTo: (alignment: Size) extraSize: (extraSize: Size) paddingWith: (padding: UInt8) ::=> Void := {
        let alignedSize := out size + extraSize alignedTo: alignment.
        let paddingSize mutable := alignedSize - out size - extraSize.
        while: (paddingSize > 0sz) do: {
            out nextPut: padding
        } continueWith: (paddingSize := paddingSize - 1sz)
    }.

    public method makeBytesDuring: (aBlock: () => Void) ::=> ByteArray := {
        let byteStream := ByteStream new.
        let oldOut := out.
        out := byteStream.
        aBlock().
        out := oldOut.
        byteStream asByteArray
    }.

    public method byte: (value: UInt8) ::=> Void := {
        out nextPut: value
    }.

    public method word: (value: UInt16) ::=> Void := {
        out nextPutUInt16: value
    }.

    public method dword: (value: UInt32) ::=> Void := {
        out nextPutUInt32: value
    }.

    public method qword: (value: UInt64) ::=> Void := {
        out nextPutUInt64: value
    }.

    public method dwarfPointerWord: (value: UInt64) ::=> Void := {
        dwarfSize = 4sz
            ifTrue: (self dword: value asUInt32)
            ifFalse: (self qword: value)
    }.

    public method pointerWord: (value: UInt64) ::=> Void := {
        pointerSize = 4sz
            ifTrue: (self dword: value asUInt32)
            ifFalse: (self qword: value)
    }.

    public method cstring: (value: String) ::=> Void := {
        out nextPutString: value; nextPut: 0u8.
    }.

    public method initialLength: (length: UInt64) ::=> Void := {
        dwarfSize = 4sz ifTrue: {
            self dword: length asUInt32.
        } ifFalse: {
            self
                dword: 16rFFFFFFFF u32;
                qword: length.
        }
    }.

    public method initialLengthSize ::=> Size
        := dwarfSize = 4sz ifTrue: 4sz ifFalse: 12sz.

    public method uleb128: (value: UInt64) ::=> Void := {
        let currentValue mutable := value.
        do: {
            let byte := (currentValue & 127u64) asUInt8.
            currentValue := currentValue >> 7u64.
            out nextPut: byte | (currentValue ~= 0u64 ifTrue: 128u8 ifFalse: 0u8)
        } while: (currentValue ~= 0u64)
    }.

    public method sleb128: (value: Int64) ::=> Void := {
        let more mutable := true.

        let currentValue mutable := value.
        while: more do: {
            let byte mutable := (currentValue & 127i64) asInt8.
            currentValue := currentValue >> 7i64.
            
            let byteHasSign := (byte & 16r40 i8) ~= 0i8.
            ((currentValue = 0i64) && byteHasSign not) || (currentValue == -1i64 && byteHasSign) ifTrue: {
                more := false
            } ifFalse: {
                byte := byte | 16r80 i8.
            }.

            out nextPut: byte asUInt8
        }.
    }.
}.

Dwarf::DebugLineWriter definition: {
    public field defaultIsStatement => Boolean.
    public field maxNumberOfOperationsPerInstruction => UInt32.
    public field minimumInstructionLength => UInt32.
    public field opcodeBase => UInt32.

    public field directoryDictionary => Dictionary.
    public field directories => OrderedCollection.

    public field fileDictionary => Dictionary.
    public field files => OrderedCollection.

    public field minLine => Int32.
    public field maxLine => Int32.
    public field lineAdvance => Int32.
    public field lineBase => Int32.
    public field lineRange => Int32.

    private field regAddress => UInt32.
    private field regAddressSection => AsmSymbol.
    private field regOpIndex => UInt32.
    private field regFile => UInt32.
    private field regLine => UInt32.
    private field regColumn => UInt32.
    private field regIsStatement => Boolean.
    private field regBasicBlock => Boolean.
    private field regEndSequence => Boolean.
    private field regPrologueEnd => Boolean.
    private field regEpilogueBegin => Boolean.
    private field regISA => UInt32.
    private field regDiscriminator => Boolean.

    public override method initialize => Void := {
        super initialize.

        defaultIsStatement := true.
        maxNumberOfOperationsPerInstruction := 1u32.
        minimumInstructionLength := 1u32.
        opcodeBase := 13u32.

        directoryDictionary := Dictionary new.
        directories := OrderedCollection new.

        fileDictionary := Dictionary new.
        files := OrderedCollection new.
    }.

    public method addSourceDirectory: (directory: String) ::=> UInt32 := {
        directory isNil || (directory = "") ifTrue: {return: 0u32}.

        directoryDictionary at: directory ifAbsentPut: {:: UInt32 |
            directories add: (directory withoutSuffix: "/").
            directories size asUInt32
        }
    }.

    public method addSourceCode: (sourceCode: SourceCode) ::=> UInt32 := {
        sourceCode ifNil: (return: 0u32).

        fileDictionary at: sourceCode ifAbsentPut: {:: UInt32 |
            let directoryIndex := self addSourceDirectory: sourceCode directory.
            files add: (directoryIndex, sourceCode name).
            files size asUInt32
        }
    }.

    public method computeLineRangeForSections: (sections: SequenceableCollection) ::=> Void := {
        minLine := Int32 maxVal.
        maxLine := Int32 minVal.
        let previousLine mutable := 1i32.

        sections do: {:(AsmObjectCodeSection)section :: Void |
            section executable ifTrue: {
                section debugSourcePositions ifNotNil: {:(OrderedOffsetTable)sourcePositions | 
                    sourcePositions values do: {:(SourcePosition)each :: Void |
                        each ifNil: {return: void}.
                        self addSourceCode: each sourceCode.

                        let startLine := each startLine asInt32.
                        let lineAdvance := startLine - previousLine.
                        lineAdvance abs < 8i32 ifTrue: {
                            minLine := minLine min: lineAdvance.
                            maxLine := maxLine max: lineAdvance.
                        }.
                        previousLine := startLine.
                    }
                }
            }
        }.

        minLine > maxLine ifTrue: {
            minLine := maxLine := 1i32
        }.

        lineBase := (minLine min: 127i32) max: -128i32.
        lineRange := (maxLine - minLine min: 255i32) max: 1i32.
    }.

    public method writeSourceLocationForSections: (sections: SequenceableCollection) onto: (targetSection: AsmObjectCodeSection) pointerSize: (pointerSize: Size) ::=> Void := {
        self pointerSize: pointerSize.
        self computeLineRangeForSections: sections.

        let programHeader := self generateProgramHeader.
        let program := self generateProgramForSections: sections.

        out := ByteStream new.
        dwarfSize = 4sz ifTrue: {
            self dword: (programHeader size + program size + dwarfSize + 2sz) asUInt32.
        } ifFalse: {
            self
                dword: 16rFFFFFFFF u32;
                qword: (programHeader size + program size + dwarfSize + 2sz) asUInt64.
        }.

        self word: dwarfVersion.
        dwarfSize = 4sz ifTrue: {
            self dword: programHeader size asUInt32.
        } ifFalse: {
            self qword: programHeader size asUInt64.
        }.

        out nextPutAll: programHeader.
        let relocationAddressBase := out size + targetSection writeOffset.
        out nextPutAll: program.

        targetSection writeUnallocatedBytes: out asByteArray.
        programRelocations do: {:(AsmObjectCodeRelocation)eachRelocation :: Void |
            eachRelocation offset: relocationAddressBase + eachRelocation offset.
            targetSection newRelocations add: eachRelocation
        }
    }.

    public method writeSourceLocationForSections: (sections: SequenceableCollection) ontoStreamBuilder: (debugLineStreamBuilder: AsmStreamBuilder) pointerSize: (pointerSize: Size) ::=> Void := {
        self pointerSize: pointerSize.
        self computeLineRangeForSections: sections.

        let programHeader := self generateProgramHeader.
        let program := self generateProgramForSections: sections.

        out := ByteStream new.
        dwarfSize = 4sz ifTrue: {
            self dword: (programHeader size + program size + dwarfSize + 2sz) asUInt32.
        } ifFalse: {
            self
                dword: 16rFFFFFFFF u32;
                qword: (programHeader size + program size + dwarfSize + 2sz) asUInt64.
        }.

        self word: dwarfVersion.
        dwarfSize = 4sz ifTrue: {
            self dword: programHeader size asUInt32.
        } ifFalse: {
            self qword: programHeader size asUInt64.
        }.

        out nextPutAll: programHeader.
        let relocationAddressBase := out size.
        out nextPutAll: program.

        debugLineStreamBuilder bytes: out asByteArray relocations: programRelocations offset: relocationAddressBase
    }.

    public method generateProgramHeader => ByteArray := {
        out := ByteStream new.

		self
			byte: 1u8 #* minimum_instruction_length *#;
			byte: 1u8 #* maximum_operations_per_instruction *#;
			byte: (defaultIsStatement ifTrue: 1u8 ifFalse: 0u8);
			byte: lineBase asUInt8;
			byte: lineRange asUInt8;
			byte: opcodeBase asUInt8 #* opcode_base *#;
			
			byte: 0u8; #* DW_LNS_copy *#
			byte: 1u8; #* DW_LNS_advance_pc *#
			byte: 1u8; #* DW_LNS_advance_line *#
			byte: 1u8; #* DW_LNS_set_file *#
			byte: 1u8; #* DW_LNS_set_column *#
			byte: 0u8; #* DW_LNS_negate_stmt *#
			byte: 0u8; #* DW_LNS_set_basic_block *#
			byte: 0u8; #* DW_LNS_const_add_pc *#
			byte: 1u8; #* DW_LNS_fixed_advance_pc *#
			byte: 0u8; #* DW_LNS_set_prologue_end *#
			byte: 0u8; #* DW_LNS_set_epilogue_begin *#
			byte: 1u8; #* DW_LNS_set_isa *#
			
			yourself.
		
		## Directories
		directories do: { :(String)eachDirectory :: Void |
            self cstring: eachDirectory
        }.
		self byte: 0u8.
		
		## Files
		files do: { :(Array)file :: Void |
			self
				cstring: file second;
				uleb128: file first asUInt64;
				uleb128: 0u64;
				uleb128: 0u64.
        }.
		self byte: 0u8.
        
        out asByteArray
    }.

    public method generateProgramForSections: (sections: SequenceableCollection) ::=> ByteArray := {
        out := ByteStream new.

		regAddress := 0u32.
		regAddressSection := nil.
		regOpIndex := 0u32.
		regFile := 1u32.
		regLine := 1u32.
		regColumn := 0u32.
		regIsStatement := defaultIsStatement.
		regBasicBlock := false.
		regEndSequence := false.
		regPrologueEnd := false.
		regEpilogueBegin := false.
		regISA := 0u32.
		regDiscriminator := false.

        sections do: {:(AsmObjectCodeSection)section :: Void |
            section executable ifTrue: {
                section debugSourcePositions ifNotNil: {:(OrderedOffsetTable)debugSourcePositions :: Void |
                    let sectionSymbol := AsmSymbol new
                        section: section;
                        makePrivate;
                        yourself.
                    debugSourcePositions values doWithIndex: {:(SourcePosition)sourcePosition :(Size)index :: Void |
                        let pc := debugSourcePositions keys uint32At: index.
                        self emitSourcePosition: sourcePosition section: sectionSymbol pc: pc.
                    }.
                }
            }
        }.

        self endSequence.
        out asByteArray
    }.

    public method emitSourcePosition: (sourcePosition: SourcePosition) section: (section: AsmSymbol) pc: (pc: UInt32) ::=> Void := {
        regAddressSection ~~ section ifTrue: {
            self setSection: section pc: pc
        }.
        sourcePosition ifNil: {
            return: void
        }.

        let sourceCode := sourcePosition sourceCode.
        let startLine := sourcePosition startLine asUInt32.
        let startColumn := sourcePosition startColumn asUInt32.

        (regColumn = startColumn) && (regLine = startLine) ifTrue: (return: void).

        self
            setFile: (sourceCode ifNil: 1u32 ifNotNil: (fileDictionary at: sourceCode));
            setColumn: startColumn.

        let pcAdvance := pc - regAddress.
        let lineAdvance := startLine asInt32 - regLine asInt32.
        self advanceLine: lineAdvance pc: pcAdvance andEmitWithOperationIndex: 0u8.
    }.

    public method setFile: (fileIndex: UInt32) ::=> Void := {
        regFile = fileIndex ifFalse: {
            self byte: Dwarf::DW_LNS_set_file asUInt8; uleb128: fileIndex asUInt64.
            regFile := fileIndex
        }
    }.

    public method setColumn: (column: UInt32) ::=> Void := {
        regColumn = column ifFalse: {
            self byte: Dwarf::DW_LNS_set_column asUInt8; uleb128: column asUInt64.
            regColumn := column
        }
    }.

    public method advanceLine: (lineAdvance: Int32) pc: (pcAdvance: UInt32) andEmitWithOperationIndex: (operationIndex: UInt8) ::=> Void := {
        let operationAdvance := pcAdvance / minimumInstructionLength.

        let opcode := (lineAdvance - lineBase) + (lineRange * operationAdvance asInt32) + opcodeBase asInt32.
        (0i32 <= opcode) && (opcode <= 255i32) && (lineAdvance - lineBase < lineRange) && (lineAdvance >= lineBase) ifTrue: {
            self byte: opcode asUInt8.
            regLine := (regLine asInt32 + lineAdvance) asUInt32.
            regAddress := regAddress + pcAdvance.
        } ifFalse: {
            self
                advanceLine: lineAdvance;
                advancePC: pcAdvance;
                copyRow
        }.
    }.

    public method advanceLine: (advance: Int32) ::=> Void := {
        self byte: Dwarf::DW_LNS_advance_line asUInt8; sleb128: advance asInt64.
        regLine := (regLine asInt32 + advance) asUInt32.
    }.

    public method advancePC: (advance: UInt32) ::=> Void := {
        self byte: Dwarf::DW_LNS_advance_pc asUInt8; uleb128: advance asUInt64.
        regAddress := regAddress + advance
    }.

    public method copyRow => Void := {
        self byte: Dwarf::DW_LNS_copy asUInt8.
        regDiscriminator := false.
        regBasicBlock := false.
        regPrologueEnd := false.
        regEpilogueBegin := false.
    }.

    public method setSection: (section: AsmSymbol) pc: (pc: UInt32) ::=> Void := {
        self byte: 0u8; uleb128: (1sz + pointerSize) asUInt64; byte: Dwarf::DW_LNE_set_address asUInt8; relocatableAddress: pc inSection: section
    }.

    public method relocatableAddress: (address: UInt32) inSection: (section: AsmSymbol) ::=> Void := {
        pointerSize = 4sz ifTrue: {
            programRelocations add: (AsmObjectCodeRelocationAbsoluteInt32 new
                symbol: section;
                offset: out size;
                addend: address asInt32;
                yourself).
            self dword: 0u32.
        } ifFalse: {
            programRelocations add: (AsmObjectCodeRelocationAbsoluteInt64 new
                symbol: section;
                offset: out size;
                addend: address asInt64;
                yourself).
            self qword: 0u64.
        }.

        regAddressSection := section.
        regAddress := address.
    }.

    public method endSequence => Void := {
        self byte: 0u8; uleb128: 1u64; byte: Dwarf::DW_LNE_end_sequence asUInt8
    }.
}.

public final class Dwarf::CallFrameInformationWriter superclass: Dwarf::SectionWriter; definition: {
    public field compilationTarget => AsmCompilationTarget.
    public field isEHFrame => Boolean.
    public field cieVersion => UInt8.
    public field codeAlignmentFactor => UInt64.
    public field dataAlignmentFactor => Int64.
    public field returnAddressRegister => UInt8.

    private field cieIsEmitted => Boolean.
    private field cfiRelocations => OrderedCollection.
    private field targetSectionSymbol => AsmSymbol.
    private field relocationBaseOffset => Size.

    public override method initialize => Void := {
        super initialize.
        cieVersion := 4u8.
        codeAlignmentFactor := 1u64.
        cfiRelocations := OrderedCollection new.
    }.

    public method writeCallFrameInformationForSections: (sections: SequenceableCollection) onto: (targetSection: AsmObjectCodeSection) pointerSize: (pointerSize: Size) ::=> Void := {
        self
            pointerSize: pointerSize;
            dataAlignmentFactor: pointerSize asInt64.

        returnAddressRegister := compilationTarget dwarf::returnAddressRegister asUInt8.

        targetSectionSymbol := AsmSymbol new
            section: targetSection;
            makePrivate;
            yourself.

        out := ByteStream new.
        sections do: {:(AsmObjectCodeSection)section :: Void |
            let sectionSymbol := AsmSymbol new
                section: section;
                makePrivate;
                yourself.

            section executable ifTrue: {
                section frameDescriptions do: {:(AsmFrameDescriptionInformation)frameDescriptions :: Void |
                    self writeFrameDescription: frameDescriptions section: sectionSymbol.
                }.
            }.
        }.

        targetSection writeUnallocatedBytes: out asByteArray.
        targetSection newRelocations addAll: cfiRelocations.
    }.

    public method writeCallFrameInformationForSections: (sections: SequenceableCollection) ontoStreamBuilder: (streamBuilder: AsmStreamBuilder) pointerSize: (pointerSize: Size) ::=> Void := {
        self
            pointerSize: pointerSize;
            dataAlignmentFactor: pointerSize asInt64.

        returnAddressRegister := compilationTarget dwarf::returnAddressRegister asUInt8.

        targetSectionSymbol := AsmSymbol new
            makePrivate;
            yourself.

        out := ByteStream new.
        sections do: {:(AsmObjectCodeSection)section :: Void |
            let sectionSymbol := AsmSymbol new
                section: section;
                makePrivate;
                yourself.

            section executable ifTrue: {
                section frameDescriptions do: {:(AsmFrameDescriptionInformation)frameDescriptions :: Void |
                    self writeFrameDescription: frameDescriptions section: sectionSymbol.
                }.
            }.
        }.

        streamBuilder
            label: targetSectionSymbol;
            bytes: out asByteArray relocations: cfiRelocations offset: 0sz;
            endLabel: targetSectionSymbol
    }.

    public method ensureCommonInformationEntryIsEmitted => Void := {
        cieIsEmitted ifTrue: {return: void}.

        cieIsEmitted := true.

        relocationBaseOffset := out size + self initialLengthSize.
        let cieBytes := self makeBytesDuring: {:: Void |
            self
                dwarfPointerWord: -1u64; ## CIE_id
                byte: cieVersion; ## CIE version;
                cstring: ""; ## Augmentation;
                byte: self pointerSize asUInt8; ## addressSize
                byte: 0u8; ## segment size
                uleb128: codeAlignmentFactor asUInt64;
                sleb128: dataAlignmentFactor asInt64 negated;
                uleb128: returnAddressRegister asUInt64.

            self
                cfa::cfaInRegister: compilationTarget dwarf::stackPointerRegister asUInt64 withFactoredOffset: 1u32;
                cfa::registerValue: compilationTarget dwarf::returnAddressRegister asUInt64 atOffset: 1u32.

            self alignTo: pointerSize extraSize: self initialLengthSize paddingWith: 0u8
        }.

        self initialLength: cieBytes size asUInt64.
        out nextPutAll: cieBytes.
    }.

    public method writeFrameDescription: (frameDescription: AsmFrameDescriptionInformation) section: (sectionSymbol: AsmSymbol) ::=> Void := {
        self ensureCommonInformationEntryIsEmitted.

        relocationBaseOffset := out size + self initialLengthSize.
        let fdeBytes := self makeBytesDuring: {:: Void |
            self
                sectionRelativeDwarfPointer: targetSectionSymbol offset: 0i64; ## CIE
                pointer: sectionSymbol offset: frameDescription startOffset asInt64;
                pointerWord: (frameDescription endOffset - frameDescription startOffset) asUInt64.

            self emitFrameDescriptionInstructions: frameDescription.

            self alignTo: pointerSize extraSize: self initialLengthSize paddingWith: 0u8
        }.

        self initialLength: fdeBytes size asUInt64.
        out nextPutAll: fdeBytes.
    }.

    public method sectionRelativeDwarfPointer: (address: AsmSymbol) offset: (offset: Int64) ::=> Void := {
        dwarfSize = 4sz ifTrue: {
            cfiRelocations add: (AsmObjectCodeRelocationSectionRelativeInt32 new
                symbol: address;
                offset: relocationBaseOffset + out size;
                addend: offset asInt32;
                yourself).
            self dword: 0u32
        } ifFalse: {
            cfiRelocations add: (AsmObjectCodeRelocationSectionRelativeInt64 new
                symbol: address;
                offset: relocationBaseOffset + out size;
                addend: offset;
                yourself).
            self qword: 0u64
        }
    }.

    public method pointer: (address: AsmSymbol) offset: (offset: Int64) ::=> Void := {
        pointerSize = 4sz ifTrue: {
            cfiRelocations add: (AsmObjectCodeRelocationAbsoluteInt32 new
                symbol: address;
                offset: relocationBaseOffset + out size;
                addend: offset asInt32;
                yourself).
            self dword: 0u32
        } ifFalse: {
            cfiRelocations add: (AsmObjectCodeRelocationAbsoluteInt64 new
                symbol: address;
                offset: relocationBaseOffset + out size;
                addend: offset;
                yourself).
            self qword: 0u64
        }
    }.

    private field lastEmittedPC => UInt64.
    private field currentPC => UInt64.
    private field isInPrologue => Boolean.
    private field isInEpilogue => Boolean.

    private field hasFramePointerRegister => Boolean.
    private field framePointerRegister => UInt8.
    private field stackFrameSizeAtFramePointer => UInt32.
    private field stackFrameSize => UInt32.

    private field storedHasFramePointerRegister => Boolean.
    private field storedFramePointerRegister => UInt8.
    private field storedStackFrameSizeAtFramePointer => UInt32.
    private field storedStackFrameSize => UInt32.

    public method emitFrameDescriptionInstructions: (frameDescription: AsmFrameDescriptionInformation) ::=> Void := {
        currentPC := lastEmittedPC := frameDescription startOffset.
        isInPrologue := true.
        isInEpilogue := false.
        hasFramePointerRegister := false.
        framePointerRegister := 0u8.
        stackFrameSize := 1u32. ## Return address.

        frameDescription instructions do: {:(AsmCallFrameInformationInstruction)instruction :: Void |
            instruction dwarf::emitWith: self
        }.
    }.

    public method cfa::cfaInRegister: (register: UInt64) withOffset: (offset: UInt64) ::=> Void := {
        self byte: Dwarf::DW_OP_CFA_def_cfa asUInt8; uleb128: register; uleb128: offset.
    }.

    public method cfa::cfaInRegister: (register: UInt64) withFactoredOffset: (offset: UInt32) ::=> Void := {
        self cfa::cfaInRegister: register withOffset: (offset * pointerSize asUInt32) asUInt64
    }.

    public method cfa::registerValue: (register: UInt64) atOffset: (offset: UInt32) ::=> Void := {
        register <= 63u64 ifTrue: {
            self byte: (Dwarf::DW_OP_CFA_offset asUInt8 << 6u8) | register asUInt8; uleb128: offset asUInt64
        } ifFalse: {
            self byte: Dwarf::DW_OP_CFA_offset_extended asUInt8; uleb128: register; uleb128: offset asUInt64
        }
    }.

    public method cfa::restoreRegister: (register: UInt64) ::=> Void := {
        register <= 63u64 ifTrue: {
            self byte: (Dwarf::DW_OP_CFA_restore asUInt8 << 6u8) | register asUInt8
        } ifFalse: {
            self byte: Dwarf::DW_OP_CFA_restore_extended asUInt8; uleb128: register
        }
    }.

    public method setPCAddress: (newAddress: UInt64) ::=> Void := {
        currentPC := newAddress
    }.

    public method emitPCAddress => Void := {
        let advance := currentPC - lastEmittedPC.
        advance ~= 0u64 ifTrue: {
            let advanceFactor := advance / codeAlignmentFactor.
            (0u64 <= advanceFactor) && (advanceFactor <= 63u64) ifTrue: {
                self byte: (Dwarf::DW_OP_CFA_advance_loc asUInt8 << 6u8) | advanceFactor asUInt8.

            } ifFalse: {
                advanceFactor <= 16rFF u64 ifTrue: {
                    self byte: Dwarf::DW_OP_CFA_advance_loc1 asUInt8; byte: advanceFactor asUInt8
                } ifFalse: {
                    advanceFactor <= 16rFFFF u64 ifTrue: {
                        self byte: Dwarf::DW_OP_CFA_advance_loc2 asUInt8; word: advanceFactor asUInt16
                    } ifFalse: {
                        self assert: advanceFactor <= 16rFFFFFF u64.
                        self byte: Dwarf::DW_OP_CFA_advance_loc4 asUInt8; dword: advanceFactor asUInt32
                    }
                }
            }.

            lastEmittedPC := currentPC.
        }.

    }.

    public method endPrologue ::=> Void := {
        self assert: isInPrologue.
        isInPrologue := false.
    }.

    public method beginEpilogue ::=> Void := {
        self assert: isInEpilogue not.
        isInEpilogue := true.
        self emitPCAddress; byte: Dwarf::DW_OP_CFA_remember_state asUInt8.

        storedHasFramePointerRegister := hasFramePointerRegister.
        storedFramePointerRegister := framePointerRegister.
        storedStackFrameSizeAtFramePointer := stackFrameSizeAtFramePointer.
        storedStackFrameSize := stackFrameSize.
    }.

    public method endEpilogue ::=> Void := {
        self assert: isInEpilogue.
        isInEpilogue := false.
        self emitPCAddress; byte: Dwarf::DW_OP_CFA_restore_state asUInt8.

        hasFramePointerRegister := storedHasFramePointerRegister.
        framePointerRegister := storedFramePointerRegister.
        stackFrameSizeAtFramePointer := storedStackFrameSizeAtFramePointer.
        stackFrameSize := storedStackFrameSize.
    }.

    public method pushRegister: (register: AsmRegister) ::=> Void := {
        stackFrameSize := stackFrameSize + 1u32.
        self emitPCAddress.
        hasFramePointerRegister ifFalse: {
            self cfa::cfaInRegister: compilationTarget dwarf::stackPointerRegister asUInt64 withFactoredOffset: stackFrameSize
        }.
        
        self cfa::registerValue: (register dwarf::registerNumberForTarget: compilationTarget) asUInt64 atOffset: stackFrameSize
    }.

    public method popRegister: (register: AsmRegister) ::=> Void := {
        self assert: isInPrologue not. 
        stackFrameSize := stackFrameSize - 1u32.
        self emitPCAddress.
        hasFramePointerRegister ifFalse: {
            self cfa::cfaInRegister: compilationTarget dwarf::stackPointerRegister asUInt64 withFactoredOffset: stackFrameSize
        }.

        self cfa::restoreRegister: (register dwarf::registerNumberForTarget: compilationTarget) asUInt64
    }.

    public method saveFramePointer: (register: AsmRegister) offset: (offset: Int64) ::=> Void := {
        self assert: hasFramePointerRegister not.
        self assert: isInPrologue.

        self emitPCAddress.

        hasFramePointerRegister := true.
        framePointerRegister := (register dwarf::registerNumberForTarget: compilationTarget) asUInt8.
        stackFrameSizeAtFramePointer := stackFrameSize - (offset asUInt32 *pointerSize asUInt32) asUInt32. 
        self cfa::cfaInRegister: framePointerRegister asUInt64 withFactoredOffset: stackFrameSizeAtFramePointer
    }.

    public method restoreFramePointer: (register: AsmRegister) offset: (offset: Int64) ::=> Void := {
        self assert: isInPrologue not.
        self assert: isInEpilogue.
        self assert: hasFramePointerRegister.

        hasFramePointerRegister := false.
        stackFrameSize := stackFrameSizeAtFramePointer - (offset asUInt32 *pointerSize asUInt32) asUInt32.
        self
            emitPCAddress;
            cfa::cfaInRegister: compilationTarget dwarf::stackPointerRegister asUInt64 withFactoredOffset: stackFrameSize
    }.

    public method stackSizeAdvance: (increment: Int64) ::=> Void := {
        isInPrologue ifFalse: {return: void}.

        increment ~= 0i64 ifTrue: {
            stackFrameSize := (stackFrameSize asInt32 + increment asInt32 / self pointerSize asInt32) asUInt32.
            hasFramePointerRegister ifFalse: {
                self emitPCAddress.
                self cfa::cfaInRegister: compilationTarget dwarf::stackPointerRegister asUInt64 withFactoredOffset: stackFrameSize
            }.
        }
    }.
}.

