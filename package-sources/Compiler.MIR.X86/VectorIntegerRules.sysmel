            allocateRegisterForInstructionResult: instruction
    };
    forTargets: #(x86 x86_64) generateWith: {:(MIRInstruction)instruction :(MIRFunctionAsmCodeGenerator)codegen :: Void |
        let index := instruction secondOperand getConstantValueUInt8.
        codegen textSection
            x86::pextrd: (instruction resultRegister x86::int32For: codegen) src: (instruction firstOperandRegister x86::vector128For: codegen) mask: index asAsmImmediate
    }.

