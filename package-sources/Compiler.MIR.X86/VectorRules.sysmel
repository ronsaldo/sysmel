        instruction firstOperand isFloatingPoint ifTrue: {
            codegen textSection x86::movsd: (instruction secondOperandRegister x86::float64PointerWithOffset: instruction thirdOperandRegister for: codegen) src: (instruction firstOperandRegister x86::vector128For: codegen)
        } ifFalse: {
            codegen textSection x86::movq: (instruction secondOperandRegister x86::float64PointerWithOffset: instruction thirdOperandRegister for: codegen) src: (instruction firstOperandRegister x86::vector128For: codegen)
        }
    }.

MIR::Operation::StoreVector128
    forTargets: #(x86 x86_64) registerConstraintsWith: x86::vectorStorePointerRegisterContraints;
    forTargets: #(x86 x86_64) generateWith: {:(MIRInstruction)instruction :(MIRFunctionAsmCodeGenerator)codegen :: Void |
        instruction firstOperand isFloatingPoint ifTrue: {
