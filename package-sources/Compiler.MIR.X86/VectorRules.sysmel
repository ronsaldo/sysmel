                x86::movaps: (instruction secondOperandRegister x86::vector128PointerWithOffset: instruction thirdOperandRegister offset: 16i32 for: codegen) src: (instruction firstOperandRegister secondComponent x86::vector128For: codegen)
        } ifFalse: {
            codegen textSection
                x86::movdqa: (instruction secondOperandRegister x86::vector128PointerWithOffset: instruction thirdOperandRegister for: codegen) src: (instruction firstOperandRegister firstComponent x86::vector128For: codegen);
                x86::movdqa: (instruction secondOperandRegister x86::vector128PointerWithOffset: instruction thirdOperandRegister offset: 16i32 for: codegen) src: (instruction firstOperandRegister secondComponent x86::vector128For: codegen)
        }
