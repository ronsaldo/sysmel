        codegen textSection x86::movaps: (instruction resultRegister x86::vector128For: codegen) src: (instruction firstOperandRegister x86::vector128For: codegen)
    }.

MIR::Operation::MoveVector256
    forTargets: #(x86 x86_64) registerConstraintsWith: {:(MIRInstruction)instruction :(MIRRegisterAllocator)allocator :: Void |
        allocator
            allocateRegisterPairForInstruction: instruction operandAt: 0sz;
            allocateRegisterPairForInstructionResult: instruction trySharingWithOperandAt: 0sz
    };
    forTargets: #(x86 x86_64) generateWith: {:(MIRInstruction)instruction :(MIRFunctionAsmCodeGenerator)codegen :: Void |
        codegen textSection
            x86::movaps: (instruction resultRegister firstComponent x86::vector128For: codegen) src: (instruction firstOperandRegister firstComponent x86::vector128For: codegen);
            x86::movaps: (instruction resultRegister secondComponent x86::vector128For: codegen) src: (instruction firstOperandRegister secondComponent x86::vector128For: codegen)
    }.

MIR::Operation::PhiVector32
    forTargets: #(x86 x86_64) registerConstraintsWith: x86::vectorPhiRegisterConstraints;
    forTargets: #(x86 x86_64) generateWith: {:(MIRInstruction)instruction :(MIRFunctionAsmCodeGenerator)codegen :: Void |}.

MIR::Operation::PhiVector64
    forTargets: #(x86 x86_64) registerConstraintsWith: x86::vectorPhiRegisterConstraints;
    forTargets: #(x86 x86_64) generateWith: {:(MIRInstruction)instruction :(MIRFunctionAsmCodeGenerator)codegen :: Void |}.

MIR::Operation::PhiVector128
    forTargets: #(x86 x86_64) registerConstraintsWith: x86::vectorPhiRegisterConstraints;
