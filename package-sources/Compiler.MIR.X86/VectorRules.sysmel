    }.

MIR::Operation::StoreVector256
    forTargets: #(x86 x86_64) registerConstraintsWith: {:(MIRInstruction)instruction :(MIRRegisterAllocator)allocator :: Void |
        allocator
            allocateRegisterOrImmediate32ForInstruction: instruction operandAt: 1sz;
            allocateImmediate32ForInstruction: instruction operandAt: 2sz;
            allocateRegisterPairForInstruction: instruction operandAt: 0sz
    };
    forTargets: #(x86 x86_64) generateWith: {:(MIRInstruction)instruction :(MIRFunctionAsmCodeGenerator)codegen :: Void |
        instruction firstOperand isFloatingPoint ifTrue: {
            codegen textSection
                x86::movaps: (instruction secondOperandRegister x86::vector128PointerWithOffset: instruction thirdOperandRegister for: codegen) src: (instruction firstOperandRegister firstComponent x86::vector128For: codegen);
                x86::movaps: (instruction secondOperandRegister x86::vector128PointerWithOffset: instruction thirdOperandRegister offset: 16i32 for: codegen) src: (instruction firstOperandRegister secondComponent x86::vector128For: codegen)
        } ifFalse: {
            codegen textSection
                x86::movdqa: (instruction secondOperandRegister x86::vector128PointerWithOffset: instruction thirdOperandRegister for: codegen) src: (instruction firstOperandRegister firstComponent x86::vector128For: codegen);
                x86::movdqa: (instruction secondOperandRegister x86::vector128PointerWithOffset: instruction thirdOperandRegister offset: 16i32 for: codegen) src: (instruction firstOperandRegister secondComponent x86::vector128For: codegen)
        }
    }.

