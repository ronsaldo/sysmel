MIR::Operation::LoadVector256
    forTargets: #(x86 x86_64) registerConstraintsWith: {:(MIRInstruction)instruction :(MIRRegisterAllocator)allocator :: Void |
        allocator
            allocateRegisterOrImmediate32PointerForInstruction: instruction operandAt: 0sz;
            allocateImmediate32ForInstruction: instruction operandAt: 1sz;
            allocateRegisterPairForInstructionResult: instruction
    };
    forTargets: #(x86 x86_64) generateWith: {:(MIRInstruction)instruction :(MIRFunctionAsmCodeGenerator)codegen :: Void |
        instruction isFloatingPoint ifTrue: {
            codegen textSection
                x86::movaps: (instruction resultRegister firstComponent x86::vector128For: codegen) src: (instruction firstOperandRegister x86::vector128PointerWithOffset: instruction secondOperandRegister for: codegen);
                x86::movaps: (instruction resultRegister secondComponent x86::vector128For: codegen) src: (instruction firstOperandRegister x86::vector128PointerWithOffset: instruction secondOperandRegister offset: 16i32 for: codegen)
        } ifFalse: {
            codegen textSection
                x86::movdqa: (instruction resultRegister firstComponent x86::vector128For: codegen) src: (instruction firstOperandRegister x86::vector128PointerWithOffset: instruction secondOperandRegister for: codegen);
                x86::movdqa: (instruction resultRegister secondComponent x86::vector128For: codegen) src: (instruction firstOperandRegister x86::vector128PointerWithOffset: instruction secondOperandRegister offset: 16i32 for: codegen)
        }.
    }.

