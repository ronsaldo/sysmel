MIRPhysicalLocationRegisterPair extend: {
    public override method x86::loadFromRegister: (other: MIRPhysicalLocation) forValue: (value: MIRValue) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        let otherPairFirst := other firstComponent.
        let otherPairSecond := other secondComponent.
        (firstComponent == otherPairSecond) && (otherPairSecond == otherPairFirst) ifTrue: {
            firstComponent x86::exchangeWithRegister: secondComponent forValue: value with: codegen
        } ifFalse: {
            firstComponent x86::loadFromRegister: otherPairFirst forValue: value with: codegen.
            secondComponent x86::loadFromRegister: otherPairSecond forValue: value with: codegen
        }.
    }.

    public override method x86_64::loadFromRegister: (other: MIRPhysicalLocation) forValue: (value: MIRValue) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        let otherPairFirst := other firstComponent.
        let otherPairSecond := other secondComponent.
        (firstComponent == otherPairSecond) && (otherPairSecond == otherPairFirst) ifTrue: {
            firstComponent x86_64::exchangeWithRegister: secondComponent forValue: value with: codegen
        } ifFalse: {
            firstComponent x86_64::loadFromRegister: otherPairFirst forValue: value with: codegen.
            secondComponent x86_64::loadFromRegister: otherPairSecond forValue: value with: codegen
        }.
    }.

    public override method x86_64::loadFromValue: (value: MIRValue) pointer: (valuePointer: AsmX86RegisterAddress) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        firstComponent isVectorRegister ifFalse: {
            value size = 16u64 ifTrue: {
                codegen textSection
                    x86::mov: (firstComponent x86::int64For: codegen) src: valuePointer qword;
                    x86::mov: (secondComponent x86::int64For: codegen) src: valuePointer qword + 8i32 asAsmImmediate.
                return: void
            }.
        } ifTrue: {
            value size = 24u64 ifTrue: {
                value isFloatingPoint ifTrue: {
                    codegen textSection
                        x86::movaps: (firstComponent x86::vector128For: codegen) src: valuePointer qword;
                        x86::movsd: (secondComponent x86::vector128For: codegen) src: valuePointer qword + 16i32 asAsmImmediate.
                } ifFalse: {
                    codegen textSection
                        x86::movdqa: (firstComponent x86::vector128For: codegen) src: valuePointer qword;
                        x86::movq: (secondComponent x86::vector128For: codegen) src: valuePointer qword + 16i32 asAsmImmediate
                }.
                return: void
            }.

            value size = 32u64 ifTrue: {
                value isFloatingPoint ifTrue: {
                    codegen textSection
                        x86::movaps: (firstComponent x86::vector128For: codegen) src: valuePointer qword;
                        x86::movaps: (secondComponent x86::vector128For: codegen) src: valuePointer qword + 16i32 asAsmImmediate.
                } ifFalse: {
                    codegen textSection
                        x86::movdqa: (firstComponent x86::vector128For: codegen) src: valuePointer qword;
                        x86::movdqa: (secondComponent x86::vector128For: codegen) src: valuePointer qword + 16i32 asAsmImmediate
                }.
                return: void
            }.
        }.

        error(value fullPrintString -- " " -- value type printString -- ": " -- value size printString -- " unsupported register pair " -- firstComponent printString -- " " -- secondComponent printString)
    }.

    public override method x86_64::storeValue: (value: MIRValue) inPointer: (valuePointer: AsmX86RegisterAddress) isCallArgument: (isCallArgument: Boolean) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        firstComponent isVectorRegister ifFalse: {
            value size = 16u64 ifTrue: {
                codegen textSection
                    x86::mov: valuePointer qword src: (firstComponent x86::int64For: codegen);
                    x86::mov: valuePointer qword + 8i32 asAsmImmediate src: (secondComponent x86::int64For: codegen).
                return: void
            }.
        } ifTrue: {
            value size = 24u64 ifTrue: {
                value isFloatingPoint ifTrue: {
                    codegen textSection
                        x86::movaps: valuePointer qword src: (firstComponent x86::vector128For: codegen);
                        x86::movsd: valuePointer qword + 16i32 asAsmImmediate src: (secondComponent x86::vector128For: codegen).
                } ifFalse: {
                    codegen textSection
                        x86::movdqa: valuePointer qword src: (firstComponent x86::vector128For: codegen);
                        x86::movq: valuePointer qword + 16i32 asAsmImmediate src: (secondComponent x86::vector128For: codegen)
                }.
                return: void
            }.

            value size = 32u64 ifTrue: {
                value isFloatingPoint ifTrue: {
                    codegen textSection
                        x86::movaps: valuePointer qword src: (firstComponent x86::vector128For: codegen);
                        x86::movaps: valuePointer qword + 16i32 asAsmImmediate src: (secondComponent x86::vector128For: codegen).
                } ifFalse: {
                    codegen textSection
                        x86::movdqa: valuePointer qword src: (firstComponent x86::vector128For: codegen);
                        x86::movdqa: valuePointer qword + 16i32 asAsmImmediate src: (secondComponent x86::vector128For: codegen)
                }.
                return: void
            }.
        }.

        error("Unsupported register pair.")
    }.
}.

