    public override method asm::canonicalRegister ::=> AsmRegister := register.

    public override method x86_64::exchangeWithRegister: (register: MIRPhysicalLocation) forValue: (value: MIRValue) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        self assert: register isVectorRegister.

        self ~~ register ifTrue: {
            let first := self register.
            let second := register x86::vector128For: codegen.
            value isFloatingPoint ifTrue: {
                codegen textSection
                    x86::xorps: first with: second;
                    x86::xorps: second with: first;
                    x86::xorps: first with: second
            } ifFalse: {
                codegen textSection
                    x86::pxor: first with: second;
                    x86::pxor: second with: first;
                    x86::pxor: first with: second
            }
        }.
    }.
    
    public override method x86_64::loadFromRegister: (register: MIRPhysicalLocation) forValue: (value: MIRValue) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        self assert: register isVectorRegister.

        self ~~ register ifTrue: {
            value isFloatingPoint ifTrue: {
                codegen textSection x86::movaps: self register src: (register x86::vector128For: codegen)
            } ifFalse: {
                codegen textSection x86::movdqa: self register src: (register x86::vector128For: codegen)
            }.
        }.
    }.

