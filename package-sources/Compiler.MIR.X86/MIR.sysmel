MIRVectorConstant extend: {
    public override method x86_64::moveIntoRegister: (register: MIRPhysicalLocation) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        let constantSize := self size asUInt32.

        ## Avoid loadin from memory the zero constant.
        if: value isZeros then: {
            type isPrimitiveFloatOrFloatVectorType ifTrue: {
                constantSize <= 16u32 ifTrue: {
                    codegen textSection x86::xorps: (register x86::vector128For: codegen) with: (register x86::vector128For: codegen).
                    return: void
                }.
                constantSize <= 32u32 ifTrue: {
                    codegen textSection
                        x86::xorps: (register firstComponent x86::vector128For: codegen) with: (register firstComponent x86::vector128For: codegen);
                        x86::xorps: (register secondComponent x86::vector128For: codegen) with: (register secondComponent x86::vector128For: codegen).
                    return: void
                }.
            } ifFalse: {
                constantSize <= 16u32 ifTrue: {
                    codegen textSection x86::pxor: (register x86::vector128For: codegen) with: (register x86::vector128For: codegen).
                    return: void
                }.
                constantSize <= 32u32 ifTrue: {
                    codegen textSection
                        x86::pxor: (register firstComponent x86::vector128For: codegen) with: (register firstComponent x86::vector128For: codegen);
                        x86::pxor: (register secondComponent x86::vector128For: codegen) with: (register secondComponent x86::vector128For: codegen).
                    return: void
                }.
            }.
        }.

        let constantSymbol := codegen symbolForVectorConstant: value.

        type isPrimitiveFloatOrFloatVectorType ifTrue: {
            switch: constantSize withCases: #{
                4u32 : (codegen textSection x86::movss: (register x86::vector128For: codegen) src: constantSymbol x86::dwordPtr).
                8u32 : (codegen textSection x86::movsd: (register x86::vector128For: codegen) src: constantSymbol x86::qwordPtr).
                12u32 : (codegen textSection x86::movaps: (register x86::vector128For: codegen) src: constantSymbol x86::owordPtr).
                16u32 : (codegen textSection x86::movaps: (register x86::vector128For: codegen) src: constantSymbol x86::owordPtr).
                24u32 : (codegen textSection
                    x86::movaps: (register firstComponent x86::vector128For: codegen) src: constantSymbol x86::owordPtr;
                    x86::movsd: (register secondComponent x86::vector128For: codegen) src: constantSymbol x86::qwordPtr + 16i32 asAsmImmediate
                ).
                32u32 : (codegen textSection
                    x86::movaps: (register firstComponent x86::vector128For: codegen) src: constantSymbol x86::owordPtr;
                    x86::movaps: (register secondComponent x86::vector128For: codegen) src: constantSymbol x86::owordPtr + 16i32 asAsmImmediate
                ).
                _: {self error: "Unsupported register size"}
            }
        } ifFalse: {
            switch: constantSize withCases: #{
                4u32 : (codegen textSection x86::movd: (register x86::vector128For: codegen) src: constantSymbol x86::dwordPtr).
                8u32 : (codegen textSection x86::movq: (register x86::vector128For: codegen) src: constantSymbol x86::qwordPtr).
                12u32 : (codegen textSection x86::movdqa: (register x86::vector128For: codegen) src: constantSymbol x86::owordPtr).
                16u32 : (codegen textSection x86::movdqa: (register x86::vector128For: codegen) src: constantSymbol x86::owordPtr).
                24u32 : (codegen textSection
                    x86::movdqa: (register firstComponent x86::vector128For: codegen) src: constantSymbol x86::owordPtr;
                    x86::movq: (register secondComponent x86::vector128For: codegen) src: constantSymbol x86::qwordPtr + 16i32 asAsmImmediate
                ).
                32u32 : (codegen textSection
                    x86::movdqa: (register firstComponent x86::vector128For: codegen) src: constantSymbol x86::owordPtr;
                    x86::movdqa: (register secondComponent x86::vector128For: codegen) src: constantSymbol x86::owordPtr + 16i32 asAsmImmediate
                ).
                _: {self error: "Unsupported register size"}
            }
        }.
    }.

#*
    public override method x86_64::moveIntoSpecificMemoryLocation: (memoryLocation: MIRSpecificPhysicalMemoryLocation) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        codegen textSection x86::mov: (memoryLocation x86::pointerWithCodegen: codegen) qword src: value asIEEEFloat64Encoding asAsmImmediate
    }.

    public override method x86_64::pushWith: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        codegen textSection x86::push: (codegen symbolForFloat64Constant: value) x86::qwordPtr
    }.
*#
}.

