
MIR::Operation::GenerationalWriteBarrier
    forTargets: #(x86 x86_64) registerConstraintsWith: {:(MIRInstruction)instruction :(MIRRegisterAllocator)allocator :: Void |
        allocator
            allocateRegister: MIR::X86_64::RAX forInstruction: instruction operandAt: 0sz;
            allocateImmediate32ForInstruction: instruction operandAt: 1sz;
            allocateRegister: MIR::X86_64::RDX forInstruction: instruction operandAt: 2sz;
            allocateRegisterOrRelativeImmediate32ForInstruction: instruction operandAt: 3sz
    };
    forTarget: #x86_64 generateWith: {:(MIRInstruction)instruction :(MIRFunctionAsmCodeGenerator)codegen :: Void |
        let objectRegister := instruction firstOperandRegister x86::int64For: codegen.
        let objectFlagPointer := instruction firstOperandRegister x86::int32PointerWithOffset: instruction secondOperandRegister for: codegen.
        let valueRegister := instruction thirdOperandRegister x86::int64For: codegen.
        let valueFlagRegister := instruction thirdOperandRegister x86::int32PointerWithOffset: instruction secondOperandRegister for: codegen.
        let writeBarrierEnd := codegen textSection newPrivateSymbolNamed: #writeBarrierEnd.
        let writeBarrierEndDestination := writeBarrierEnd byte.

        codegen textSection
            ## Not nil object
            x86::test: objectRegister with: objectRegister;
            x86::jz: writeBarrierEndDestination;

            ## Old and not remembered object
            x86::test: objectFlagPointer with: (ObjectModel::Flags::Dirty | ObjectModel::Flags::Young) asAsmImmediate;
            x86::jnz: writeBarrierEndDestination;

            ## Not nil pointer value
            x86::test: valueRegister with: valueRegister;
            x86::jz: writeBarrierEndDestination;
            x86::test: valueRegister with: ObjectModel::Tag::Mask asInt8 asAsmImmediate;
            x86::jnz: writeBarrierEndDestination;

            ## Young value
            x86::test: valueFlagRegister with: ObjectModel::Flags::Young asAsmImmediate;
            x86::jz: writeBarrierEndDestination;

            ## Mark the dirty object.
            x86::lock; x86::or: objectFlagPointer with: ObjectModel::Flags::Dirty asAsmImmediate;

            x86::call: (instruction fourthOperandRegister x86::relCall32OrInt32For: codegen);

            label: writeBarrierEnd
    }.
