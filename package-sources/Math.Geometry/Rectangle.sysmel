## FIXME: Use a struct and a template here
public final class RectangleF32 definition: {
    public field min => Float32x2.
    public field max => Float32x2.

    __Meta__ definition: {
        public pure inline method min: (min: Float32x2) max: (max: Float32x2) ::=> RectangleF32
            := RectangleF32 basicNew
                min: min;
                max: max;
                yourself.

        public pure inline method origin: (origin: Float32x2) extent: (extent: Float32x2) ::=> RectangleF32
            := RectangleF32 basicNew
                min: origin;
                max: origin + extent;
                yourself.

    }.

    public pure inline method origin => Float32x2 := min.
    public pure inline method corner => Float32x2 := max.
    public pure inline method extent => Float32x2 := max - min.

    public pure inline method includesPoint: (point: Float32x2) ::=> Boolean
        := (min x <= point x) && (point x <= max x) &&
           (min y <= point y) && (point y <= max y).

    public pure inline method includesPointExclusively: (point: Float32x2) ::=> Boolean
        := (min x <= point x) && (point x < max x) &&
           (min y <= point y) && (point y < max y).

    public pure inline method intersectionWith: (other: RectangleF32) ::=> RectangleF32
        := RectangleF32 min: (min max: other min) max: (max min: other max).

    public pure inline method isExclusiveEmpty => Boolean
        := (min x >= max x) || (min y >= max y).

    public pure inline method isEmpty => Boolean
        := (min x > max x) || (min y > max y).

    public override method printOn: (stream: Stream) ::=> Void := {
        stream print: SelfType; string: " min: "; print: min; string: " max: "; print: max
    }.
}.

Float32x2 extend: {
    public pure inline method extent: (extent: SelfType) ::=> RectangleF32
        := RectangleF32 origin: self extent: extent.
}.

public final class RectangleI32 definition: {
    public field min => Int32x2.
    public field max => Int32x2.

    __Meta__ definition: {
        public pure inline method min: (min: Int32x2) max: (max: Int32x2) ::=> RectangleI32
            := RectangleI32 basicNew
                min: min;
                max: max;
                yourself.

        public pure inline method origin: (origin: Int32x2) extent: (extent: Int32x2) ::=> RectangleI32
            := RectangleI32 basicNew
                min: origin;
                max: origin + extent;
                yourself.

    }.

    public pure inline method origin => Int32x2 := min.
    public pure inline method corner => Int32x2 := max.
    public pure inline method extent => Int32x2 := max - min.

    public pure inline method intersectionWith: (other: RectangleI32) ::=> RectangleI32
        := RectangleI32 min: (min max: other min) max: (max min: other max).

    public pure inline method isExclusiveEmpty => Boolean
        := (min x > max x) || (min y > max y).

    public pure inline method isEmpty => Boolean
        := (min x > max x) || (min y > max y).

    public override method printOn: (stream: Stream) ::=> Void := {
        stream print: SelfType; string: " min: "; print: min; string: " max: "; print: max
    }.
}.

Int32x2 extend: {
    public pure inline method extent: (extent: SelfType) ::=> RectangleI32
        := RectangleI32 origin: self extent: extent.
}.
