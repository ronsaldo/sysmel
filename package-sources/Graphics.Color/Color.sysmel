## FIXME: Use a struct here instead of a class.
public final class Color definition: {
    public field bgra => UInt32.

    __Meta__ definition: {
        public pure inline method fromLinearBGRA_F32: (linear: Float32x4) ::=> Color
            := Color basicNew
                bgra: linear packUnorm4x8;
                yourself.

        public pure inline method fromSBGR_A_F32: (srgb_a: Float32x4) ::=> Color
            := Color basicNew
                bgra: srgb_a packUnorm4x8;
                yourself.

        public pure inline method r: (r: Float32) g: (g: Float32) b: (b: Float32) a: (a: Float32) ::=> Color
            := Color basicNew
                bgra: (Float32x4 x: b y: g z: r w: a) packUnorm4x8;
                yourself.

        public pure inline method r: (r: Float32) g: (g: Float32) b: (b: Float32) ::=> Color
            := Color basicNew
                bgra: (Float32x4 x: b y: g z: r w: 1.0f32) packUnorm4x8;
                yourself.

        public pure inline method transparent => Color
            := Color basicNew.

        public pure inline method black => Color
            := Color r: 0f32 g: 0f32 b: 0f32.

        public pure inline method gray: (brightness: Float32) ::=> Color
            := Color r: brightness g: brightness b: brightness.

        public pure inline method gray => Color
            := Color r: 0.5f32 g: 0.5f32 b: 0.5f32.

        public pure inline method white => Color
            := Color r: 1f32 g: 1f32 b: 1f32.

        public pure inline method red => Color
            := Color r: 1f32 g: 0f32 b: 0f32.

        public pure inline method green => Color
            := Color r: 0f32 g: 1f32 b: 0f32.

        public pure inline method blue => Color
            := Color r: 0f32 g: 0f32 b: 1f32.
    }.

    public method asLinearFloat32x4 => Float32x4
        := bgra unpackUnorm4x8.

    public method asLinearFloat32x4Fast => Float32x4 := {
        let unpacked := bgra unpackUnorm4x8.
        unpacked
    }.

    public inline method blueChannel8 => UInt8
        := bgra asUInt8.

    public inline method blue => Float32
        := self blueChannel8 asFloat32 / 255.0f32.

    public inline method greenChannel8 => UInt8
        := (bgra >> 8u32) asUInt8.

    public inline method green => Float32
        := self greenChannel8 asFloat32 / 255.0f32.

    public inline method redChannel8 => UInt8
        := (bgra >> 16u32) asUInt8.

    public inline method red => Float32
        := self redChannel8 asFloat32 / 255.0f32.

    public inline method alphaChannel8 => UInt8
        := (bgra >> 24u32) asUInt8.

    public inline method alpha => Float32
        := self alphaChannel8 asFloat32 / 255.0f32.
}.
