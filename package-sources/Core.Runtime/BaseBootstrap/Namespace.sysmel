ProgramEntity definition: {
    public virtual method getOrCreateNamespaceNamed: (name: Symbol) ::=> Namespace
        := self error: "Cannot create children namespaces in program entity " -- self printString.
}.

Namespace definition: {
    public override method getOrCreateNamespaceNamed: (name: Symbol) ::=> Namespace := {
        self error: "TODO: getOrCreateNamespaceNamed: " -- name printString
    }.
}.

public class NamespaceMetaBuilder superclass: MacroMetaBuilder; definition: {
    public field nameComponents => OrderedCollection.
    public field definitionExpression => ASTNode.

    public override method initialize => Void := {
        super initialize.
        nameComponents := OrderedCollection new.
    }.

    public override method expandMessageSendNode: (messageSendNode: ASTMessageSendNode) ::=> ASTNode := {
        messageSendNode arguments isEmpty && messageSendNode selector isLiteralNode ifTrue: {
            nameComponents add: messageSendNode selector.
            self continueExpansion
        } ifFalse: {
            self expandMessageSendNodeWithMetaBuilderMethod: messageSendNode
        }
    }.

    public override method finishExpansionWithEnvironment: (environment: Environment) ::=> ASTNode := {
        let namespaceObjectNode mutable => ASTNode := nil.

        nameComponents isEmpty ifTrue: {
            namespaceObjectNode := ASTErrorNode new
                sourcePosition: sourcePosition;
                errorMessage: "A namespace name is required.";
                yourself
        } ifFalse: {
            namespaceObjectNode := ASTIdentifierReferenceNode new
                sourcePosition: sourcePosition;
                value: #__OwnerProgramEntity__;
                yourself.

            let getOrCreateNamespaceNamedSelector := ASTLiteralNode new
                sourcePosition: sourcePosition;
                value: #getOrCreateNamespaceNamed:;
                yourself.

            nameComponents do: {:(ASTNode)eachNameComponent :: Void |
                namespaceObjectNode := ASTMessageSendNode new
                    sourcePosition: sourcePosition;
                    receiver: namespaceObjectNode;
                    selector: getOrCreateNamespaceNamedSelector;
                    arguments: (Array with: eachNameComponent);
                    yourself.
            }.
        }.

        namespaceObjectNode
    }.
}.

#*
public global namespace := MetaBuilderFactory for: NamespaceMetaBuilder.

namespace TestNamespace definition: {

}.
*#