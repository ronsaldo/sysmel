FunctionMetaBuilder publicSubclass: #TemplateMetaBuilder slots: (
    TypeSlot publicNamed: #supertypeExpression type: ASTNode ,
    TypeSlot publicNamed: #typeMetaBuilderClass type: TypeMetaBuilder class,
).

TemplateMetaBuilder definition: {
    public override method initialize => Void := {
        super initialize.
        self functionFlags: FunctionFlags::Memoized | FunctionFlags::Template
    }.

    public override method expandMessageSendNode: (messageSendNode: ASTMessageSendNode) ::=> ASTNode := {
        let: #selector with: messageSendNode selector.
        if: (selector isLiteralNode && (selector downCastTo: ASTLiteralNode) value) == #class then: {
            self typeMetaBuilderClass: ClassMetaBuilder.
            return: self continueExpansion
        }.

        super expandMessageSendNode: messageSendNode
    }.

    public override method expansionBody => ASTNode := {
        typeMetaBuilderClass ifNil: {return: super expansionBody}.

        let typeContructionNode := typeMetaBuilderClass new
            environment: environment;
            sourcePosition: sourcePosition;
            supertypeExpression: self supertypeExpression;
            finishExpansion.

        body ifNotNil: {
            let argumentNames := ASTMakeArrayNode new
                sourcePosition: sourcePosition;
                elements: (self arguments collect: {:(ASTArgumentNode)each :: ASTNode |
                    each name ifNil: (ASTLiteralNode new
                        sourcePosition: sourcePosition;
                        yourself)
                });
                yourself.

            let argumentValues := ASTMakeArrayNode new
                sourcePosition: sourcePosition;
                elements: (self arguments collect: {:(ASTArgumentNode)each :: ASTNode |
                    each name isNotNil && each name isLiteralNode ifTrue: {
                        (each name downCastTo: ASTLiteralNode) asIdentifierReferenceNode
                    } ifFalse: {
                        ASTLiteralNode new
                            sourcePosition: sourcePosition;
                            yourself
                    }
                });
                yourself.

            ``{
                let resultType := `,typeContructionNode.
                __templateResult__ value: resultType.
                
                resultType
                    pendingDefinitionBody: `,body
                        withParameterNames: `,argumentNames values: `,argumentValues;
                    yourself
            }
        } ifNil: {
            typeContructionNode
        }
    }.

    public override method finishFunctionExpansion => ASTNode := {
        let: #templateResultArgument with: (ASTArgumentNode new
            sourcePosition: self sourcePosition;
            isForAll: false;
            name: `'#__templateResult__;
            type: `'WeakValueAssociation;
            yourself).

        ASTLambdaNode new
            sourcePosition: self sourcePosition;
            flags: self functionFlags;
            name: self name;
            arguments: (Array with: templateResultArgument) -- self arguments;
            body: self expansionBody;
            resultType: self resultType;
            makeEagerIf: self isEager;
            yourself
    }.

    public method definition: (bodyExpression: ASTNode) ::=> ASTNode := {
        <metaBuilder>
        self body: bodyExpression.
        self finishExpansion
    }.
}.

FlagMetaBuilder definition: {
    public method template => ASTNode := {
        <metaBuilder>
        self delegateToMetaBuilder: (TemplateMetaBuilder new
            addFunctionFlags: self methodFlags;
            isPublic: self isPublic;
            isEager: self isEager;
            yourself)
    }.
}.
