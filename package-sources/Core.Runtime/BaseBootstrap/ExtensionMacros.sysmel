    withSelector: #addEagerExtension:withEnvironment: addMethod: {:(ProgramEntity)self :(ASTNode)body :(Environment)definitionEnvironment :: Void |
        self evaluateExtension: body withEnvironment: definitionEnvironment
    } makeVirtual;
    withSelector: #evaluateDefinition:withEnvironment: addMethod: {:(ProgramEntity)self :(ASTNode)body :(Environment)definitionEnvironment :: Void |
        body analyzeAndEvaluateWithEnvironment: definitionEnvironment
    } makeVirtual;
    withSelector: #evaluateExtension:withEnvironment: addMethod: {:(ProgramEntity)self :(ASTNode)body :(Environment)definitionEnvironment :: Void |
        body analyzeAndEvaluateWithEnvironment: definitionEnvironment
    } makeVirtual;

    withSelector: #pendingDefinitionBody: addMacroMethod: {:(MacroContext)macroContext :(ASTNode)self :(ASTNode)bodyBlock :: ASTNode |
        macroContext send: (macroContext literal: #addPendingDefinitionBody:withEnvironment:)
            to: self
            with: (ASTLiteralNode new
                sourcePosition: bodyBlock sourcePosition;
                value: bodyBlock;
                yourself)
            with: (macroContext literal: macroContext environment)
    } makeMacro;
    withSelector: #pendingDefinitionBody:withParameterNames:values: addMacroMethod: {:(MacroContext)macroContext :(ASTNode)self :(ASTNode)bodyBlock :(ASTNode)parameterNames :(ASTNode)parameterValues :: ASTNode |
        macroContext send: (macroContext literal: #addPendingDefinitionBody:withEnvironment:parameterNames:values:)
            to: self
            with: (ASTLiteralNode new
                sourcePosition: bodyBlock sourcePosition;
                value: bodyBlock;
                yourself)
            with: (macroContext literal: macroContext environment)
            with: parameterNames with: parameterValues
    } makeMacro;
