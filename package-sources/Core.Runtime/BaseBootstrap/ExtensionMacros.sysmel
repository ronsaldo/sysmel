    withSelector: #evaluateDefinition:withEnvironment: addMethod: {:(Type)self :(ASTNode)body :(Environment)environment :: Void |
        ``{
            let: #SelfType with: `,(self asMacroLiteral).
            let: #ReceiverType with: SelfType asReceiverType.
            let: #SuperType with: SelfType supertype.
            let: #__Meta__ with: SelfType __type__.
            let: #__OwnerProgramEntity__ with: SelfType.
            macroLet: #super with: (tuple: self withLookupStartingFrom: SuperType).
            `,body
        } analyzeAndEvaluateWithEnvironment: environment
    } makeVirtual;
    withSelector: #evaluateExtension:withEnvironment: addMethod: {:(ProgramEntity)self :(ASTNode)body :(Environment)environment :: Void |
        self evaluateDefinition: body withEnvironment: environment
    } makeVirtual.

