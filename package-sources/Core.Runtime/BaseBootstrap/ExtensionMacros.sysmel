ProgramEntity
    withSelector: #addPendingDefinitionBody:withEnvironment: addMethod: {:(ProgramEntity)self :(ASTNode)body :(Environment)definitionEnvironment :: Void |
        self evaluateDefinition: body withEnvironment: definitionEnvironment
    } makeVirtual;
    withSelector: #addPendingDefinitionBody:withEnvironment:parameterNames:values: addMethod: {:(ProgramEntity)self :(ASTNode)body :(Environment)definitionEnvironment :(Array)parameterNames :(Array)parameterValues :: Void |
        let: #importedEnvironmentNodes with: OrderedCollection new.
        parameterNames doWithIndex: {:(Symbol)parameterName :(Size)parameterIndex :: Void |
            parameterName ifNotNil: {
                importedEnvironmentNodes add: (ASTVariableDefinitionNode new
                    sourcePosition: body sourcePosition;
                    nameExpression: (ASTLiteralNode new
                        sourcePosition: body sourcePosition;
                        value: parameterName;
                        yourself);
                    valueExpression: (ASTLiteralNode new
                        sourcePosition: body sourcePosition;
                        value: (parameterValues at: parameterIndex);
                        yourself);
                    yourself)
            }
        }.

        let bodyWithParameters := ASTSequenceNode new
            sourcePosition: body sourcePosition;
            expressions: importedEnvironmentNodes asArray -- (Array with: body);
            yourself.

        self evaluateDefinition: bodyWithParameters withEnvironment: definitionEnvironment
    } makeVirtual;
    withSelector: #addEagerDefinitionBody:withEnvironment: addMethod: {:(ProgramEntity)self :(ASTNode)body :(Environment)definitionEnvironment :: Void |
        self evaluateDefinition: body withEnvironment: definitionEnvironment
    } makeVirtual;
    withSelector: #addPendingExtension:withEnvironment: addMethod: {:(ProgramEntity)self :(ASTNode)body :(Environment)definitionEnvironment :: Void |
