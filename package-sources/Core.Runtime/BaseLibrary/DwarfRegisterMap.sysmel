public final class DwarfRegisterMap definition: {
    public field framePointerRegister => UInt32.
    public field returnAddressRegister => UInt32.
    public field stackPointerRegister => UInt32.

    public field nativeCodeDebugRegisterToDwarfTable => Array.
    public field returnPointerIsPassedViaStack => Boolean.

    public method buildRegisterTables: (table: Array) ::=> Void := {
        nativeCodeDebugRegisterToDwarfTable := Array new: 256sz.
        table do: {:(Array)registerDescriptor :: Void |
            let name := registerDescriptor first.
            let nativeCodeDebugRegister => Integer := registerDescriptor second.
            let dwarfRegisterValue => Integer := registerDescriptor third.
            nativeCodeDebugRegisterToDwarfTable at: nativeCodeDebugRegister sz put: dwarfRegisterValue asUInt32
        }
    }.

    public method nativeCodeDebugRegisterToDwarf: (nativeCodeDebugRegister: Int32) ::=> UInt32
        := nativeCodeDebugRegisterToDwarfTable at: nativeCodeDebugRegister asSize
}.

public global Dwarf::X86::RegisterMap := DwarfRegisterMap new
    returnAddressRegister: 8u32;
    returnPointerIsPassedViaStack: true;
    yourself.

