Boolean eagerDefinitionBody: {
    public final pure eager method not => Boolean := {
        <primitive: #Boolean::not>
        <targetDefinedPrimitive>
        if: self then: false else: true
    }.

    public final pure eager method ^ (other: Boolean) ::=> Boolean := {
        <primitive: #Boolean::^ >
        <targetDefinedPrimitive>
        if: self == other then: false else: true
    }.

    public final pure eager method & (other: Boolean) ::=> Boolean := {
        <primitive: #Boolean::& >
        <targetDefinedPrimitive>
        if: self then: other else: false
    }.

    public final pure eager method | (other: Boolean) ::=> Boolean := {
        <primitive: #Boolean::| >
        <targetDefinedPrimitive>
        if: self then: false else: other
    }.

    public final pure eager method asInt8 => Int8 := {
        <primitive: #Boolean::asInt8>
        <targetDefinedPrimitive>
        if: self then: 1i8 else: 0i8
    }.

    public final pure eager method asUInt8 => UInt8 := {
        <primitive: #Boolean::asUInt8>
        <targetDefinedPrimitive>
        if: self then: 1u8 else: 0u8
    }.
}.

Boolean16 eagerDefinitionBody: {
    __Meta__ definition: {
        public final method zero => Boolean16
            := 0i16 asBoolean16.
    }.

    public override method hash => Size
        := self asInt16 hash.

    public final pure eager override method = (other: Boolean16) => Boolean := {
        <primitive: #Boolean16::= >
        <targetDefinedPrimitive>
        self asInt16 = other asInt16
    }.

    public final pure eager override method ~= (other: Boolean16) => Boolean := {
        <primitive: #Boolean16::~= >
        <targetDefinedPrimitive>
        self asInt16 ~= other asInt16
    }.

    public final pure eager method not => Boolean16 := {
        <primitive: #Boolean16::not>
        <targetDefinedPrimitive>
        primitiveFailedError()
    }.

    public final pure eager method ^ (other: Boolean16) ::=> Boolean16 := {
        <primitive: #Boolean16::^ >
        <targetDefinedPrimitive>
        primitiveFailedError()
    }.

    public final pure eager method & (other: Boolean16) ::=> Boolean16 := {
        <primitive: #Boolean16::& >
        <targetDefinedPrimitive>
        primitiveFailedError()
    }.

    public final pure eager method | (other: Boolean16) ::=> Boolean16 := {
        <primitive: #Boolean16::| >
        <targetDefinedPrimitive>
        primitiveFailedError()
    }.

    public final pure eager method asInt16 => Int16 := {
        <primitive: #Boolean16::asInt16>
        <targetDefinedPrimitive>
        primitiveFailedError()
    }.

    public final pure eager method asUInt16 => UInt16 := {
        <primitive: #Boolean16::asUInt16>
        <targetDefinedPrimitive>
        primitiveFailedError()
    }.
}.

