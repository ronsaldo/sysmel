public final class NativeCodeSymbolTableBuilder superclass: Object; definition: {
    private field symbolList => OrderedCollection.
    private field symbolIndexTable => IdentityDictionary.
    private field sectionIndexTable => IdentityDictionary.

    public override method initialize => Void := {
        symbolList := OrderedCollection new.
        symbolIndexTable := IdentityDictionary new.
        sectionIndexTable := IdentityDictionary new.
    }.

    public method getOrCreateSymbolIndex: (symbol: NativeCodeSymbol) ::=> UInt32 := {
        symbolIndexTable at: symbol ifAbsentPut: {:: UInt32 |
            symbolList add: symbol.
            symbolList size asUInt32
        }
    }.

    public method getOrCreateSymbolForSection: (section: NativeCodeSection) ::=> UInt32 := {
        sectionIndexTable at: section ifAbsentPut: {:: UInt32 |
            let symbol := NativeCodeSymbol new
                section: section;
                type: NativeCodeSymbol::Type::Section;
                visibility: NativeCodeSymbol::Visibility::Private;
                yourself.
            symbolList add: symbol.
            symbolList size asUInt32
        }.
    }.

    public method finish => NativeCodeSymbolTable
        := NativeCodeSymbolTable new
            symbols: symbolList asArray;
            yourself
}.
