public class DwarfNativeCodeDebugInformationBuilder superclass: Object; definition: {
    public field version => UInt8.
    public field isForJIT => Boolean.
    public field pointerSize => Size.
    public field dwarfRegisterMap => DwarfRegisterMap.
    public field builder => NativeCodeBuilder.
    public field debugLineSection => NativeCodeSection.
    public field debugLineSectionOffset => Size.
    public field debugStringSection => NativeCodeSectionBuilder.
    public field lineInfoBuilder => DwarfLineInformationBuilder.

    __Meta__ definition: {
        public method buildForJitNativeCode: (jitNativeCode: NativeCode) ::=> NativeCode
            := self new buildForJitNativeCode: jitNativeCode
    }.

    public method buildForJitNativeCode: (jitNativeCode: NativeCode) ::=> NativeCode := {
        isForJIT := true.
        version := 5u8.
        pointerSize := UIntPointer valueSize.
        builder := NativeCodeBuilder new.
        dwarfRegisterMap := DwarfRegisterMap forCurrentPlatform.
        debugStringSection := builder debugStringSection.
        debugStringSection uint8: 0u8.

        self
            buildCallFrameInformationFor: jitNativeCode;
            buildLineInformationFor: jitNativeCode;
            buildDebugInformationFor: jitNativeCode.
        builder finish
    }.

    public method buildCallFrameInformationFor: (nativeCode: NativeCode) ::=> Void := {
        (nativeCode sections anySatisfy: {:(NativeCodeSection)eachSection :: Boolean | eachSection callFrameInformations isNotEmpty }) ifFalse: {
            return: void
        }.

        DwarfCallFrameInformationBuilder new
            pointerSize: pointerSize;
            codeAlignmentFactor: 1u32;
            dataAlignmentFactor: pointerSize asInt32 negated;
            returnAddressRegister: dwarfRegisterMap returnAddressRegister;
            returnPointerIsPassedViaStack: dwarfRegisterMap returnPointerIsPassedViaStack;
            dwarfRegisterMap: dwarfRegisterMap;
            isForJIT: isForJIT;
            setupForEhFrame;
            targetSection: builder ehFrameSection;
            buildFor: nativeCode
    }.

    public method buildLineInformationFor: (nativeCode: NativeCode) ::=> Void := {
        (nativeCode sections anySatisfy: {:(NativeCodeSection)eachSection :: Boolean | eachSection debugSourcePositions isNotNil}) ||
        (nativeCode programEntities anySatisfy: {:(NativeCodeProgramEntity)eachProgramEntity :: Boolean | eachProgramEntity debugSourcePosition isNotNil}) ifFalse: {
            return: void
        }.

        let debugLineSectionBuilder := builder debugLineSection.
        debugLineSection := debugLineSectionBuilder section.
        debugLineSectionOffset := debugLineSectionBuilder size.
        
        lineInfoBuilder := DwarfLineInformationBuilder new
            targetSection: debugLineSectionBuilder;
            version: version asUInt16;
            dwarfSize: 4sz;
            pointerSize: pointerSize;
            writeSourceLocationForSections: nativeCode sections programEntities: nativeCode programEntities;
            yourself
    }.

    public method buildDebugInformationForNativeCodeProgramEntity: (nativeCodeProgramEntity: NativeCodeProgramEntity) with: (builder: DwarfDebugInformationSectionBuilder) ::=> Void := {
        nativeCodeProgramEntity contentSymbol isNil ||
        nativeCodeProgramEntity contentSymbol section isNil || 
        (nativeCodeProgramEntity contentSymbol type ~= NativeCodeSymbol::Type::Function) ifTrue: {
            return: void
        }.

        let name := nativeCodeProgramEntity sourceProgramEntity qualifiedName.
        let nameWithSuffix := nativeCodeProgramEntity trampolineTarget ifNil: name ifNotNil: name -- " [Trampoline]".

        builder
            beginDIE: Dwarf::DW_TAG_subprogram hasChildren: false;
            attribute: Dwarf::DW_AT_name string: nameWithSuffix;
            attribute: Dwarf::DW_AT_low_pc section: nativeCodeProgramEntity contentSymbol section addressAtOffset: nativeCodeProgramEntity contentSymbol value asSize;
            attribute: Dwarf::DW_AT_high_pc section: nativeCodeProgramEntity contentSymbol section addressAtOffset: nativeCodeProgramEntity contentSymbol value asSize + nativeCodeProgramEntity contentSymbol size.

        let sourcePosition := nativeCodeProgramEntity debugSourcePosition.
        sourcePosition isNotNil && lineInfoBuilder isNotNil ifTrue: {
            builder
                attribute: Dwarf::DW_AT_decl_file uleb128: (lineInfoBuilder getSourceCodeIndex: sourcePosition sourceCode) asSize;
                attribute: Dwarf::DW_AT_decl_line uleb128: sourcePosition startLine asSize;
                attribute: Dwarf::DW_AT_decl_column uleb128: sourcePosition startColumn asSize
        }.

        builder endDIE
    }.

    public method buildDebugInformationFor: (nativeCode: NativeCode) ::=> Void := {
        let builder := DwarfDebugInformationSectionBuilder new
            abbrevSection: builder debugAbbrevSection;
            infoSection: builder debugInfoSection;
            stringSection: debugStringSection;
            dwarfSize: 4sz;
            pointerSize: pointerSize;
            version: version asUInt16;
            beginDebugInfo;
            yourself.
        
        let hasChildren := nativeCode programEntities isNotEmpty.
        builder
            beginDIE: Dwarf::DW_TAG_compile_unit hasChildren: hasChildren;
            attribute: Dwarf::DW_AT_producer string: "Sysmel JIT Loader".

        debugLineSection ifNotNil: {
            builder attribute: Dwarf::DW_AT_stmt_list section: debugLineSection relativeOffset: debugLineSectionOffset
        }.

        let textSection := nativeCode findSectionNamedOrNil: #".text".
        textSection ifNotNil: {
            builder
                attribute: Dwarf::DW_AT_low_pc section: textSection addressAtOffset: 0sz;
                attribute: Dwarf::DW_AT_high_pc section: textSection addressAtOffset: textSection size.
        }.
        builder endDIE.

        hasChildren ifTrue: {
            nativeCode programEntities do: {:(NativeCodeProgramEntity)eachProgramEntity :: Void |
                self buildDebugInformationForNativeCodeProgramEntity: eachProgramEntity with: builder
            }.
            builder endChildren.
        }.
        
        builder endDebugInfo
    }.
}.
