public global TypeFlags::PrimitiveVectorDefaultFlags := TypeFlags::Value | TypeFlags::Bytes.

public class PrimitiveVectorType superclass: ValueType; definition: {
    private field elementType => PrimitiveValueType.
    private field elements => Size.

    public inline method elementType => PrimitiveValueType := elementType.
    public inline method elements => Size := elements.

    public method initializeWithElementType: (initialElementType: PrimitiveValueType) elements: (initialElements: Size) ::=> Void := {
        elementType := initialElementType.
        elements := initialElements.
        self assert: elementType name isNotNil.
        self name: (elementType name asString -- "x" -- elements asString) asSymbol.

        flags := TypeFlags::PrimitiveVectorDefaultFlags.
        totalSlotCount := 0sz.
        supertype := AnyPrimitiveVector.
        instanceAlignment := elementType valueAlignment * self alignmentMultiplicationFactor.
        instanceSize := elementType valueSize * elements.
        gcLayout := supertype ensureLayoutIsComputed; gcLayout.
    }.

    public method alignmentMultiplicationFactor => Size
        := elements asLargerPowerOfTwo.

    public method alignedBitWidth => Size
        := elementType instanceSize * self alignmentMultiplicationFactor * 8sz max: 32sz.

    public override method defaultValue => self
        := self basicNew.

    public override pure method asReceiverType => Type := self.
    public override pure method asResultType => Type := self.
    public override method decayReferenceLikeForReceiverType: (reference: ReferenceLikeType) ::=> Type := self.

    public override method isPrimitiveVectorType => Boolean := true.
    public override method isPrimitiveFloatOrFloatVectorType => Boolean := elementType isPrimitiveFloatType.

    public override method canEncodeValueInBytes => Boolean := true.

    public override method encodeValue: (value: Untyped) inBytes: (bytes: AnyValue) atOffset: (offset: Size) ::=> Void := {
        ObjectModel::isLogical() ifTrue: {
            let i mutable := 0sz.
            while: i < instanceSize do: {
                bytes __uint8At__: offset + i put: (value __uint8At__: i).
            } continueWith: (i := i + 1sz).
        } ifFalse: {
            super encodeValue: value inBytes: bytes atOffset: offset
        }
    }.

    public override method canDecodeValueFromBytes => Boolean := true.

    public override method decodeValueFromBytes: (bytes: ByteArray) atOffset: (offset: Size) ::=> self := {
        let result := self basicAllocate.
        let i mutable := 0sz.
        while: i < instanceSize do: {
            result __uint8At__: i put: (bytes __uint8At__: offset + i).
        } continueWith: (i := i + 1sz).

        result
    }.

    public override method defaultValue => self := self basicAllocate.

    public override method createBasicInitializeMethod => Void := {
        let ReceiverType := self asReceiverType.
        basicInitializeMethod := {:(ReceiverType)self :: Void |
            <keepSourceDefinition>
            <primitive: #zeroInitialization>
        } makeOverride makeFinal recompileAndOptimize
    }.
}.

public class PrimitiveVectorMetatype superclass: ValueMetatype; definition: {
    __Meta__ definition:{
        public override method getOrCreateDependentApplicationValueForNode: (astNode: ASTNode)
            := PrimitiveVectorType
    }.
}.

let AnyPrimitiveVectorType := PrimitiveVectorMetatype basicNew
    flags: TypeFlags::MetatypeRequiredFlags;
    supertype: PrimitiveVectorType;
    totalSlotCount: PrimitiveVectorType validTotalSlotCount;
    yourself.
public global AnyPrimitiveVector := AnyPrimitiveVectorType basicNew
    name: #AnyPrimitiveVector;
    flags: TypeFlags::PrimitiveVectorDefaultFlags;
    supertype: AnyValue;
    slots: ();
    totalSlotCount: 0sz;
    registerInSupertype;
    yourself.
AnyPrimitiveVectorType thisType: AnyPrimitiveVector.

public pure template PrimitiveVectorTypeTemplate(elementType: PrimitiveValueType, elements: Size) => PrimitiveVectorType := {
    let metaType := PrimitiveVectorMetatype basicNew.
    metaType
        flags: TypeFlags::MetatypeRequiredFlags;
        supertype: AnyPrimitiveVectorType;
        totalSlotCount: PrimitiveVectorType validTotalSlotCount;
        yourself.
    let result => PrimitiveVectorType := metaType basicNew.
    metaType thisType: result.

    __templateResult__ value: result.

    result initializeWithElementType: elementType elements: elements; definition: {
        let VectorType := SelfType.
        let ElementType := SelfType elementType.
        let Elements := SelfType elements.
        let VectorTypeName := VectorType name asString.

        let ElementByteSize := ElementType instanceSize.
        let ElementGetterFunction => ((AnyValue, Size) => ElementType) := ElementType bytesElementGetter.
        let ElementSetterFunction => ((AnyValue, Size, ElementType) => Void) := ElementType bytesElementSetter.

        public method at: (index: Size) ::=> ElementType := {
            <primitive: #PrimitiveVector::at:>
            <targetDefinedPrimitive>
            ObjectModel::isLogical() ifTrue: {
                index >= Elements ifTrue: (error("Index is out of bounds.")).
                ElementGetterFunction(self, index * ElementByteSize)
            } ifFalse: {
                self at: index
            }
        }.

        public inline method x => ElementType := {
            <primitive: #PrimitiveVector::x>
            <targetDefinedPrimitive>
            self at: 0sz
        }.

        public inline method y => ElementType := {
            <primitive: #PrimitiveVector::y>
            <targetDefinedPrimitive>
            self at: 1sz
        }.

        Elements >= 3sz ifTrue: {
            public inline method z => ElementType := {
                <primitive: #PrimitiveVector::z>
                <targetDefinedPrimitive>
                self at: 2sz
            }.

            Elements >= 4sz ifTrue: {
                public inline method w => ElementType := {
                    <primitive: #PrimitiveVector::w>
                    <targetDefinedPrimitive>
                    self at: 3sz
                }.
            }.
        }.

        __Meta__ definition: {
            public method x: (x: ElementType) ::=> VectorType := {
                <primitive: #PrimitiveVector::makeWithX:>
                <targetDefinedPrimitive>
                ObjectModel::isLogical() ifTrue: {
                    let result := VectorType basicAllocate.
                    ElementSetterFunction(result, 0sz, x).
                    result
                } ifFalse: {
                    VectorType x: x
                }
            }.

            public method y: (y: ElementType) ::=> VectorType := {
                <primitive: #PrimitiveVector::makeWithY:>
                <targetDefinedPrimitive>
                ObjectModel::isLogical() ifTrue: {
                    let result := VectorType basicAllocate.
                    ElementSetterFunction(result, ElementByteSize, y).
                    result
                } ifFalse: {
                    VectorType y: y
                }
            }.

            public method x: (x: ElementType) y: (y: ElementType) ::=> VectorType := {
                <primitive: #PrimitiveVector::makeWithX:y:>
                <targetDefinedPrimitive>
                ObjectModel::isLogical() ifTrue: {
                    let result := VectorType basicAllocate.
                    ElementSetterFunction(result, 0sz, x).
                    ElementSetterFunction(result, ElementByteSize, y).
                    result
                } ifFalse: {
                    VectorType x: x y: y
                }
            }.

            Elements >= 3sz ifTrue: {
                public method z: (z: ElementType) ::=> VectorType := {
                    <primitive: #PrimitiveVector::makeWithZ:>
                    <targetDefinedPrimitive>
                    ObjectModel::isLogical() ifTrue: {
                        let result := VectorType basicAllocate.
                        ElementSetterFunction(result, ElementByteSize*2sz, z).
                        result
                    } ifFalse: {
                        VectorType z: z
                    }
                }.

                public method x: (x: ElementType) y: (y: ElementType) z: (z: ElementType) ::=> VectorType := {
                    <primitive: #PrimitiveVector::makeWithX:y:z:>
                    <targetDefinedPrimitive>
                    ObjectModel::isLogical() ifTrue: {
                        let result := VectorType basicAllocate.
                        ElementSetterFunction(result, 0sz, x).
                        ElementSetterFunction(result, ElementByteSize, y).
                        ElementSetterFunction(result, ElementByteSize*2sz, z).
                        result
                    } ifFalse: {
                        VectorType x: x y: y z: z
                    }
                }.

                Elements >= 4sz ifTrue: {
                    public method w: (w: ElementType) ::=> VectorType := {
                        <primitive: #PrimitiveVector::makeWithW:>
                        <targetDefinedPrimitive>
                        ObjectModel::isLogical() ifTrue: {
                            let result := VectorType basicAllocate.
                            ElementSetterFunction(result, ElementByteSize*3sz, w).
                            result
                        } ifFalse: {
                            VectorType w: w
                        }
                    }.

                    public method x: (x: ElementType) y: (y: ElementType) z: (z: ElementType) w: (w: ElementType) ::=> VectorType := {
                        <primitive: #PrimitiveVector::makeWithX:y:z:w:>
                        <targetDefinedPrimitive>
                        ObjectModel::isLogical() ifTrue: {
                            let result := VectorType basicAllocate.
                            ElementSetterFunction(result, 0sz, x).
                            ElementSetterFunction(result, ElementByteSize, y).
                            ElementSetterFunction(result, ElementByteSize*2sz, z).
                            ElementSetterFunction(result, ElementByteSize*3sz, w).
                            result
                        } ifFalse: {
                            VectorType x: x y: y z: z w: w
                        }
                    }.
                }.
            }.
        }.

        switch: Elements withCases: #{
            2sz : {
                __Meta__ definition: {
                    public pure method withAll: (element: ElementType) ::=> VectorType := {
                        <primitive: #PrimitiveVector::withAll:>
                        <targetDefinedPrimitive>
                        ObjectModel::isLogical() ifTrue: {
                            VectorType x: element y: element
                        } ifFalse: {
                            VectorType withAll: element
                        }
                    }.
                }.

                public inline method collect: (aBlock: (ElementType) => ElementType) ::=> SelfType := {
                    SelfType x: aBlock(self x) y: aBlock(self y)
                }.

                public inline method collectWithIndex: (aBlock: (ElementType, Size) => ElementType) ::=> SelfType := {
                    SelfType x: aBlock(self x, 0sz) y: aBlock(self y, 1sz)
                }.

                public inline method do: (aBlock: (ElementType) => Void) ::=> Void := {
                    aBlock(self x).
                    aBlock(self y).
                }.

                public inline method doWithIndex: (aBlock: (ElementType, Size) => Void) ::=> Void := {
                    aBlock(self x, 0sz).
                    aBlock(self y, 1sz).
                }.

                public inline method with: (other: SelfType) collect: (aBlock: (ElementType, ElementType) => ElementType) ::=> SelfType := {
                    SelfType x: aBlock(self x, other x) y: aBlock(self y, other y)
                }.
            }.
            3sz : {
                __Meta__ definition: {
                    public pure method withAll: (element: ElementType) ::=> VectorType := {
                        <primitive: #PrimitiveVector::withAll:>
                        <targetDefinedPrimitive>
                        ObjectModel::isLogical() ifTrue: {
                            VectorType x: element y: element z: element
                        } ifFalse: {
                            VectorType withAll: element
                        }
                    }.
                }.

                public inline method collect: (aBlock: (ElementType) => ElementType) ::=> SelfType := {
                    SelfType x: aBlock(self x) y: aBlock(self y) z: aBlock(self z)
                }.

                public inline method collectWithIndex: (aBlock: (ElementType, Size) => ElementType) ::=> SelfType := {
                    SelfType x: aBlock(self x, 0sz) y: aBlock(self y, 1sz) z: aBlock(self z, 2sz)
                }.

                public inline method do: (aBlock: (ElementType) => Void) ::=> Void := {
                    aBlock(self x).
                    aBlock(self y).
                    aBlock(self z).
                }.

                public inline method doWithIndex: (aBlock: (ElementType, Size) => Void) ::=> Void := {
                    aBlock(self x, 0sz).
                    aBlock(self y, 1sz).
                    aBlock(self z, 2sz).
                }.

                public inline method with: (other: SelfType) collect: (aBlock: (ElementType, ElementType) => ElementType) ::=> SelfType := {
                    SelfType x: aBlock(self x, other x) y: aBlock(self y, other y) z: aBlock(self z, other z)
                }.
            }.
            4sz : {
                __Meta__ definition: {
                    public pure method withAll: (element: ElementType) ::=> VectorType := {
                        <primitive: #PrimitiveVector::withAll:>
                        <targetDefinedPrimitive>
                        ObjectModel::isLogical() ifTrue: {
                            VectorType x: element y: element z: element w: element
                        } ifFalse: {
                            VectorType withAll: element
                        }
                    }.
                }.

                public inline method collect: (aBlock: (ElementType) => ElementType) ::=> SelfType := {
                    SelfType x: aBlock(self x) y: aBlock(self y) z: aBlock(self z) w: aBlock(self w)
                }.

                public inline method collectWithIndex: (aBlock: (ElementType, Size) => ElementType) ::=> SelfType := {
                    SelfType x: aBlock(self x, 0sz) y: aBlock(self y, 1sz) z: aBlock(self z, 2sz) w: aBlock(self w, 3sz)
                }.

                public inline method do: (aBlock: (ElementType) => Void) ::=> Void := {
                    aBlock(self x).
                    aBlock(self y).
                    aBlock(self z).
                    aBlock(self w).
                }.

                public inline method doWithIndex: (aBlock: (ElementType, Size) => Void) ::=> Void := {
                    aBlock(self x, 0sz).
                    aBlock(self y, 1sz).
                    aBlock(self z, 2sz).
                    aBlock(self w, 3sz).
                }.

                public inline method with: (other: SelfType) collect: (aBlock: (ElementType, ElementType) => ElementType) ::=> SelfType := {
                    SelfType x: aBlock(self x, other x) y: aBlock(self y, other y) z: aBlock(self z, other z) w: aBlock(self w, other w)
                }.
            }.
            _: error("Unsupported primitive vector with " -- Elements asString -- " elements.")
        }.

        ElementType isPrimitiveNumberType ifTrue: {
            let Zeros := SelfType withAll: ElementType zero.
            let Ones := SelfType withAll: ElementType one.

            __Meta__ definition: {
                public pure method zeros => VectorType := Zeros.
                public pure method ones => VectorType := Ones.
            }.

            public pure method negated => SelfType := {
                <primitive: (VectorTypeName -- "::negated") asSymbol>
                <targetDefinedPrimitive>
                self collect: {:(ElementType)element :: ElementType | element negated}
            }.

            ElementType isPrimitiveFloatType ifTrue: {
                public pure method sqrt => SelfType := {
                    <primitive: (VectorTypeName -- "::sqrt") asSymbol>
                    <targetDefinedPrimitive>
                    self collect: {:(ElementType)element :: ElementType | element sqrt}
                }.
            }.

            public pure method + (other: SelfType) => SelfType := {
                <primitive: (VectorTypeName -- "::+") asSymbol>
                <targetDefinedPrimitive>
                self with: other collect: {:(ElementType)a :(ElementType)b :: ElementType | a + b}
            }.

            public pure method - (other: SelfType) => SelfType := {
                <primitive: (VectorTypeName -- "::-") asSymbol>
                <targetDefinedPrimitive>
                self with: other collect: {:(ElementType)a :(ElementType)b :: ElementType | a - b}
            }.

            public pure method * (other: SelfType) => SelfType := {
                <primitive: (VectorTypeName -- "::*") asSymbol>
                <targetDefinedPrimitive>
                self with: other collect: {:(ElementType)a :(ElementType)b :: ElementType | a * b}
            }.

            public pure method / (other: SelfType) => SelfType := {
                <primitive: (VectorTypeName -- "::/") asSymbol>
                <targetDefinedPrimitive>
                self with: other collect: {:(ElementType)a :(ElementType)b :: ElementType | a / b}
            }.

            ElementType isPrimitiveIntegerType ifTrue: {
                public pure method % => SelfType := {
                    <primitive: (VectorTypeName -- "::%") asSymbol>
                    <targetDefinedPrimitive>
                    self with: other collect: {:(ElementType)a :(ElementType)b :: ElementType | a % b}
                }.

                public pure method \\ => SelfType := {
                    <primitive: (VectorTypeName -- "::\\\\") asSymbol>
                    <targetDefinedPrimitive>
                    self with: other collect: {:(ElementType)a :(ElementType)b :: ElementType | a \\ b}
                }.
            }.

            public pure method min: (other: SelfType) ::=> SelfType := {
                <primitive: (VectorTypeName -- "::min:") asSymbol>
                <targetDefinedPrimitive>
                self with: other collect: {:(ElementType)a :(ElementType)b :: ElementType | a min: b}
            }.

            public pure method max: (other: SelfType) ::=> SelfType := {
                <primitive: (VectorTypeName -- "::max:") asSymbol>
                <targetDefinedPrimitive>
                self with: other collect: {:(ElementType)a :(ElementType)b :: ElementType | a max: b}
            }.
        }.

        public override method printOn: (stream: Stream) ::=> Void := {
            stream print: SelfType; nextPut: '('c8.
            self doWithIndex: {:(ElementType)element :(Size)index :: Void |
                index > 0sz ifTrue: (stream string: ", ").
                element printOn: stream
            }.
            stream nextPut: ')'c8.
        }.
    }; yourself
}.

#*
public global Booleanx2 := PrimitiveVectorTypeTemplate(Boolean, 2sz).
public global Booleanx3 := PrimitiveVectorTypeTemplate(Boolean, 3sz).
public global Booleanx4 := PrimitiveVectorTypeTemplate(Boolean, 4sz).
public global Booleanx8 := PrimitiveVectorTypeTemplate(Boolean, 8sz).
public global Booleanx16 := PrimitiveVectorTypeTemplate(Boolean, 16sz).

public global Int8x4  := PrimitiveVectorTypeTemplate(Int8, 4sz).
public global Int8x8  := PrimitiveVectorTypeTemplate(Int8, 8sz).
public global Int8x16 := PrimitiveVectorTypeTemplate(Int8, 16sz).

public global Int32x2 := PrimitiveVectorTypeTemplate(Int32, 2sz).
public global Int32x3 := PrimitiveVectorTypeTemplate(Int32, 3sz).
public global Int32x4 := PrimitiveVectorTypeTemplate(Int32, 4sz).

public global UInt8x4  := PrimitiveVectorTypeTemplate(Int8, 4sz).
public global UInt8x8  := PrimitiveVectorTypeTemplate(Int8, 8sz).
public global UInt8x16 := PrimitiveVectorTypeTemplate(Int8, 16sz).

public global UInt32x2 := PrimitiveVectorTypeTemplate(UInt32, 2sz).
public global UInt32x3 := PrimitiveVectorTypeTemplate(UInt32, 3sz).
public global UInt32x4 := PrimitiveVectorTypeTemplate(UInt32, 4sz).
*#

public global Float32x2 := PrimitiveVectorTypeTemplate(Float32, 2sz).
public global Float32x3 := PrimitiveVectorTypeTemplate(Float32, 3sz).
public global Float32x4 := PrimitiveVectorTypeTemplate(Float32, 4sz).

public global Float64x2 := PrimitiveVectorTypeTemplate(Float64, 2sz).
public global Float64x3 := PrimitiveVectorTypeTemplate(Float64, 3sz).
public global Float64x4 := PrimitiveVectorTypeTemplate(Float64, 4sz).
