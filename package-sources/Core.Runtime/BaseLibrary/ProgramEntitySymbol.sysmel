Metatype definition: {
    public override method printQualifiedNameOn: (stream: Stream) ::=> Void := {
        thisType ifNotNil: {
            thisType printQualifiedNameOn: stream.
            stream nextPutAll: ".__Meta__".
        } ifNil: {
            super printQualifiedNameOn: stream
        }
    }
}.

