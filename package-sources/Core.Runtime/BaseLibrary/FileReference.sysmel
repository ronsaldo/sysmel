public class FileReference definition: {
    public field path => String.

    public method binaryReadStream => Stream := {
        let handle := sysmel_pal_openFile(path size, path __rawContentsPointer__ reinterpretCastTo: Char8 const pointer, SysmelPAL::FileOpenFlags::ReadOnly, 0u32).
        handle ifNil: {
            self error: "Failed to open file for reading " -- self printString.
        }.

        BinaryFileStream withHandle: handle owned: true canRead: true canWrite: false
    }.

    public inline method binaryReadStreamDo: (aBlock: (Stream) => AnyValue) ::=> AnyValue := {
        let stream := self binaryReadStream.
        {| 
            aBlock(stream)
        } ensure: {:: Void |
            stream close
        }.
    }.

