        let handle := sysmel_pal_openFile(path size, path __rawContentsPointer__ reinterpretCastTo: Char8 const pointer,
            SysmelPAL::FileOpenFlags::WriteOnly | SysmelPAL::FileOpenFlags::Create | SysmelPAL::FileOpenFlags::Truncate,
            SysmelPAL::FileCreationPermissions::RegularFileDefaults).
        handle ifNil: {
            self error: "Failed to open file for reading " -- self printString.
        }.

        BinaryFileStream withHandle: handle owned: true canRead: false canWrite: true
