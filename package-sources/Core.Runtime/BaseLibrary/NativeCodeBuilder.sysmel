public final class NativeCodeBuilder superclass: Object; definition: {
    private field symbolTableBuilder => NativeCodeSymbolTableBuilder.
    private field sectionNameTable => Dictionary.
    private field sections => OrderedCollection.

    public override method initialize => Void := {
        sectionNameTable := Dictionary new.
        sections := OrderedCollection new.
        symbolTableBuilder := NativeCodeSymbolTableBuilder new.
    }.

    public method getSectionNamed: (sectionNameSymbol: Symbol) orCreateWith: (sectionCreationBlock: () => NativeCodeSectionBuilder) ::=> NativeCodeSectionBuilder
        := sectionNameTable at: sectionNameSymbol ifAbsentPut: {::NativeCodeSectionBuilder |
            let section := sectionCreationBlock().
            section symbolTableBuilder: symbolTableBuilder.
            sections add: section.
            section
        }.

    public method ehFrameSection => NativeCodeSectionBuilder
        := self getSectionNamed: #".eh_frame" orCreateWith: {:: NativeCodeSectionBuilder |
            NativeCodeSectionBuilder new
                name: #".eh_frame";
                flags: NativeCodeSection::Flags::Loaded | NativeCodeSection::Flags::Readable;
                yourself
        }.

    public method debugAbbrevSection => NativeCodeSectionBuilder
        := self getSectionNamed: #".debug_abbrev" orCreateWith: {:: NativeCodeSectionBuilder |
            NativeCodeSectionBuilder new
                name: #".debug_abbrev";
                machoSectionName: #__debug_abbrev;
                machoSegmentName: #__DWARF;
                flags: NativeCodeSection::Flags::Debugging;
                yourself
        }.

    public method debugInfoSection => NativeCodeSectionBuilder
        := self getSectionNamed: #".debug_info" orCreateWith: {:: NativeCodeSectionBuilder |
            NativeCodeSectionBuilder new
                name: #".debug_info";
                machoSectionName: #__debug_info;
                machoSegmentName: #__DWARF;
                flags: NativeCodeSection::Flags::Debugging;
                yourself
        }.

    public method debugLineSection => NativeCodeSectionBuilder
        := self getSectionNamed: #".debug_line" orCreateWith: {:: NativeCodeSectionBuilder |
            NativeCodeSectionBuilder new
                name: #".debug_line";
                machoSectionName: #__debug_line;
                machoSegmentName: #__DWARF;
                flags: NativeCodeSection::Flags::Debugging;
                yourself
        }.

    public method debugFrameSection => NativeCodeSectionBuilder
        := self getSectionNamed: #".debug_frame" orCreateWith: {:: NativeCodeSectionBuilder |
            NativeCodeSectionBuilder new
                name: #".debug_frame";
                machoSectionName: #__debug_frame;
                machoSegmentName: #__DWARF;
                flags: NativeCodeSection::Flags::Debugging;
                yourself
        }.

    public method debugStringSection => NativeCodeSectionBuilder
        := self getSectionNamed: #".debug_str" orCreateWith: {:: NativeCodeSectionBuilder |
            NativeCodeSectionBuilder new
                name: #".debug_str";
                machoSectionName: #__debug_str;
                machoSegmentName: #__DWARF;
                flags: NativeCodeSection::Flags::Debugging;
                yourself
        }.

    public method finish => NativeCode := {
        let symbolTable := symbolTableBuilder finish.
        NativeCode new
            symbolTable: symbolTable;
            sections: (sections collect: {:(NativeCodeSectionBuilder)each :: NativeCodeSection | 
                each finish
                    symbolTable: symbolTable;
                    yourself
            } as: Array);
            yourself
    }
}.
