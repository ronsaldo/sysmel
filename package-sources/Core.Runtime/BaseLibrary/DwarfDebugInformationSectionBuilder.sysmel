public class DwarfDebugInformationSectionBuilder superclass: Object; definition: {
    public field abbrevSection => NativeCodeSectionBuilder.
    public field infoSection => NativeCodeSectionBuilder.
    public field stringSection => NativeCodeSectionBuilder.
    public field dwarfSize => Size.
    public field pointerSize => Size.
    public field version => UInt16.

    private field initialLengthOffset => Size.
    private field abbrevBaseOffset => Size.
    private field abbrevCount => Size.

    public override method initialize => Void := {
        version := 5u16.
        dwarfSize := 4sz.
        abbrevCount := 0sz.
    }.

    public method beginDebugInfo => Void := {
        abbrevBaseOffset := abbrevSection size.
        initialLengthOffset := infoSection size.

        dwarfSize = 4sz ifTrue: {
            infoSection uint32: 0u32
        } ifFalse: {
            infoSection
                uint32: 16rFFFF_FFFF u32;
                uint64: 0u64.
        }.


        infoSection uint16: version.
        version >= 5u16 ifTrue: {
            infoSection uint8: Dwarf::DW_UT_compile asUInt8.
            infoSection uint8: pointerSize asUInt8.
            dwarfSize = 4sz ifTrue: {
                infoSection section: abbrevSection section relativeInt32: abbrevBaseOffset asInt32
            } ifFalse: {
                infoSection section: abbrevSection section relativeInt64: abbrevBaseOffset asInt64
            }.
        } ifFalse: {
            dwarfSize = 4sz ifTrue: {
                infoSection section: abbrevSection section relativeInt32: abbrevBaseOffset asInt32
            } ifFalse: {
                infoSection section: abbrevSection section relativeInt64: abbrevBaseOffset asInt64
            }.
            infoSection uint8: pointerSize asUInt8.
        }.
    }.

    public method endDebugInfo => Void := {
        abbrevSection uleb128: 0sz.

        dwarfSize = 4sz ifTrue: {
            infoSection uint32At: initialLengthOffset put: (infoSection size - initialLengthOffset - 4sz) asUInt32.
        } ifFalse: {
            infoSection uint64At: initialLengthOffset + 4sz put: (infoSection size - initialLengthOffset - 12sz) asUInt64.
        }.
    }.

    public method beginDIE: (tag: Dwarf::Constant) hasChildren: (hasChildren: Boolean) ::=> Void := {
        let abbrevCode := (abbrevCount := abbrevCount + 1sz).
        abbrevSection
            uleb128: abbrevCode asSize;
            uleb128: tag asSize;
            uleb128: (hasChildren ifTrue: Dwarf::DW_CHILDREN_yes asSize ifFalse: Dwarf::DW_CHILDREN_no asSize).

        infoSection uleb128: abbrevCode.
    }.

    public method endChildren ::=> Void := {
        infoSection uleb128: 0sz
    }.

    public method endDIE ::=> Void := {
        abbrevSection
            uleb128: 0sz;
            uleb128: 0sz
    }.

    public method attribute: (name: Dwarf::Constant) string: (value: String) ::=> Void := {
        abbrevSection uleb128: name asSize; uleb128: Dwarf::DW_FORM_strp asSize.

        let stringOffset := stringSection size.
        stringSection cstring: value.

        dwarfSize = 4sz ifTrue: {
            infoSection section: stringSection section relativeInt32: stringOffset asInt32
        } ifFalse: {
            infoSection section: stringSection section relativeInt64: stringOffset asInt64
        }.
    }.

    public method attribute: (name: Dwarf::Constant) section: (section: NativeCodeSection) relativeOffset: (offset: Size) ::=> Void := {
        abbrevSection uleb128: name asSize; uleb128: Dwarf::DW_FORM_sec_offset asSize.

        dwarfSize = 4sz ifTrue: {
            infoSection section: section relativeInt32: offset asInt32
        } ifFalse: {
            infoSection section: section relativeInt64: offset asInt64
        }.
    }.

    public method attribute: (name: Dwarf::Constant) section: (section: NativeCodeSection) addressAtOffset: (offset: Size) ::=> Void := {
        abbrevSection uleb128: name asSize; uleb128: Dwarf::DW_FORM_addr asSize.

        pointerSize = 4sz ifTrue: {
            infoSection uint32IntoSection: section addend: offset asUInt32
        } ifFalse: {
            infoSection uint64IntoSection: section addend: offset asUInt64
        }.
    }.

    public method attribute: (name: Dwarf::Constant) uleb128: (value: UIntPointer) ::=> Void := {
        abbrevSection uleb128: name asSize; uleb128: Dwarf::DW_FORM_udata asSize.
        infoSection uleb128: value
    }.

    public method attribute: (name: Dwarf::Constant) sleb128: (value: IntPointer) ::=> Void := {
        abbrevSection uleb128: name asSize; uleb128: Dwarf::DW_FORM_sdata asSize.
        infoSection sleb128: value
    }.
}.
