public class SysmelParserState definition: {
    public field sourceCode => SourceCode.
    public field tokens => Array.
    public field tokensSize => Size.
    public field position => Size.

    public method atEnd ::=> Boolean
        := position >= tokensSize.


    public method peekKindAtOffset: (offset: Size) ::=> Int32 := {
        let peekPosition := position + offset.
        if: peekPosition >= tokensSize
            then: SysmelTokenKind::EndOfSource
            else: (tokens at: peekPosition) kind
    }.

    public method advance ::=> Void := {
        self assert: position < tokensSize.
        position := position + 1sz
    }.

    public method peekKind ::=> Int32
        := self peekKindAtOffset: 1sz.

    public method peek ::=> SysmelToken := {
        self assert: position < tokensSize.
        tokens at: position
    }.

    public method next ::=> SysmelToken := {
        self assert: position < tokensSize.
        let token := tokens at: position.
        position := position + 1sz.
        token
    }.

    public method sourcePositionFrom: (startingPosition: Size) ::=> SourcePosition := {
        self assert: startingPosition < tokensSize.
        let startSourcePosition := (self tokens at: startingPosition) sourcePosition.
        if: position > 0sz then: {
            let endSourcePosition := self previousSourcePosition.
            return: (startSourcePosition to: endSourcePosition)
        } else: {
            let endSourcePosition := self currentSourcePosition.
            return: (startSourcePosition until: endSourcePosition)
        }
    }.

    public method previousSourcePosition => SourcePosition := {
        self assert: position > 0sz.
        (tokens at: position - 1sz) sourcePosition
    }.

    public method currentSourcePosition => SourcePosition := {
        if: (position < tokens size) then: {
            return: (tokens at: position) sourcePosition
        }.

        self assert: tokens isNotEmpty.
        return: (tokens at: tokens size - 1sz) sourcePosition
    }.

    public method makeErrorAtCurrentPosition: (errorMessage: String) ::=> ASTErrorNode := {
        ASTErrorNode new
            sourcePosition: self currentSourcePosition;
            errorMessage: errorMessage;
            yourself
    }.

    public method advanceWithExpectedError: (errorMessage: String) ::=> ASTErrorNode := {
        self advance.
        self makeErrorAtCurrentPosition: errorMessage
    }.

    public method expect: (kind: Int32) addingErrorToNode: (node: ASTNode) ::=> ASTNode := {
        self peekKind = kind ifTrue: {
            self advance.
            return: node
        }.

        let errorNode := ASTErrorNode new
            sourcePosition: self currentSourcePosition;
            errorMessage: "Expected a specific token";
            yourself.
        ASTSequenceNode new
            sourcePosition: self currentSourcePosition;
            expressions: (Array with: node with: errorNode);
            yourself
    }
}.

public class SysmelParser superclass: Object; definition: {

    private method parseLiteralToken: (state: SysmelParserState) ::=> ASTLiteralNode := {
        let token := state next.

        ASTLiteralNode new
            sourcePosition: token sourcePosition;
            value: token value;
            yourself
    }.

    private method parseLiteral: (state: SysmelParserState) ::=> ASTNode := {
        switch: state peekKind withCases: #{
            SysmelTokenKind::Integer   : self parseLiteralToken: state.
            SysmelTokenKind::Float     : self parseLiteralToken: state.
            SysmelTokenKind::Character : self parseLiteralToken: state.
            SysmelTokenKind::String    : self parseLiteralToken: state.
            SysmelTokenKind::Symbol    : self parseLiteralToken: state.
            _: state advanceWithExpectedError: "Expected a literal."
        }
    }.

    private method parseIdentifier: (state: SysmelParserState) ::=> ASTNode := {
        let token := state next.
        self assert: token kind = SysmelTokenKind::Identifier.

        ASTIdentifierReferenceNode new
            sourcePosition: token sourcePosition;
            value: token value;
            yourself
    }.

    private method isBinaryOperator: (tokenKind: Int32) ::=> Boolean := {
        switch: tokenKind withCases: #{
            SysmelTokenKind::Operator    : true.
            SysmelTokenKind::Star        : true.
            SysmelTokenKind::LessThan    : true.
            SysmelTokenKind::GreaterThan : true.
            SysmelTokenKind::Bar         : true.
            _: false
        }
    }.
    
    private method parseParenthesis: (state: SysmelParserState) ::=> ASTNode := {
        let startPosition := state position.
        self assert: state peekKind = SysmelTokenKind::LeftParent.
        state advance.

        if: (self isBinaryOperator: state peekKind) && ((state peekKindAtOffset: 1sz) = SysmelTokenKind::RightParent) then: {
            let token := state next.
            state advance.
            return: (ASTIdentifierReferenceNode new
                sourcePosition: token sourcePosition;
                value: token value;
                yourself)
        }.

        if: state peekKind = SysmelTokenKind::RightParent then: {
            state advance.
            return: (ASTMakeArrayNode new
                sourcePosition: (state sourcePositionFrom: startPosition);
                elements: #();
                yourself)
        }.

        let expression := self parseSequence: state untilEndOrDelimiter: SysmelTokenKind::RightParent.
        state expect: SysmelTokenKind::RightParent addingErrorToNode: expression.
    }.

    private method parsePragma: (state: SysmelParserState) ::=> ASTNode := {
        let startPosition := state position.
        self assert: state peekKind = SysmelTokenKind::LessThan.
        state advance.

        let selector mutable := "".
        let arguments := OrderedCollection new.

        switch: state peekKind withCases: #{
            SysmelTokenKind::Identifier : {
                let identifierToken := state next.
                selector := identifierToken value
            }.
            SysmelTokenKind::Keyword : {
                while: (state peekKind = SysmelTokenKind::Keyword) do: {
                    let keywordToken := state next.
                    selector := selector -- keywordToken value.
                    
                    let argument := self parseUnaryPrefix: state.
                    arguments add: argument
                }
            }.
            _: state advanceWithExpectedError: "Expected a content."
        }.

        if: state peekKind = SysmelTokenKind::GreaterThan then: {
            state advance
        } else: {
            arguments add: (state advanceWithExpectedError: "Expected > to finish the pragma.")
        }.

        let selectorLiteral := 
            ASTLiteralNode new
            sourcePosition: (state sourcePositionFrom: startPosition);
            value: selector asSymbol;
            yourself.
        ASTPragmaNode new
            sourcePosition: (state sourcePositionFrom: startPosition);
            selector: selectorLiteral;
            arguments: arguments asArray;
            yourself
    }.

    private method parseBlock: (state: SysmelParserState) ::=> ASTNode := {
        let startPosition := state position.
        self assert: state peekKind = SysmelTokenKind::LeftCurlyBracket.
        state advance.

        let pragmas := OrderedCollection new.
        while: (state peekKind = SysmelTokenKind::LessThan) do:
        {
            let pragma := self parsePragma: state.
            pragmas add: pragma
        }.

        let expressions := self parseExpressionList: state untilEndOrDelimiter: SysmelTokenKind::RightCurlyBracket.
        if: (state peekKind = SysmelTokenKind::RightCurlyBracket) then: {
            state advance
        } else: {
            expressions add: (state makeErrorAtCurrentPosition: "Expected a right curly bracket" )
        }.

        let sequenceNode := ASTSequenceNode new
            sourcePosition: (state sourcePositionFrom: startPosition);
            pragmas: pragmas asArray;
            expressions: expressions asArray;
            yourself.
        ASTLexicalBlockNode new
            sourcePosition: (state sourcePositionFrom: startPosition);
            body: sequenceNode;
            yourself.
    }.
    private method parseTerm: (state: SysmelParserState) ::=> ASTNode := {
        switch: state peekKind withCases: #{
            SysmelTokenKind::Identifier : self parseIdentifier: state.
            SysmelTokenKind::LeftParent : self parseParenthesis: state.
            SysmelTokenKind::LeftCurlyBracket : self parseBlock: state.
            ##SysmelTokenKind::LeftBracket : self parseArray: state.
            ##SysmelTokenKind::ByteArrayStart : self parseByteArray: state.
            ##SysmelTokenKind::DictionaryStart : self parseDictionary: state.
            _: (self parseLiteral: state).
        }
    }.

    private method isUnaryPostfixTokenKind: (kind: Int32) ::=> Boolean := {
        switch: (kind) withCases: #{
            SysmelTokenKind::Identifier : true.
            SysmelTokenKind::LeftParent : true.
            SysmelTokenKind::LeftBracket : true.
            SysmelTokenKind::LeftCurlyBracket : true.
            SysmelTokenKind::ByteArrayStart : true.
            SysmelTokenKind::DictionaryStart : true.
            _: false
        }
    }.


    private method parseUnaryPostfix: (state: SysmelParserState) ::=> ASTNode := {
        let startPosition := state position.
        let receiver mutable := self parseTerm: state.
        
        while: (self isUnaryPostfixTokenKind: state peekKind) do: {
            let token := state peek.
            if: token kind = SysmelTokenKind::Identifier then: {
                state advance.

                let selector := ASTLiteralNode new
                    sourcePosition: token sourcePosition;
                    value: token value asSymbol;
                    yourself.

                let message := ASTMessageSendNode new
                    receiver: receiver;
                    selector: selector;
                    arguments: #();
                    yourself.
                
                receiver := message
            }.
            if: token kind = SysmelTokenKind::LeftParent then: {
                state advance.
                let arguments := self parseExpressionList: state untilEndOrDelimiter: SysmelTokenKind::RightParent.
                if: (state peekKind = SysmelTokenKind::RightParent) then: {
                    state advance
                } else: {
                    arguments add: (state makeErrorAtCurrentPosition: "Expected a right parent" )
                }.

                let application := ASTFunctionApplicationNode new
                    sourcePosition: (state sourcePositionFrom: startPosition);
                    functionExpression: receiver;
                    arguments: arguments asArray;
                    yourself.

                receiver := application
            }
        }.
        receiver
    }.

    private method parseQuote: (state: SysmelParserState) ::=> ASTNode := {
        let startPosition := state position.
        self assert: state peekKind = SysmelTokenKind::Quote.
        state advance.

        let term := self parseUnaryPrefix: state.
        ASTQuoteNode new
            sourcePosition: (state sourcePositionFrom: startPosition);
            node: term;
            yourself
    }.

    private method parseQuasiQuote: (state: SysmelParserState) ::=> ASTNode := {
        let startPosition := state position.
        self assert: state peekKind = SysmelTokenKind::QuasiQuote.
        state advance.

        let term := self parseUnaryPrefix: state.
        ASTQuasiQuoteNode new
            sourcePosition: (state sourcePositionFrom: startPosition);
            node: term;
            yourself
    }.

    private method parseQuasiUnquote: (state: SysmelParserState) ::=> ASTNode := {
        let startPosition := state position.
        self assert: state peekKind = SysmelTokenKind::QuasiUnquote.
        state advance.

        let term := self parseUnaryPrefix: state.
        ASTQuasiUnquoteNode new
            sourcePosition: (state sourcePositionFrom: startPosition);
            expression: term;
            yourself
    }.

    private method parseSplice: (state: SysmelParserState) ::=> ASTNode := {
        let startPosition := state position.
        self assert: state peekKind = SysmelTokenKind::Splice.
        state advance.

        let term := self parseUnaryPrefix: state.
        ASTSpliceNode new
            sourcePosition: (state sourcePositionFrom: startPosition);
            expression: term;
            yourself
    }.

    private method parseUnaryPrefix: (state: SysmelParserState) ::=> ASTNode := {
        switch: state peekKind withCases: #{
            SysmelTokenKind::Quote        : self parseQuote: state.
            SysmelTokenKind::QuasiQuote   : self parseQuasiQuote: state.
            SysmelTokenKind::QuasiUnquote : self parseQuasiUnquote: state.
            SysmelTokenKind::Splice       : self parseSplice: state.
            _: (self parseUnaryPostfix: state).
        }
    }.

    private method parseBinaryExpressionSequence: (state: SysmelParserState) ::=> ASTNode := {
        let startingPosition := state position.
        let operand := self parseUnaryPrefix: state.

        (self isBinaryOperator: state peekKind) ifFalse: {
            return: operand
        }.

        let elements := OrderedCollection new.
        elements add: operand.

        while: (self isBinaryOperator: state peekKind) do: {
            let operatorToken := state next.
            elements add: (ASTLiteralNode new
                sourcePosition: operatorToken sourcePosition;
                value: operatorToken value asSymbol;
                yourself).

            let nextOperand := self parseUnaryPrefix: state.
            elements add: nextOperand
        }.

        ASTBinaryExpressionSequenceNode new
            sourcePosition: (state sourcePositionFrom: startingPosition);
            elements: elements asArray;
            yourself
    }.

    private method parseAssociationExpression: (state: SysmelParserState) ::=> ASTNode := {
        let startingPosition := state position.
        let key := self parseBinaryExpressionSequence: state.

        if: (state peekKind ~= SysmelTokenKind::Colon) then: {
            return: key
        }.

        state advance.
        let value := self parseAssociationExpression: state.
        
        ASTMakeAssociationNode new
            sourcePosition: (state sourcePositionFrom: startingPosition);
            key: key;
            value: value;
            yourself
    }.

    private method parseKeywordApplication: (state: SysmelParserState) ::=> ASTNode := {
        self assert: state peekKind = SysmelTokenKind::Keyword.
        let startingPosition := state position.

        let symbolValue mutable := "".
        let arguments := OrderedCollection new.
        while: (state peekKind = SysmelTokenKind::Keyword) do: {
            let token := state next.
            symbolValue := symbolValue -- token value.

            let argument := self parseAssociationExpression: state.
            arguments add: argument.
        }.

        let identifier := ASTLiteralNode new
            sourcePosition: (state sourcePositionFrom: startingPosition);
            value: symbolValue asSymbol;
            yourself.
        ASTMessageSendNode new
            sourcePosition: (state sourcePositionFrom: startingPosition);
            selector: identifier;
            arguments: arguments asArray;
            yourself
    }.

    private method parseKeywordMessageSend: (state: SysmelParserState) ::=> ASTNode := {
        let startingPosition := state position.
        let receiver := self parseAssociationExpression: state.

        if: state peekKind ~= SysmelTokenKind::Keyword then: {
            return: receiver
        }.

        let selectorValue mutable := "".
        let arguments := OrderedCollection new.

        while: (state peekKind = SysmelTokenKind::Keyword) do: {
            let keywordToken := state next.
            selectorValue := selectorValue -- keywordToken value.

            let argument := self parseAssociationExpression: state.
            arguments add: argument
        }.

        let selectorLiteral := ASTLiteralNode new
            sourcePosition: (state sourcePositionFrom: startingPosition);
            value: selectorValue asSymbol;
            yourself.
        ASTMessageSendNode new
            sourcePosition: (state sourcePositionFrom: startingPosition);
            receiver: receiver;
            selector: selectorLiteral;
            arguments: arguments asArray;
            yourself.
    }.

    private method parseCascadedMessage: (state: SysmelParserState) ::=> ASTNode := {
        let startingPosition := state position.
        let token := state peek.
        if: (state peekKind = SysmelTokenKind::Identifier) then: {
            state advance.

            let selector := ASTLiteralNode new
                sourcePosition: token sourcePosition;
                value: token value asSymbol;
                yourself.
            
            let cascadedMessage := ASTMessageChainMessageNode new
                sourcePosition: (state sourcePositionFrom: startingPosition);
                selector: selector;
                arguments: #();
                yourself.
            return: cascadedMessage
        }.
        
        state makeErrorAtCurrentPosition: "Expected a cascaded message."
    }.

    private method parseMessageCascade: (state: SysmelParserState) ::=> ASTNode := {
        let startingPosition := state position.
        let firstMessage := self parseKeywordMessageSend: state.
        if: (state peekKind ~= SysmelTokenKind::Semicolon)
            then: (return: firstMessage).

        let messageCascade := firstMessage asMessageChain.
        let chainMessages := OrderedCollection new. 
        chainMessages addAll: messageCascade messages.

        while: (state peekKind = SysmelTokenKind::Semicolon) do: {
            let nextMessage := self parseCascadedMessage: state.
            chainMessages add: nextMessage
        }.

        messageCascade messages: chainMessages asArray.
        return: messageCascade
    }.

    private method parseLowPrecedenceExpression: (state: SysmelParserState) ::=> ASTNode := {
        if: (state peekKind = SysmelTokenKind::Keyword)
            then: (self parseKeywordApplication: state)
            else: (self parseMessageCascade: state)
    }.

    private method parseAssignmentExpression: (state: SysmelParserState) ::=> ASTNode := {
        let startPosition := state position.
        let assignedStore := self parseLowPrecedenceExpression: state.
        if: (state peekKind = SysmelTokenKind::Assignment) then: {
            let token := state next.
            let assignedValue := self parseAssignmentExpression: state.
            ASTMessageSendNode new
                receiver: assignedStore;
                selector: token value asSymbol;
                arguments: (Array with: assignedValue);
                yourself
        }
        else: {
            assignedStore
        }
    }.

    private method parseCommaExpression: (state: SysmelParserState) ::=> ASTNode := {
        let startingPosition := state position.
        let element := self parseAssignmentExpression: state.

        if: (state peekKind ~= SysmelTokenKind::Comma) then: {
            return: element
        }.

        let elements := OrderedCollection new.
        while: (state peekKind = SysmelTokenKind::Comma) do: {
            state advance.
            let nextElement := self parseAssignmentExpression: state.
            elements add: nextElement
        }.

        ASTMakeArrayNode new
            sourcePosition: (state sourcePositionFrom: startingPosition);
            elements: elements asArray;
            yourself            
    }.

    private method parseExpression: (state: SysmelParserState) ::=> ASTNode
        := self parseCommaExpression: state.

    private method parseExpressionList: (state: SysmelParserState) untilEndOrDelimiter: (delimiter: Int32) ::=> OrderedCollection := {
        let elements := OrderedCollection new.

        ## Leading dots.
        while: state peekKind = SysmelTokenKind::Dot do: {
            state advance
        }.

        let expectsExpression mutable := true.
        while: (state atEnd not && (state peekKind ~= delimiter)) do: {
            if: expectsExpression not then: {
                elements add: (state makeErrorAtCurrentPosition: "Expected dot before expression.")
            }.

            let expression := self parseExpression: state.
            elements add: expression.
            expectsExpression := false.

            ## Trailing dots
            while: (state peekKind = SysmelTokenKind::Dot) do: {
                state advance.
                expectsExpression := true.
            }
        }.

        elements
    }.

    private method parseSequence: (state: SysmelParserState) untilEndOrDelimiter: (delimiter: Int32) ::=> ASTNode := {
        let initialPosition := state position.
        let expressions := (self parseExpressionList: state untilEndOrDelimiter: delimiter) asArray.
        if: expressions size = 1sz then: {
            return: expressions first
        }.

        ASTSequenceNode new
            sourcePosition: (state sourcePositionFrom: initialPosition);
            pragmas: #();
            expressions: expressions;
            yourself
    }.

    private method parseTopLevelExpression: (state: SysmelParserState) ::=> ASTNode := {
        self parseSequence: state untilEndOrDelimiter: SysmelTokenKind::EndOfSource 
    }.

    public method parseTokens: (tokens: Array) withSourceCode: (sourceCode: SourceCode) ::=> ASTNode := {
        let parseState := SysmelParserState new
            tokens: tokens;
            tokensSize: tokens size;
            sourceCode: sourceCode;
            position: 0sz;
            yourself.
        ##printLine(tokens printString).
        let result := self parseTopLevelExpression: parseState.
        ##printLine("Result").
        result
    }.
}