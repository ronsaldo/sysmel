        codegen function callingConvention asm::generateExceptionSetjmpRegistersFor: instruction with: codegen
    }.

MIR::Operation::ExceptionLongjmp
    forTargets: #(x86 x86_64) registerConstraintsWith: {:(MIRInstruction)instruction :(MIRRegisterAllocator)allocator :: Void |
        allocator callingConvention asm::allocateExceptionLongjmpRegistersFor: instruction with: allocator
    };
    forTargets: #(x86 x86_64) generateWith: {:(MIRInstruction)instruction :(MIRFunctionAsmCodeGenerator)codegen :: Void |
        codegen function callingConvention asm::generateExceptionLongjmpRegistersFor: instruction with: codegen
    }.

AsmCompilationTarget extend: {
    public abstract method asMirCompilationTarget => MIRCompilationTarget
        := self subclassResponsibility
}.

AsmX86CompilationTarget extend: {
    public override method asMirCompilationTarget => MIRX86CompilationTarget
        := MIRX86CompilationTarget new asmCompilationTarget: self; yourself
}.

AsmX86_64CompilationTarget extend: {
    public override method asMirCompilationTarget => MIRX86_64CompilationTarget
        := MIRX86_64CompilationTarget new asmCompilationTarget: self; yourself.
}.
