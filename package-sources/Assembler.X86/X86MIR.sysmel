).

public global X86_64::Win64::CallTouchedRegister => Array := (
    MIR::X86_64::RAX, MIR::X86_64::RCX, MIR::X86_64::RDX,
    MIR::X86_64::R8, MIR::X86_64::R9, MIR::X86_64::R10, MIR::X86_64::R11
).

public final class MIRWinX64RegisterAssignmentState superclass: Object; definition: {
    public field usedRegisterCount => Size.

    public method allocateIntegerRegister => MIRPhysicalLocation := {
        usedRegisterCount < 4sz ifTrue: {
            let register := X86_64::Win64::IntegerArgumentRegisters at: usedRegisterCount.
            usedRegisterCount := usedRegisterCount + 1sz.
            register
        } ifFalse: {
            nil
        }
    }.

    public method allocateVectorRegister => MIRPhysicalLocation := {
        usedRegisterCount < 4sz ifTrue: {
            let register := X86_64::Win64::VectorArgumentRegisters at: usedRegisterCount.
            usedRegisterCount := usedRegisterCount + 1sz.
            register
        } ifFalse: {
            nil
        }
    }.

    public method allocateIntegerOfSize: (size: UInt64) alignment: (alignment: UInt64) ::=> MIRPhysicalLocation
        := size <= 8u64 ifTrue: (self allocateIntegerRegister) ifFalse: nil.

    public method allocateVectorOfSize: (size: UInt64) alignment: (alignment: UInt64) ::=> MIRPhysicalLocation
        := size <= 16u64 ifTrue: (self allocateVectorRegister) ifFalse: nil.

    public method assignRegisterToValue: (value: MIRValue) ::=> MIRPhysicalLocation := {
        (value isFloatingPoint || value isVector)
            ifTrue: (self allocateVectorOfSize: value size alignment: value alignment)
            ifFalse: (self allocateIntegerOfSize: value size alignment: value alignment).
    }.
}.

public final class MIRWinX64CallingConvention superclass: MIRX86_64CallingConvention; definition: {
    public override method printOn: (stream: Stream) ::=> Void := {
        stream string: "win64"
    }.

    public override method allocableIntegerRegisters => Array
        := MIR::X86_64::Win64::AllocableIntegerRegisters.

    public override method allocableVectorRegisters => Array
        := MIR::X86_64::Win64::AllocableVectorRegisters.

    public override method preferredRegisterForCaptureVectorPointer => MIRPhysicalIntegerRegister
        := nil.

    public method isValuePassedDirectly: (value: MIRValue) ::=> Boolean := {
        let valueSize := value size.
        value isFloatingPoint ifTrue: {
            (valueSize = 4sz) || (valueSize = 8sz)
        } ifFalse: {
            (valueSize = 1sz) || (valueSize = 2sz) || (valueSize = 4sz) || (valueSize = 8sz)
        }
    }.

    public override method registerConstraintsOfCall: (instruction: MIRInstruction) with: (allocator: MIRRegisterAllocator) ::=> Void := {
        allocator spillGCRootsForCalling: instruction firstOperand.

        let argumentCount := instruction operands size - 1sz.
        let stackSize := argumentCount * 8sz max: 32sz.
        let stackAlignment := 16sz.

        let hasStackIntegerArgument mutable := false.
        let hasStackFloatArgument mutable := false.

        5sz until: instruction operands size do: {:(Size)operandIndex :: Void |
            let argument := instruction operands at: operandIndex.
            let argumentIndex := operandIndex - 1sz.
            let isPassedDirectly := self isValuePassedDirectly: argument.

            argument isFloatingPoint && isPassedDirectly ifTrue: {
                hasStackFloatArgument := true
            } ifFalse: {
                hasStackIntegerArgument := true
            }
        }.
        allocator addRequiredCalloutSize: stackSize withAlignment: stackAlignment.

        1sz until: instruction operands size do: {:(Size)operandIndex :: Void |
            let argument := instruction operands at: operandIndex.
            let argumentIndex := operandIndex - 1sz.
            let isPassedDirectly := self isValuePassedDirectly: argument.
            let isFloatArgument := argument isFloatingPoint && isPassedDirectly.

            let stackOffset := argumentIndex * 8sz.

            argumentIndex < 4sz ifTrue: {
                let register := isFloatArgument
                    ifTrue: (X86_64::Win64::VectorArgumentRegisters at: argumentIndex)
                    ifFalse: (X86_64::Win64::IntegerArgumentRegisters at: argumentIndex).

                isPassedDirectly ifTrue: {
                    allocator allocateRegister: register forInstruction: instruction operandAt: operandIndex
                } ifFalse: {
                    allocator allocateRegister: register forInstruction: instruction operandPointerAt: operandIndex
                }.
            } ifFalse: {
                argumentIndex = 4sz ifTrue: {
                    instruction scratchRegisterCount: 2sz.
                    hasStackIntegerArgument ifTrue: {
                        allocator allocateIntegerRegisterForInstruction: instruction scratchAt: 0sz
                    }.
                    hasStackFloatArgument ifTrue: {
                        allocator allocateVectorRegisterForInstruction: instruction scratchAt: 1sz
                    }   
                }.

                isFloatArgument ifTrue: {
                    allocator allocateSpecificCallStackPointerOffset: stackOffset asInt64 forInstruction: instruction operandAt: operandIndex scratchRegister: instruction scratchRegisters second
                } ifFalse: {
                    isPassedDirectly ifTrue: {
                        allocator allocateSpecificCallStackPointerOffset: stackOffset asInt64 forInstruction: instruction operandAt: operandIndex scratchRegister: instruction scratchRegisters first
                    } ifFalse: {
                        allocator allocateSpecificCallStackPointerOffset: stackOffset asInt64 forInstruction: instruction operandPointerAt: operandIndex scratchRegister: instruction scratchRegisters first
                    }
                }
            }.
        }.

        allocator allocateRegisterOrRelativeImmediate32ForInstruction: instruction operandAt: 0sz.
        allocator
            allocateCaptureVectorPointerRegisterForInstruction: instruction;
            spillIntegerRegistersExceptFor: X86_64::Win64::CallPreservedRegister;
            spillVectorRegistersExceptFor: X86_64::Win64::CallPreservedVectorRegister;
            touchIntegerRegisters: X86_64::Win64::CallTouchedRegister;
            touchVectorRegisters: X86_64::Win64::CallTouchedVectorRegister
    }.

    public override method integerCallPreservedRegisters => Array
        := X86_64::Win64::CallPreservedRegister.

    public override method vectorCallPreservedRegisters => Array
        := X86_64::Win64::CallPreservedVectorRegister.

    public override method computeArgumentPassingLayoutOf: (function: MIRFunction) ::=> Void := {
        let stackSize mutable := 0u64.

        function arguments doWithIndex: {:(MIRArgumentValue)argument :(Size)index :: Void |
            let isPassedDirectly := self isValuePassedDirectly: argument.

            index < 4sz ifTrue: {
                let register := argument isFloatingPoint && isPassedDirectly
                    ifTrue: (X86_64::Win64::VectorArgumentRegisters at: index)
                    ifFalse: (X86_64::Win64::IntegerArgumentRegisters at: index).
                argument passingRegister: register
            }.

            ## All arguments have a fixed size of 8 in the stack.
            let argumentSize := 8sz.
            let argumentOffset := index * argumentSize.

            argument
                stackSegment: MIRStackFrameSegment::ArgumentPassingZone;
                stackSegmentOffset: stackSize;
                stackValueIsPointer: isPassedDirectly not;
                hasValidStackSegmentOffset: true.
            stackSize := argumentOffset + argumentSize
        }.

        function
            argumentPassingStackAlignment: 16u64;
            argumentPassingStackSize: (stackSize max: 32u64)
    }.

    public override method framePointerAnchorIsAtBottom => Boolean := true.

    public override method asm::allocateExceptionLongjmpRegistersFor: (instruction: MIRInstruction) with: (allocator: MIRRegisterAllocator) ::=> Void := {
        allocator allocateRegister: MIR::X86_64::RCX forInstruction: instruction operandAt: 0sz.
    }.

    public override method asm::generateExceptionLongjmpRegistersFor: (instruction: MIRInstruction) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        codegen textSection
            x86::mov: X86::RAX src: X86::RCX x86::qword;
            x86::mov: X86::RSP src: X86::RCX x86::qword + 16r08 i8 asAsmImmediate;
            x86::mov: X86::RBX src: X86::RCX x86::qword + 16r10 i8 asAsmImmediate;
            x86::mov: X86::RBP src: X86::RCX x86::qword + 16r18 i8 asAsmImmediate;
            x86::mov: X86::RDI src: X86::RCX x86::qword + 16r20 i8 asAsmImmediate;
            x86::mov: X86::RSI src: X86::RCX x86::qword + 16r28 i8 asAsmImmediate;
            x86::mov: X86::R12 src: X86::RCX x86::qword + 16r30 i8 asAsmImmediate;
            x86::mov: X86::R13 src: X86::RCX x86::qword + 16r38 i8 asAsmImmediate;
            x86::mov: X86::R14 src: X86::RCX x86::qword + 16r40 i8 asAsmImmediate;
            x86::mov: X86::R15 src: X86::RCX x86::qword + 16r48 i8 asAsmImmediate;

            x86::movaps:  X86::XMM6 src: X86::RCX x86::oword + 16r50 i8 asAsmImmediate;
            x86::movaps:  X86::XMM7 src: X86::RCX x86::oword + 16r60 i8 asAsmImmediate;
            x86::movaps:  X86::XMM8 src: X86::RCX x86::oword + 16r70 i8 asAsmImmediate;
            x86::movaps:  X86::XMM9 src: X86::RCX x86::oword + 16r80 i8 asAsmImmediate;
            x86::movaps: X86::XMM10 src: X86::RCX x86::oword + 16r90 i8 asAsmImmediate;
            x86::movaps: X86::XMM11 src: X86::RCX x86::oword + 16rA0 i8 asAsmImmediate;
            x86::movaps: X86::XMM12 src: X86::RCX x86::oword + 16rB0 i8 asAsmImmediate;
            x86::movaps: X86::XMM14 src: X86::RCX x86::oword + 16rC0 i8 asAsmImmediate;
            x86::movaps: X86::XMM15 src: X86::RCX x86::oword + 16rD0 i8 asAsmImmediate;

            x86::mov: X86::RSP x86::qword src: X86::RAX;
            x86::mov: X86::EAX src: 1i8 asAsmImmediate;
            x86::ret
    }.

    public override method asm::allocateExceptionSetjmpRegistersFor: (instruction: MIRInstruction) with: (allocator: MIRRegisterAllocator) ::=> Void := {
        allocator allocateRegister: MIR::X86_64::RCX forInstruction: instruction operandAt: 0sz.
    }.

    public override method asm::generateExceptionSetjmpRegistersFor: (instruction: MIRInstruction) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        codegen textSection
            x86::mov: X86::RAX src: X86::RSP x86::qword;
            x86::mov: X86::RCX x86::qword src: X86::RAX;
            x86::mov: X86::RCX x86::qword + 16r08 i8 asAsmImmediate src: X86::RSP;
            x86::mov: X86::RCX x86::qword + 16r10 i8 asAsmImmediate src: X86::RBX;
            x86::mov: X86::RCX x86::qword + 16r18 i8 asAsmImmediate src: X86::RBP;
            x86::mov: X86::RCX x86::qword + 16r20 i8 asAsmImmediate src: X86::RDI;
            x86::mov: X86::RCX x86::qword + 16r28 i8 asAsmImmediate src: X86::RSI;
            x86::mov: X86::RCX x86::qword + 16r30 i8 asAsmImmediate src: X86::R12;
            x86::mov: X86::RCX x86::qword + 16r38 i8 asAsmImmediate src: X86::R13;
            x86::mov: X86::RCX x86::qword + 16r40 i8 asAsmImmediate src: X86::R14;
            x86::mov: X86::RCX x86::qword + 16r48 i8 asAsmImmediate src: X86::R15;

            x86::movaps: X86::RCX x86::oword + 16r50 i8 asAsmImmediate src: X86::XMM6;
            x86::movaps: X86::RCX x86::oword + 16r60 i8 asAsmImmediate src: X86::XMM7;
            x86::movaps: X86::RCX x86::oword + 16r70 i8 asAsmImmediate src: X86::XMM8;
            x86::movaps: X86::RCX x86::oword + 16r80 i8 asAsmImmediate src: X86::XMM9;
            x86::movaps: X86::RCX x86::oword + 16r90 i8 asAsmImmediate src: X86::XMM10;
            x86::movaps: X86::RCX x86::oword + 16rA0 i8 asAsmImmediate src: X86::XMM11;
            x86::movaps: X86::RCX x86::oword + 16rB0 i8 asAsmImmediate src: X86::XMM12;
            x86::movaps: X86::RCX x86::oword + 16rC0 i8 asAsmImmediate src: X86::XMM14;
            x86::movaps: X86::RCX x86::oword + 16rD0 i8 asAsmImmediate src: X86::XMM15;

            x86::xor: X86::RAX with: X86::RAX;
            x86::ret
    }.
}.

public global MIR::X86_64::HotCallingConvention := MIRX86_64HotCallingConvention new.
public global MIR::X86_64::ColdCallingConvention := MIRX86_64ColdCallingConvention new.
public global MIR::X86_64::SysVCallingConvention := MIRSysVX86_64CallingConvention new.
public global MIR::X86_64::Win64CallingConvention := MIRWinX64CallingConvention new.

public final class MIRX86_64CompilationTarget superclass: MIRAsmCompilationTarget; definition: {
    public override method name => Symbol
        := #x86_64.

    public override method getTargetSpecificBlockFor: (operation: MIROperation) ::=> MIROperationTargetSpecific
        := operation x86_64.

    public override method allIntegerRegisters => Array
        := MIR::X86_64::IntegerRegisters.

    public override method allVectorRegisters => Array
        := MIR::X86::VectorRegisters.

    public override method usesVectorRegistersForFloatOperations => Boolean
        := true.

    public override method defaultCallingConvention => MIRCallingConvention
        := asmCompilationTarget isWindows
            ifTrue: MIR::X86_64::Win64CallingConvention
            ifFalse: MIR::X86_64::SysVCallingConvention.

    public override method callingConventionNamed: (conventionName: Symbol) ::=> MIRCallingConvention := {
        conventionName == #coldcc ifTrue: {
            return: MIR::X86_64::ColdCallingConvention
        }.
        conventionName == #hotcc ifTrue: {
            return: MIR::X86_64::HotCallingConvention
        }.

        self defaultCallingConvention
    }.

    public override method emitFunctionPrologueWith: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        asmCompilationTarget isWindows ifFalse: {
            codegen textSection x86::endbr64
        }.

        let stackFrameLayout := codegen stackFrameLayout.
        stackFrameLayout hasRequiredConstruction ifTrue: {
            codegen textSection
                x86::push: X86::RBP;
                cfiPushRegister: X86::RBP.

            stackFrameLayout framePointerAnchorIsAtBottom ifFalse: {
                codegen textSection
                    x86::mov: X86::RBP src: X86::RSP;
                    cfiSaveFramePointer: X86::RBP.
            }.

            codegen function touchedCallPreservedRegisters do: {:(MIRPhysicalLocation)each :: Void |
                let reg := (each x86::int64For: codegen) downCastTo: AsmRegister.
                codegen textSection
                    x86::push: reg;
                    cfiPushRegister: reg.
            }.
        }.
    }.

    public override method emitStackFrameConstructionWith: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        let stackFrameLayout := codegen stackFrameLayout.
        stackFrameLayout hasRequiredConstruction ifTrue: {
            codegen stackMap frameBase: (AsmStackMapLocationRegister for: X86::RBP)
        }.

        let frameSize := stackFrameLayout frameAllocationSize.
        frameSize > 0u64 ifTrue: {
            codegen textSection
                x86::sub: X86::RSP with: frameSize asInt32 asAsmImmediate;
                cfiStackSizeAdvance: frameSize asInt64
        }.

        let vectorPreservedRegistersSegmentOffset := stackFrameLayout callVectorPreservedZone offset asInt32.
        codegen function touchedCallPreservedVectorRegisters doWithIndex: {:(MIRPhysicalLocation)each :(Size)i :: Void |
            let reg := (each x86::vector128For: codegen) downCastTo: AsmRegister.
            let offset := (i*16sz) asInt32 + vectorPreservedRegistersSegmentOffset.
            codegen textSection
                x86::movaps: X86::RSP x86::oword + offset asAsmImmediate src: reg
        }.

        stackFrameLayout hasRequiredConstruction ifTrue: {
            stackFrameLayout framePointerAnchorIsAtBottom ifTrue: {
                stackFrameLayout frameOrStackPointerAnchorOffset > 0u64 ifTrue: {
                    codegen textSection
                        x86::lea: X86::RBP src: X86::RSP x86::qword + stackFrameLayout frameOrStackPointerAnchorOffset asAsmImmediate;
                        cfiSaveFramePointer: X86::RBP offset: stackFrameLayout frameOrStackPointerAnchorOffset asInt64.
                } ifFalse: {
                    codegen textSection
                        x86::mov: X86::RBP src: X86::RSP;
                        cfiSaveFramePointer: X86::RBP.
                }.
            }.
        }.

        codegen textSection cfiEndPrologue.
        
        codegen
            emitStackFrameClear;
            emitSpillRegisterArgumentsInStackFrame;
            emitGCStackFrameRecordLink;
            emitUnspillEntryValuesFromStackFrame
    }.

    public override method emitStackFrameClearWith: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        let stackFrameLayout := codegen stackFrameLayout.
        stackFrameLayout hasRequiredConstruction || stackFrameLayout hasGCDataThatShouldBeInitialized ifFalse: {
            return: void
        }.

        codegen function isNoGC ifTrue: {
            return: void
        }.

        let clearRegister mutable => AsmInstructionOperand := nil.
        let validClearRegister := {:: AsmInstructionOperand |
            clearRegister ifNil: {
                codegen textSection x86::xor: X86::RAX with: X86::RAX.
                clearRegister := X86::RAX
            }
        }.

        let clearSegment := {:(MIRStackFrameSegment)segment :: Void |
            let pointerCount := segment alignedSize asUInt32 / 8u32.
            let framePointerBaseOffset := (segment offset - stackFrameLayout frameOrStackPointerAnchorOffset) asInt32.

            let i mutable := 0u32,
            while: (i < pointerCount) do: {
                let pointerOffset := (pointerCount - i - 1u32) asInt32 * 8i32.
                codegen textSection x86::mov: X86::RBP x86::qword + (framePointerBaseOffset + pointerOffset) asAsmImmediate src: validClearRegister().
            } continueWith: (i := i + 1u32).
        }.

        clearSegment(stackFrameLayout gcObjectAllocationZone).
        clearSegment(stackFrameLayout temporaryGCZone).
        clearSegment(stackFrameLayout temporaryGCFatPointerZone).
    }.

    public override method emitGCStackFrameRecordLinkWith: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        codegen function isNoGC ifTrue: {
            return: void
        }.

        let stackFrameLayout := codegen stackFrameLayout.
        stackFrameLayout hasRequiredConstruction && stackFrameLayout frameMetadata isNotEmpty ifFalse: {
            return: void
        }.

        let gcStackFrameRecordLastActiveSymbol := codegen moduleGenerator gcStackFrameRecordLastActiveSymbol.
        gcStackFrameRecordLastActiveSymbol ifNil: {
            return: void
        }.

        ## Metadata address.
        let metadataOffset := stackFrameLayout frameMetadata offsetFromFrameOrStackPointer asInt32.

        ## Store a pointer onto the frame descriptor.
        codegen textSection
            x86::lea: X86::RAX src: (codegen symbolForGCStackFrameDescriptorFor: stackFrameLayout) x86::qwordPtr;
            x86::mov: X86::RBP x86::qword + (metadataOffset + 8i32) asAsmImmediate src: X86::RAX.

        asmCompilationTarget isWindows ifTrue: {
            error("TODO: tls")
        } ifFalse: {
            let lastActiveSymbolPointer := AsmX86RegisterAddress size: 8u8
                displacement: (gcStackFrameRecordLastActiveSymbol dword makeTPOff; yourself)
                segment: X86::FS.

            codegen textSection
                x86::mov: X86::RAX src: lastActiveSymbolPointer;
                x86::mov: X86::RBP x86::qword + metadataOffset asAsmImmediate src: X86::RAX;
                x86::lea: X86::RAX src: X86::RBP x86::qword + metadataOffset asAsmImmediate;
                x86::mov: lastActiveSymbolPointer src: X86::RAX.
        }.
    }.

    public override method emitGCStackFrameRecordUnlinkWith: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        codegen function isNoGC ifTrue: {
            return: void
        }.
        
        let stackFrameLayout := codegen stackFrameLayout.
        stackFrameLayout hasRequiredConstruction && stackFrameLayout frameMetadata isNotEmpty ifFalse: {
            return: void
        }.

        let gcStackFrameRecordLastActiveSymbol := codegen moduleGenerator gcStackFrameRecordLastActiveSymbol.
        gcStackFrameRecordLastActiveSymbol ifNil: {
            return: void
        }.

        ## Metadata address.
        let metadataOffset := stackFrameLayout frameMetadata offsetFromFrameOrStackPointer asInt32.

        asmCompilationTarget isWindows ifTrue: {
            error("TODO: tls")
        } ifFalse: {
            let lastActiveSymbolPointer := AsmX86RegisterAddress size: 8u8
                displacement: (gcStackFrameRecordLastActiveSymbol dword makeTPOff; yourself)
                segment: X86::FS.
            codegen textSection
                x86::mov: X86::R11 src: X86::RBP x86::qword + metadataOffset asAsmImmediate;
                x86::mov: lastActiveSymbolPointer src: X86::R11.
        }
    }.

    public override method emitFunctionEpilogueWith: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        let stackFrameLayout := codegen stackFrameLayout.
        stackFrameLayout hasRequiredConstruction ifTrue: {
            codegen emitGCStackFrameRecordUnlink.
            
            let vectorPreservedRegistersSegmentOffset := stackFrameLayout callVectorPreservedZone offset asInt32.
            codegen function touchedCallPreservedVectorRegisters doWithIndex: {:(MIRPhysicalLocation)each :(Size)i :: Void |
                let reg := (each x86::vector128For: codegen) downCastTo: AsmRegister.
                let offset := (i*16sz) asInt32 + vectorPreservedRegistersSegmentOffset.
                codegen textSection
                    x86::movaps: reg src: X86::RSP x86::oword + offset asAsmImmediate
            }.

            let preservedRegisters := codegen function touchedCallPreservedRegisters.
            stackFrameLayout framePointerAnchorIsAtBottom ifTrue: {
                let restoreSize := stackFrameLayout callPreservedZone offset - stackFrameLayout frameOrStackPointerAnchorOffset.
                codegen textSection
                    cfiBeginEpilogue;
                        x86::lea: X86::RSP src: X86::RBP x86::qword + restoreSize asAsmImmediate;
                        cfiRestoreFramePointer: X86::RBP offset: restoreSize asInt64.
                    preservedRegisters reverseDo: {:(MIRPhysicalLocation)each :: Void |
                        let reg := (each x86::int64For: codegen) downCastTo: AsmRegister.
                        codegen textSection
                            x86::pop: reg;
                            cfiPopRegister: reg.
                    }.

                    codegen textSection
                        x86::pop: X86::RBP;
                        cfiPopRegister: X86::RBP.
            } ifFalse: {
                preservedRegisters isEmpty ifTrue: {
                    codegen textSection
                        cfiBeginEpilogue;
                        x86::mov: X86::RSP src: X86::RBP;
                        cfiRestoreFramePointer: X86::RBP offset: 0i64;
                        x86::pop: X86::RBP;
                        cfiPopRegister: X86::RBP.
                } ifFalse: {
                    codegen textSection
                        cfiBeginEpilogue;
                        x86::lea: X86::RSP src: X86::RBP x86::qword + (preservedRegisters size asInt64 * -8i64) asAsmImmediate;
                        cfiRestoreFramePointer: X86::RBP offset: preservedRegisters size asInt64.
                    preservedRegisters reverseDo: {:(MIRPhysicalLocation)each :: Void |
                        let reg := (each x86::int64For: codegen) downCastTo: AsmRegister.
                        codegen textSection
                            x86::pop: reg;
                            cfiPopRegister: reg.
                    }.

                    codegen textSection
                        x86::pop: X86::RBP;
                        cfiPopRegister: X86::RBP.
                }
            }
        }.
    }.

    public override method emitMoveValue: (value: MIRValue) intoLocation: (register: MIRPhysicalLocation) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        value x86_64::moveIntoRegister: register with: codegen
    }.

    public override method emitMoveValue: (value: MIRValue) intoSpecificMemoryLocation: (memoryLocation: MIRSpecificPhysicalMemoryLocation) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        value x86_64::moveIntoSpecificMemoryLocation: memoryLocation with: codegen
    }.

    public override method emitUnspillValue: (value: MIRValue) intoLocation: (register: MIRPhysicalLocation) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        value x86_64::unspillIntoRegister: register with: codegen
    }.

    public override method emitMoveValuePointer: (value: MIRValue) intoLocation: (register: MIRPhysicalLocation) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        value x86_64::movePointerIntoRegister: register with: codegen
    }.

    public override method emitMoveRegister: (register: MIRPhysicalLocation) intoValue: (value: MIRValue) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        value x86_64::moveFromRegister: register with: codegen
    }.

    public override method emitMoveRegister: (register: MIRPhysicalLocation) intoValueStackPointer: (value: MIRValue) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        value x86_64::moveStackPointerFromRegister: register with: codegen
    }.

    public override method emitLoadCaptureVectorPointerFromClosure: (closurePointer: MIRPhysicalLocation) intoRegister: (register: MIRPhysicalLocation) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        let closurePointerRegister := (closurePointer x86::int64For: codegen) downCastTo: AsmX86IntRegister.
        let reg := (register x86::int64For: codegen) downCastTo: AsmX86IntRegister.
        codegen textSection x86::mov: reg src: closurePointerRegister x86::qword + codegen closureCaptureVectorMemberOffset asInt32 asAsmImmediate
    }.

    public override method emitLoadThreadLocalSegmentPointerRegisters: (tlsPointerValue: MIRThreadLocalSegmentPointerValue) with: (codegen: MIRFunctionAsmCodeGenerator) ::=> Void := {
        asmCompilationTarget isWindows ifTrue: {
            let indexRegister := (tlsPointerValue segmentIndexRegister x86::int32For: codegen) downCastTo: AsmX86IntRegister.
            let pointerVectorRegister := (tlsPointerValue segmentPointerVectorRegister x86::int64For: codegen) downCastTo: AsmX86IntRegister.
            let loadRegister := (tlsPointerValue loadRegister x86::int64For: codegen) downCastTo: AsmX86IntRegister.

            codegen textSection
                x86::mov: indexRegister src: codegen moduleGenerator tlsIndexSymbol x86::qwordPtr;
                x86::mov: pointerVectorRegister src: (AsmX86RegisterAddress size: 8u8 displacement: 88i8 asAsmImmediate segment: X86::GS);
                x86::mov: loadRegister src: pointerVectorRegister x86::qword + (indexRegister * 8u8)

        } ifFalse: {
            self error: "TODO: load the tls pointer register in linux"
        }

    }.
}.

