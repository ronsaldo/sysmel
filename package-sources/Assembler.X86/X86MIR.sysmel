}.

public global X86_64::HotCC::CallPreservedVectorRegister := #().
public global X86_64::HotCC::CallPreservedRegister => Array := (
    MIR::X86_64::RAX, MIR::X86_64::RCX, MIR::X86_64::RDX, MIR::X86_64::RBX,
    MIR::X86_64::RSP, MIR::X86_64::RBP, MIR::X86_64::RSI, MIR::X86_64::RDI,
    MIR::X86_64::R8, MIR::X86_64::R9, MIR::X86_64::R10, MIR::X86_64::R11,
    MIR::X86_64::R12, MIR::X86_64::R13, MIR::X86_64::R14, MIR::X86_64::R15
).

public global X86_64::HotCC::CallTouchedVectorRegister := #().
public global X86_64::HotCC::CallTouchedRegister => Array := #().

public final class MIRX86_64HotCallingConvention superclass: MIRX86_64CallingConvention; definition: {
    public override method printOn: (stream: Stream) ::=> Void := {
        stream string: "hotcc"
    }.

    public override method allocableIntegerRegisters => Array
        := MIR::X86_64::SysV::AllocableIntegerRegisters.

    public override method allocableVectorRegisters => Array
        := MIR::X86_64::SysV::AllocableVectorRegisters.

    public override method preferredRegisterForCaptureVectorPointer => MIRPhysicalIntegerRegister
        := nil.

    public override method preferredRegisterForGotPointer => MIRPhysicalIntegerRegister
        := MIR::X86_64::R15.

    public override method registerConstraintsOfCall: (instruction: MIRInstruction) with: (allocator: MIRRegisterAllocator) ::=> Void := {
        self assert: instruction operands size <= 3sz.

        instruction operands size >= 2sz ifTrue: {
            allocator allocateRegister: MIR::X86_64::RAX forInstruction: instruction operandAt: 1sz.
            instruction operands size >= 3sz ifTrue: {
                allocator allocateRegister: MIR::X86_64::RDX forInstruction: instruction operandAt: 2sz
            }.
        }.

        allocator
            addRequiredCalloutSize: 0sz withAlignment: 16sz;
            allocateRegisterOrRelativeImmediate32ForInstruction: instruction operandAt: 0sz;
            allocateCaptureVectorPointerRegisterForInstruction: instruction;
            spillIntegerRegistersExceptFor: X86_64::HotCC::CallPreservedRegister;
            spillVectorRegistersExceptFor: X86_64::HotCC::CallPreservedVectorRegister;
            touchIntegerRegisters: X86_64::HotCC::CallTouchedRegister;
            touchVectorRegisters: X86_64::HotCC::CallTouchedVectorRegister
    }.

    public override method integerCallPreservedRegisters => Array
        := X86_64::HotCC::CallPreservedRegister.

    public override method vectorCallPreservedRegisters => Array
        := X86_64::HotCC::CallPreservedVectorRegister.

    public override method computeArgumentPassingLayoutOf: (function: MIRFunction) ::=> Void := {
        self assert: function arguments size <= 2sz.

        function arguments size >= 1sz ifTrue: {
            function arguments first passingRegister: MIR::X86_64::RAX.
            function arguments size >= 2sz ifTrue: {
                function arguments second passingRegister: MIR::X86_64::RDX.
            }.
        }.
    }.
}.

