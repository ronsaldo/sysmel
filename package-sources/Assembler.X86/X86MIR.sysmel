        self assert: register isVectorRegister.

        self ~~ register ifTrue: {
            let first := self register.
            let second := register x86::vector128For: codegen.
            codegen textSection
                x86::xorps: first with: second;
                x86::xorps: second with: first;
                x86::xorps: first with: second
