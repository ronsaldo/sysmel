    public override method convertIntoX86_64RelaObjectWithSymbolTable: (symbolTable: Elf64::SymbolTable) ::=> Elf64::RelaObject
        := Elf64::RelaObject new
            offset: offset asUInt64;
            symbol: (symbolTable indexOfSymbol: symbol) type: Elf::X86_64::Rel::GOTPCREL;
            addend: addend asInt64 + symbol privateAddend;
            yourself.

    public override method x86_64::convertMachORelocation64: (machoRelocation: MachO::RelocationInfo) inSection: (section: AsmObjectCodeSection)  ::=> Boolean := {
        section data int32At: offset put: (section data int32At: offset) + 4i32.
        machoRelocation
            isPCRelative: true;
