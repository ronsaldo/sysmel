public class Announcer.

public class AnnouncementSubscription definition: {
    public field announcementClass => Type.
    public field announcer => Announcer.
    public field valuable.

    public method deliver: (announcement: Announcement) ::=> Void := {
        valuable cull: announcement cull: announcer
    }.

    public method handlesAnnouncement: (announcement: Announcement) ::=> Boolean
        := announcement class isSubtypeOf: announcementClass.
}.
