public abstract class ImageReadWriter definition: {
    protected field stream => Stream.

    __Meta__ definition: {
        public method formFromStream: (stream: Stream) ::=> Form
            := (self on: stream) nextImage.

        public method formFromFileNamed: (filename: String) ::=> Form
            := filename asFileReference binaryReadStreamDo: {:(Stream)readStream |
                self formFromStream: readStream
            }.

        public method on: (stream: Stream) ::=> self
            := self new on: stream; yourself
    }.

    public virtual method on: (aStream: Stream) ::=> Void := {
        stream := aStream
    }.

    public abstract method nextImage => Form
        := self subclassResponsibility.
}.
