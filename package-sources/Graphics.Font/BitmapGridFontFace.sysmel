public class BitmapGridFontFace superclass: FontFace; definition: {
    public field name => String.
    public field author => String.
    public field sourceUri => String.
    public field license => String.

    public field form => Form.
    public field columns => UInt32.
    public field rows => UInt32.

    public field width => Float32.
    public field height => Float32.

    public field ascent => Float32.
    public field descent => Float32.

    public field characterRangeFirst => Char32.
    public field characterRangeEnd => Char32.
}.

FontFace definition: {
    let DefaultPixelFont := BitmapGridFontFace new
        name: "PixelFontLatin1";
        author: "ElDuderino";
        sourceUri: "https://opengameart.org/content/pixel-font-basic-latin-latin-1-box-drawing";
        license: "CC0";

        form: (BMPReadWriter formFromFileNamed: (__SourceDirectory__ FileSystem::joinPath: "pixel-font-latin1.bmp"));
        columns: 16u32;
        rows: 12u32;

        width: 7f32;
        height: 9f32;

        ascent: 7f32;
        descent: 2f32;

        characterRangeFirst: ' ';
        characterRangeEnd: 255c32;
        yourself.

    __Meta__ definition: {
        public method default => FontFace
            := DefaultPixelFont.

        public method defaultPixelFont => BitmapGridFontFace
            := DefaultPixelFont.
    }.
}.
