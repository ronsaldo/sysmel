public class FormSGClipNode superclass: FormSGNode; definition: {
    public field child => FormSGNode.
    public field rectangle => RectangleF32.

    public override method accept: (visitor: FormSGVisitor)
        := visitor visitClipNode: self.
}.

FormSGBuilder definition: {
    public method clip: (child: FormSGNode) withRectangle: (rectangle: RectangleF32) ::=> FormSGClipNode
        := FormSGClipNode new
            child: child;
            rectangle: rectangle;
            yourself.
}.

FormSGVisitor definition: {
    public abstract method visitClipNode: (node: FormSGClipNode)
        := self subclassResponsibility.
}.
