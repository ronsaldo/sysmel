public class FormSGFormRenderer superclass: FormSGVisitor; definition: {
    public field canvas => FormCanvas.

    public method renderSceneGraph: (sceneGraph: FormSGNode) onForm: (targetForm: Form) ::=> Void := {
        self renderSceneGraph: sceneGraph onCanvas: (FormCanvas for: targetForm)
    }.

    public method renderSceneGraph: (sceneGraph: FormSGNode) onCanvas: (targetCanvas: FormCanvas) ::=> Void := {
        canvas := targetCanvas.
        self visitNode: sceneGraph.
    }.

    public override method visitNullNode: (node: FormSGNullNode) := void.

    public override method visitBorderNode: (node: FormSGBorderNode) := {
        canvas borderRectangle: node rectangle withColor: node color
            leftWidth: node leftWidth rightWidth: node rightWidth
            bottomWidth: node bottomWidth topWidth: node topWidth.
        void
    }.

    public override method visitColorNode: (node: FormSGColorRectangleNode) := {
        canvas rectangle: node rectangle fillWithColor: node color.
        void
    }.

    public override method visitContainerNode: (node: FormSGContainerNode) := {
        node children do: {:(FormSGNode)eachChild :: Void |
            self visitNode: eachChild
        }.
        void
    }.

    public override method visitLinearGradientNode: (node: FormSGLinearGradientNode) := {
        canvas rectangle: node rectangle linearGradientStart: node startPoint color: node startColor
            end: node endPoint color: node endColor.
        void
    }.

    public override method visitTextNode: (node: FormSGTextNode) := {
        node fontFace ifNil: {return: void}.

        canvas string: node string from: node startIndex until: node endIndex
            in: node rectangle fontFace: node fontFace color: node color
            kern: node kern
            underline: node underline underlineColor: node underlineColor
            strikethrough: node strikethrough strikethroughColor: node strikethroughColor.
        void
    }.

    public override method visitTextureNode: (node: FormSGTextureNode) := {
        canvas texturedRectangle: node rectangle form: node form sourceRectangle: node sourceRectangle color: node color opaque: node isFullyOpaque repeated: node isRepeated.
        void
    }.

    public override method visitTranslationNode: (node: FormSGTranslationNode) := {
        canvas translateBy: node translation during: {:: Void | 
            self visitNode: node child
        }.
        void
    }.
}.
