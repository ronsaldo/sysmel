public final class FormSGBorderNode superclass: FormSGRectangleNode; definition: {
    public field color => Color.
    public field leftWidth => Float32.
    public field rightWidth => Float32.
    public field bottomWidth => Float32.
    public field topWidth => Float32.

    public override method accept: (visitor: FormSGVisitor)
        := visitor visitBorderNode: self.
}.

FormSGBuilder definition: {
    public method borderRectangle: (rectangle: RectangleF32) color: (color: Color)
        width: (width: Float32) ::=> FormSGBorderNode
        := FormSGBorderNode new
            rectangle: rectangle;
            color: color;
            leftWidth: width;
            rightWidth: width;
            bottomWidth: width;
            topWidth: width;
            yourself.

    public method borderRectangle: (rectangle: RectangleF32) color: (color: Color)
        leftWidth: (leftWidth: Float32) rightWidth: (rightWidth: Float32)
        bottomWidth: (bottomWidth: Float32) topWidth: (topWidth: Float32) ::=> FormSGBorderNode
        := FormSGBorderNode new
            rectangle: rectangle;
            color: color;
            leftWidth: leftWidth;
            rightWidth: rightWidth;
            bottomWidth: bottomWidth;
            topWidth: topWidth;
            yourself.
}.

FormSGVisitor definition: {
    public virtual method visitBorderNode: (node: FormSGBorderNode)
        := self visitRectangleNode: node.
}.
