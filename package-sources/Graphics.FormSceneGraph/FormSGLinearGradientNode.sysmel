        := visitor visitLinearGradientNode: self.
}.

FormSGBuilder definition: {
    public method rectangle: (rectangle: RectangleF32) linearGradientStart: (startPoint: Float32x2) color: (startColor: Color)
        end: (endPoint: Float32x2) color: (endColor: Color) ::=> FormSGLinearGradientNode
