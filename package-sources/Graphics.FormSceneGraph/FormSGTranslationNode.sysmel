public final class FormSGTranslationNode superclass: FormSGChildAttributeNode; definition: {
    public field translation => Float32x2.

    public override method accept: (visitor: FormSGVisitor)
        := visitor visitTranslationNode: self.
}.

FormSGBuilder definition: {
    public method translate: (child: FormSGNode) with: (translation: Float32x2) ::=> FormSGTranslationNode
        := FormSGTranslationNode new
            child: child;
            translation: translation;
            yourself.
}.

FormSGVisitor definition: {
    public virtual method visitTranslationNode: (node: FormSGTranslationNode)
        := self visitChildAttributeNode: node.
}.
