public final class FormSGOpacityNode superclass: FormSGChildAttributeNode; definition: {
    public field opacityFactor => Float32.

    public override method accept: (visitor: FormSGVisitor)
        := visitor visitOpacityNode: self.
}.

FormSGBuilder definition: {
    public method node: (child: FormSGNode) withOpacityFactor: (opacityFactor: Float32) ::=> FormSGOpacityNode
        := FormSGOpacityNode new
            child: child;
            opacityFactor: opacityFactor;
            yourself.
}.

FormSGVisitor definition: {
    public virtual method visitOpacityNode: (node: FormSGOpacityNode)
        := self visitChildAttributeNode: node.
}.
