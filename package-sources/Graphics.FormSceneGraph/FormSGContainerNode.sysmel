public final class FormSGContainerNode superclass: FormSGNode; definition: {
    public field children => SequenceableCollection.

    public override method accept: (visitor: FormSGVisitor)
        := visitor visitContainerNode: self.
}.

FormSGNode definition: {
    public virtual method -- (other: FormSGNode) ::=> FormSGNode := {
        other isNullNode ifTrue: {return: self}.
        self isNullNode ifTrue: {return: other}.

        FormSGContainerNode new
            children: (Array with: self with: other);
            yourself
    }.
}.

FormSGContainerNode definition: {
    public override method -- (other: FormSGNode) ::=> FormSGNode := {
        other isNullNode ifTrue: {return: self}.

        FormSGContainerNode new
            children: children -- (Array with: other);
            yourself
    }.
}.

FormSGBuilder definition: {
    public method containerWith: (nodes: SequenceableCollection) ::=> FormSGContainerNode
        := FormSGContainerNode new
            children: nodes;
            yourself.
}.

FormSGVisitor definition: {
    public abstract method visitContainerNode: (node: FormSGContainerNode)
        := self subclassResponsibility.
}.
