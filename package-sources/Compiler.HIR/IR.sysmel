}.

public final class HIRSendInstruction superclass: HIRInstruction; definition: {
    public field receiver => HIRValue.
    public field receiverLookupType => HIRValue.
    public field selector => HIRValue.
    public field arguments => Array.
    public field isUnchecked => Boolean.
    public field boundMethodOwner => Type.
    public field boundSelector => Symbol.
    public field boundMethodType => Type.
    public field boundMethod.
    public field boundMethodShouldBeCalledDirectly => Boolean.

    public override method isSendInstruction => Boolean := true.

    public method applicationBoxDescriptor => UIntPointer := {
        let descriptor mutable := 0uptr.
        
        type isValueType && type isVoidType not ifTrue: {
            descriptor := 1uptr.
        }.

        receiver type isValueType ifTrue: {
            descriptor := descriptor | 2uptr
        }.

        arguments doWithIndex: {:(HIRValue)eachArgument :(Size)argumentIndex :: Void |
            eachArgument type isValueType ifTrue: {
                descriptor := descriptor | (1uptr << (argumentIndex asUIntPointer + 2uptr))
            }
        }.

        descriptor
    }.

    public method fetchSelector => Void := {
        boundSelector ifNil: {
            selector isLiteralConstant ifTrue: {
                boundSelector := selector evaluateConstant
            }
        }.
    }.

    public method fetchBoundReceiverLookupType => Type := {
        receiverLookupType ifNotNil: {
            receiverLookupType isLiteralConstant ifTrue: {
                receiverLookupType evaluateAsConstantType
            } ifFalse: {
                receiverLookupType type asCanonicalPendingInstanceType
            }
        } ifNil: {
            receiver type
        }
    }.

    public method fetchBoundMethod => Void := {
        boundSelector ifNil: { return: void }.

        let staticLookupResult := self fetchBoundReceiverLookupType messageSendStaticLookupSelector: boundSelector.
        staticLookupResult ifNil: { return: void }.

        boundMethod := staticLookupResult foundMethod.
        boundMethodOwner := staticLookupResult owner.
        boundMethodType := self boundMethod __type__.
        boundMethodShouldBeCalledDirectly := staticLookupResult shouldOptimizeLookup.
    }.

    public method fetchUncheckedSend => Void := {
        isUnchecked ifTrue: { return: void }.
        boundMethodType ifNil: { return: void }.

        isUnchecked := boundMethodType verifyHIRSendInstruction: self.
    }.

    public method optimizeLookup => Void := {
        self fetchSelector.
        self fetchBoundMethod.
        self fetchUncheckedSend.
    }.

    public method boxingApplicationSignature => Array
        := (Array with: receiver type) -- (arguments collect: {:(HIRValue)arg :: Type | arg type}) -- (Array with: self type).

    public override method evaluateConstantFolding => HIRValue := {
        self optimizeLookup.

        boundMethodShouldBeCalledDirectly ifTrue: {
            let newCall := (HIRCallInstruction forContext: context)
                useSourceInformationOfValue: self;
                calledFunction: (context convertedLiteral: self boundMethod);
                arguments: (Array with: receiver) -- arguments;
                type: type;
                isUnchecked: isUnchecked;
                registerInUsedValues;
                yourself.
            parent addInstruction: newCall after: self.
            return: newCall
        }.

        self
    }.

    public override method fullPrintOn: (stream: Stream) ::=> Void := {
        stream
            print: self; nextPutAll: " := ";
            nextPutAll: "send "; print: self receiver.
        self receiverLookupType ifNotNil: {:(HIRValue)receiverLookupType :: Void |
            stream nextPutAll: " lookupFrom: "; print: self receiverLookupType.
        }.

        stream nextPutAll: ", "; print: self selector.

        self arguments doWithIndex: {:(HIRValue)argument :(Size)index :: Void |
            index = 0sz
                ifTrue: (stream nextPut: ' 'c8)
                ifFalse: (stream nextPutAll: ", ").
            stream print: argument
        }.

        isUnchecked ifTrue: {
            stream nextPutAll: " unchecked"
        }.

        boundMethodShouldBeCalledDirectly ifTrue: {
            stream nextPutAll: " shouldBeCalledDirectly"
        }.
    }.

    public override method postCopy => Void := {
        super postCopy.
        arguments := arguments copy.
    }.

    public override method usedValuesDo: aBlock ::=> Void := {
        aBlock(self receiver).
        if: self receiverLookupType ~~ nil then: aBlock(self receiverLookupType).
        aBlock(self selector).
        self arguments do: aBlock
    }.

    public override method replaceUsedValue: replacedValue with: replacement ::=> Void := {
        if: self receiver = replacedValue then: (self receiver: replacement).
        if: self receiverLookupType = replacedValue then: (self receiverLookupType: replacement).
        if: self selector = replacedValue then: (self selector: replacement).
        self arguments replaceAll: replacedValue with: replacement
    }.

    public override method replaceUsedValuesWith: (replacementDictionary: Dictionary) ::=> Void := {
        replacementDictionary at: self receiver ifPresent: {:(HIRValue)replacement :: Void | self receiver: replacement}.
        replacementDictionary at: self receiverLookupType ifPresent: {:(HIRValue)replacement :: Void | self receiverLookupType: replacement}.
        replacementDictionary at: self selector ifPresent: {:(HIRValue)replacement :: Void | self selector: replacement}.
        self arguments replaceAllWithDictionary: replacementDictionary
    }.
}.

