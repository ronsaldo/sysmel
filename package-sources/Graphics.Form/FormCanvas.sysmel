public class FormCanvas definition: {
    public field form => Form.
    public field clippingBounds => RectangleF32.
    public field formBounds => RectangleI32.

    __Meta__ definition: {
        public method for: (form: Form) ::=> self
            := self new
                initializeWithForm: form;
                yourself.
    }.

    public method initializeWithForm: (theForm: Form) ::=> Void := {
        form := theForm.
        clippingBounds := 0f32x2 extent: theForm extent asFloat32x2.
        formBounds := 0i32x2 extent: theForm extent asInt32x2.
    }.

    let BlitRectanglePixelFunction := (Float32x2, UInt32) => UInt32.

    public inline method blitPixelsInRectangle: (rectangle: RectangleF32) with: (aBlock: BlitRectanglePixelFunction) ::=> Void := {
        let clippedRectangle := clippingBounds intersectionWith: rectangle.
        clippedRectangle isExclusiveEmpty ifTrue: {return: void}.

        let drawBounds := (RectangleI32 min: clippedRectangle min floor asInt32x2 max: clippedRectangle max ceiling asInt32x2) intersectionWith: formBounds.
        drawBounds isExclusiveEmpty ifTrue: {return: void}.

        let destinationPitch := form pitch asIntPointer.
        let destinationRow mutable := form bits __rawContentsBytePointer__ + (drawBounds min y asIntPointer * destinationPitch) + (drawBounds min x asIntPointer *4 iptr).

        let extent := rectangle extent.
        let origin := rectangle min.
        let du := Float32x2 x: 1f32 / extent x.
        let dv := Float32x2 y: 1f32 / extent y.

        let y mutable := drawBounds min y.
        while: (y < drawBounds max y) do: {
            let x mutable := drawBounds min x.
            let destinationPixel mutable := destinationRow reinterpretCastTo: UInt32 pointer.
            while: (x < drawBounds max x) do: {
                let pixelPosition := Int32x2 x: x y: y.
                
                let localPosition := pixelPosition asFloat32x2 - origin + 0.5f32x2.
                let uv := Float32x2 x: (du dot: localPosition) y: (dv dot: localPosition).

                (0f32 <= uv x) && (uv x <= 1f32) &&
                (0f32 <= uv y) && (uv y <= 1f32) ifTrue: {
                    let oldPixel := destinationPixel load.
                    destinationPixel store: aBlock(uv, oldPixel).
                }.

                destinationPixel := destinationPixel + 1iptr.
            } continueWith: (x := x + 1i32).

            destinationRow := destinationRow + destinationPitch
        } continueWith: (y := y + 1i32).
    }.

    public method rectangle: (rectangle: RectangleF32) fillWithColor: (color: Color) ::=> Void := {
        let encodedColor := color bgra.
        self blitPixelsInRectangle: rectangle with: {:(Float32x2)uv :(UInt32)oldColor :: UInt32 |
            encodedColor
        }.
    }.

    public method borderRectangle: (rectangle: RectangleF32) withColor: (color: Color)
        leftWidth: (leftWidth: Float32) rightWidth: (rightWidth: Float32)
        bottomWidth: (bottomWidth: Float32) topWidth: (topWidth: Float32) ::=> Void := {
        let encodedColor := color bgra.
        let extent := rectangle extent.
        let interiorRectangle := RectangleF32 min: (leftWidth @ topWidth) max: extent - (rightWidth @ bottomWidth).

        self blitPixelsInRectangle: rectangle with: {:(Float32x2)uv :(UInt32)oldColor :: UInt32 |
            let position := uv * extent.
            (interiorRectangle includesPoint: position) ifTrue: {
                oldColor
            } ifFalse: {
                encodedColor
            }
        }.
    }.

    public method rectangle: (rectangle: RectangleF32) linearGradientStart: (startPoint: Float32x2) color: (startColor: Color)
        end: (endPoint: Float32x2) color: (endColor: Color) ::=> Void := {

        let extent := rectangle extent.
        let delta := endPoint - startPoint.
        let dlambda := delta / (Float32x2 withAll: delta length2).

        let startLinearColor := startColor asLinearFloat32x4.
        let endLinearColor := endColor asLinearFloat32x4.

        self blitPixelsInRectangle: rectangle with: {:(Float32x2)uv :(UInt32)oldColor :: UInt32 |
            let position := uv * extent.
            let lambda := position - startPoint dot: dlambda.
            let alpha := lambda clampMin: 0f32 max: 1f32.
            let interpolatedColor := ((Float32x4 withAll: 1f32 - alpha)*startLinearColor) + ((Float32x4 withAll: alpha)*endLinearColor).
            interpolatedColor packUnorm4x8
        }.
    }.

    public method texturedRectangle: (rectangle: RectangleF32) form: (form: Form) sourceRectangle: (sourceRectangle: RectangleF32) color: (color: Color) opaque: (isFullyOpaque: Boolean) repeated: (isRepeated: Boolean) ::=> Void := {
        form ifNil: {return: void}.
        form bits ifNil: {return: void}.

        let colorFactor := color asLinearFloat32x4.

        let sourceExtent := form extent asFloat32x2.
        let sourcePixelFormat := form pixelFormat.
        let sourcePitch := form pitch asIntPointer.
        let sourcePixels mutable := form bits __rawContentsBytePointer__.

        let normalizePixelCoordinate := {:(Float32x2)pixelCoordinate :: Float32x2 |
            isRepeated ifTrue: {
                pixelCoordinate - ((pixelCoordinate / sourceExtent) floor * sourceExtent)
            } ifFalse: {
                pixelCoordinate clampMin: 0f32x2 max: sourceExtent - 1f32x2
            }
        }.

        let fetchPixelCoordinate := {:(Float32x2)pixelCoordinate :: Float32x4 |
            let pixelIntegerCoordinate := pixelCoordinate asInt32x2.

            switch: sourcePixelFormat withCases: #{
                PixelFormat::R8_UNorm : {
                    let pixelPointer := sourcePixels + (sourcePitch * pixelIntegerCoordinate y asIntPointer) + pixelIntegerCoordinate x asIntPointer.
                    Float32x4 withAll: pixelPointer load asFloat32 * (1f32/ 255f32)
                }.
                _: Float32x4 zeros
            }.
        }.

        let textureMappingFunction := {:(Float32x2)uv :(UInt32)oldColor :: UInt32 |
            let pixelCoordinate := (Float32x2 x: uv x y: 1f32 - uv y) * sourceExtent - 0.5f32x2.
            let minPixelCoordinate := pixelCoordinate floor.
            let maxPixelCoordinate := pixelCoordinate ceiling.
            let coordinateFraction := pixelCoordinate - minPixelCoordinate.
            let normalizedMinPixelCoordinate := normalizePixelCoordinate(minPixelCoordinate).
            let normalizedMaxPixelCoordinate := normalizePixelCoordinate(maxPixelCoordinate).

            let topLeft := fetchPixelCoordinate(normalizedMinPixelCoordinate).
            let topRight := fetchPixelCoordinate(Float32x2 x: normalizedMaxPixelCoordinate x y: normalizedMinPixelCoordinate y).
            let bottomLeft := fetchPixelCoordinate(Float32x2 x: normalizedMinPixelCoordinate x y: normalizedMaxPixelCoordinate y).
            let bottomRight := fetchPixelCoordinate(normalizedMaxPixelCoordinate).

            let top := topLeft interpolateTo: topRight at: coordinateFraction x.
            let bottom := bottomLeft interpolateTo: bottomRight at: coordinateFraction x.
            let interpolated := top interpolateTo: bottom at: coordinateFraction y.

            (interpolated * colorFactor) packUnorm4x8
        }.

        self blitPixelsInRectangle: rectangle with: textureMappingFunction
    }.
}.
