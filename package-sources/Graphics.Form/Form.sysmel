public final class Form definition: {
    public field width => UInt32.
    public field height => UInt32.
    public field pitch => UInt32.
    public field bits => ByteArray.

    __Meta__ definition: {
        public method extent: (extent: UInt32x2) pitch: (pitch: UInt32) bits: (bits: ByteArray) ::=> self
            := self new
                width: extent x;
                height: extent y;
                pitch: pitch;
                bits: bits;
                yourself.

        public method extent: (extent: UInt32x2) pitch: (pitch: UInt32) ::=> self
            := self extent: extent pitch: pitch bits: (ByteArray new: (extent y * pitch) asSize).

        public method extent: (extent: UInt32x2) ::=> self
            := self extent: extent pitch: extent x * 4u32.

        public method forRenderingWithExtent: (extent: UInt32x2) ::=> self
            := self extent: extent pitch: (extent x * 4u32 alignedTo: 16u32).
    }.

    public inline method extent => UInt32x2
        := UInt32x2 x: width y: height.

    public method dummy => Void
        := void.

    public method getPixelsPointer => UInt32 pointer
        := bits __rawContentsPointer__ reinterpretCastTo: UInt32 pointer.

    public method fillWithColor: (color: Color) ::=> Void := {
        self assert: bits isNotNil.

        let pixelCount := bits size / 4sz.
        let encodedColor := color bgra.
        let destination := self getPixelsPointer.

        let i mutable := 0sz.
        while: i < pixelCount do: {
            destination[i asIntPointer] := encodedColor
        } continueWith: (i := i + 1sz).
    }.
}.

##printLine((UInt32 pointer >> #"[]:") __type__).
printLine(((Form >> #fillWithColor:) definition ensureAnalysis; bytecode) fullPrintString).
