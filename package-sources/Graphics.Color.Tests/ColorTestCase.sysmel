public class ColorTestCase superclass: TestCase; definition: {
    public method testBasicColors => Void := {
        self assert: Color transparent red   equals: 0f32.
        self assert: Color transparent green equals: 0f32.
        self assert: Color transparent blue  equals: 0f32.
        self assert: Color transparent alpha equals: 0f32.

        self assert: Color black red   equals: 0f32.
        self assert: Color black green equals: 0f32.
        self assert: Color black blue  equals: 0f32.
        self assert: Color black alpha equals: 1f32.

        self assert: Color white red   equals: 1f32.
        self assert: Color white green equals: 1f32.
        self assert: Color white blue  equals: 1f32.
        self assert: Color white alpha equals: 1f32.

        self assert: Color red red   equals: 1f32.
        self assert: Color red green equals: 0f32.
        self assert: Color red blue  equals: 0f32.
        self assert: Color red alpha equals: 1f32.

        self assert: Color green red   equals: 0f32.
        self assert: Color green green equals: 1f32.
        self assert: Color green blue  equals: 0f32.
        self assert: Color green alpha equals: 1f32.

        self assert: Color blue red   equals: 0f32.
        self assert: Color blue green equals: 0f32.
        self assert: Color blue blue  equals: 1f32.
        self assert: Color blue alpha equals: 1f32.
    }.
}.
