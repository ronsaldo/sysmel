public class BasicInspectorListElement definition: {
    public field name => String.
    public field valueFunction => (() => Untyped).

    __Meta__ definition: {
        public method name: (name: String) value: (value: Untyped) ::=> self
            := self new name: name; value: value; yourself.

        public method name: (name: String) valueFunction: (valueFunction: () => Untyped) ::=> self
            := self new name: name; valueFunction: valueFunction; yourself.
    }.

    public method value => Untyped
        := valueFunction().

    public method value: (theValue: Untyped) ::=> Void := {
        valueFunction := {:: Untyped | theValue }
    }.

    public method valueDisplayString => String := {
        let value := self value.
        let valueType := RawTuple::type(value).
        String streamContents: {:(StringStream)out :: Void |
            valueType safelyPrintValue: value on: out
        }
    }
}.

public class BasicInspector superclass: BorderedMorph; definition: {
    protected field inspectedValue => Untyped.
    protected field listView => ListViewMorph.
    protected field sourceCodeEditor => SourceCodeEditorMorph.

    public override method initialize => Void := {
        super initialize.

        listView := ListViewMorph new
            addColumn: ((StringTableViewColumn named: "Variable") display: {:listElement :: String | listElement name}; yourself);
            addColumn: ((StringTableViewColumn named: "Value") display: {:listElement :: String | listElement valueDisplayString}; yourself);
            when: TableViewRowActivatedAnnouncement do: {:(TableViewRowActivatedAnnouncement)announcement :: Void |
                self onActivatedListViewElement: announcement rowElement
            };
            yourself.
        sourceCodeEditor := SourceCodeEditorMorph new.

        self
            addMorph: listView;
            addMorph: sourceCodeEditor;
            layout: (MorphVerticalBoxLayout new
                add: listView proportion: 1f32 borderWidth: 2f32;
                add: sourceCodeEditor proportion: 1f32 borderWidth: 2f32;
                yourself
            )
    }.

    public override method defaultColor => Color := Color transparent.

    public override method defaultExtent => Float32x2 := 300f32@300f32.

    public method onActivatedListViewElement: (element: BasicInspectorListElement) ::=> Void := {
        self class new
            on: element value;
            openInWindowSystem
    }.

    public method on: (newInspectedValue: Untyped) ::=> Void := {
        listView removeAll.
        inspectedValue := newInspectedValue.

        let theInspectedValue := newInspectedValue.
        let inspectedValueType := RawTuple::type(theInspectedValue).

        self addInspectorListElementWithName: "self" value: theInspectedValue.
        inspectedValueType fillBasicInspector: self for: theInspectedValue.
    }.

    public method addInspectorListElementWithName: (name: String) value: (value: Untyped) ::=> Void := {
        listView addItem: (BasicInspectorListElement name: name value: value).
    }.

    public method addInspectorListElementWithName: (name: String) valueFunction: (valueFunction: () => Untyped) ::=> Void := {
        listView addItem: (BasicInspectorListElement name: name valueFunction: valueFunction).
    }.
}.

Type definition: {
    public virtual method fillBasicInspector: (basicInspector: BasicInspector) withSlotsFor: (inspectedValue: Untyped) ::=> Void := {
        self allSlotsDo: {:(TypeSlot)eachTypeSlot :: Void |
            let slotName := (eachTypeSlot name ifNil: #"") asString.
            let slotValueFunction := {:: Untyped |
                let accessorFunction := RawTuple::typeSlotAt:.
                accessorFunction(inspectedValue, eachTypeSlot)
            }.

            basicInspector addInspectorListElementWithName: slotName valueFunction: slotValueFunction.
        }
    }.

    public virtual method fillBasicInspector: (basicInspector: BasicInspector) for: (inspectedValue: Untyped) ::=> Void := {
        self fillBasicInspector: basicInspector withSlotsFor: inspectedValue
    }.
}.

Collection definition: {
    __Meta__ definition: {
        public override method fillBasicInspector: (basicInspector: BasicInspector) for: (inspectedValue: Untyped) ::=> Void := {
            super fillBasicInspector: basicInspector for: inspectedValue.
            self fillBasicInspector: basicInspector withCollectionMembersOf: inspectedValue
        }.

        public virtual method fillBasicInspector: (basicInspector: BasicInspector) withCollectionMembersOf: (inspectedValue: Untyped) ::=> Void := {
            let inspectedCollection => Collection := inspectedValue.
            inspectedCollection doWithIndex: {:element :(Size)index :: Void |
                basicInspector addInspectorListElementWithName: index asString value: element.
            }
        }.
    }
}.

Dictionary definition: {
    __Meta__ definition: {
        public override method fillBasicInspector: (basicInspector: BasicInspector) withCollectionMembersOf: (inspectedValue: Untyped) ::=> Void := {
            let inspectedDictionary => Dictionary := inspectedValue.
            inspectedDictionary keysAndValuesDo: {:key :value :: Void |
                basicInspector addInspectorListElementWithName: key printString value: value.
            }
        }.
    }
}.

MethodDictionary definition: {
    __Meta__ definition: {
        public override method fillBasicInspector: (basicInspector: BasicInspector) withCollectionMembersOf: (inspectedValue: Untyped) ::=> Void := {
            let inspectedDictionary => MethodDictionary := inspectedValue.
            inspectedDictionary keysAndValuesDo: {:key :value :: Void |
                basicInspector addInspectorListElementWithName: key printString value: value.
            }
        }.
    }
}.

FunctionBytecode definition: {
    __Meta__ definition: {
        public override method fillBasicInspector: (basicInspector: BasicInspector) for: (inspectedValue: Untyped) ::=> Void := {
            super fillBasicInspector: basicInspector for: inspectedValue.
            self fillBasicInspector: basicInspector withInstructionsOf: inspectedValue
        }.

        public method fillBasicInspector: (basicInspector: BasicInspector) withInstructionsOf: (inspectedValue: Untyped) ::=> Void := {
            let functionBytecode => FunctionBytecode := inspectedValue.
            functionBytecode decodedInstructionsDo: {:(UInt8)opcode :(Array)operands :(Size)pc :(Size)nextPC :: Void |
                let pcString := pc printString padLeft: 4sz with: '0'c8.

                let formattedInstruction := String streamContents: {:(StringStream)stream :: Void |
                    functionBytecode printOpcodeMnemonic: opcode on: stream.
                    let isBranchInstruction := functionBytecode isBranchOpcode: opcode.
                    operands doWithIndex: {:(Int16)each :(Size)operandIndex :: Void |
                        stream nextPut: ' 'c8.
                        if: isBranchInstruction && ((operandIndex + 1sz) = operands size) then: {
                            stream print: each; nextPut: '|'c8; nextPutAll: ((nextPC asSize + each asSize) printString padLeft: 4sz with: '0'c8)
                        } else: {
                            let operandVector := each & FunctionBytecode::OperandVectorName::BitMask.
                            let operandIndex := each >> FunctionBytecode::OperandVectorName::Bits.
                            stream nextPutAll: (FunctionBytecode::OperandVectorNameDictionary at: operandVector); nextPut: '@'c8; print: operandIndex.
                            if: operandVector = FunctionBytecode::OperandVectorName::Literal
                                then: (stream nextPut: ':'c8; print: (functionBytecode literalVector at: operandIndex asSize)).
                        }.
                    }.
                }.

                basicInspector addInspectorListElementWithName: pcString value: formattedInstruction
            }.
        }.
    }
}.

AnyValue definition: {
    public method inspect => Void := {
        BasicInspector new
            on: self;
            openInWindowSystem
    }.
}.
