public class TextEditorModel definition: {
    public field textBuffer => AbstractTextBuffer.
    public field cursors => Array.

    public override method initialize => Void := {
        super initialize.
        textBuffer := SimpleTextBuffer new.
        cursors := Array with: (TextEditorCursor new textBuffer: textBuffer; yourself).
    }.

    public method contents => String
        := textBuffer contents.

    public method contents: (newContents: String) ::=> Void := {
        textBuffer contents: newContents
    }.
    
    public method insertString: (string: String) ::=> Void := {
        cursors do: {:(TextEditorCursor)eachCursor :: Void |
            eachCursor insertString: string
        }
    }.

    public method validSelectionSourceCodesDo: (aBlock: (SourceCode) => Void) ::=> Void := {
        ## TODO: Use the different cursors for this.
        aBlock(SourceCode text: textBuffer contents name: "<cli>" language: #sysmel).
    }.

    public method doIt => Void := {
        self validSelectionSourceCodesDo: {:(SourceCode)sourceCode :: Void |
            sourceCode analyzeAndEvaluate
        }.
    }.

    public method printIt => Void := {
        self validSelectionSourceCodesDo: {:(SourceCode)sourceCode :: Void |
            let value := sourceCode analyzeAndEvaluate.
            self insertString: value printString.
        }.
    }.

    public method inspectIt => Void := {
        self validSelectionSourceCodesDo: {:(SourceCode)sourceCode :: Void |
            let value := sourceCode analyzeAndEvaluate.
            value inspect
        }.
    }.

    public method deleteNext => Void := {
        cursors do: {:(TextEditorCursor)eachCursor :: Void |
            eachCursor deleteNext
        }
    }.

    public method deletePrevious => Void := {
        cursors do: {:(TextEditorCursor)eachCursor :: Void |
            eachCursor deletePrevious
        }
    }.

    public method moveCursorUp => Void := {
        cursors do: {:(TextEditorCursor)eachCursor :: Void |
            eachCursor moveUp.
        }
    }.

    public method moveCursorDown => Void := {
        cursors do: {:(TextEditorCursor)eachCursor :: Void |
            eachCursor moveDown.
        }
    }.

    public method moveCursorLeft => Void := {
        cursors do: {:(TextEditorCursor)eachCursor :: Void |
            eachCursor moveLeft.
        }
    }.

    public method moveCursorRight ::=> Void := {
        cursors do: {:(TextEditorCursor)eachCursor :: Void |
            eachCursor moveRight.
        }
    }.

    public method moveCursorToStartOfLine ::=> Void := {
        cursors do: {:(TextEditorCursor)eachCursor :: Void |
            eachCursor moveToStartOfLine.
        }
    }.

    public method moveCursorToEndOfLine ::=> Void := {
        cursors do: {:(TextEditorCursor)eachCursor :: Void |
            eachCursor moveToEndOfLine.
        }
    }.
}.
