public class TableViewHeaderMorph superclass: Morph.
public class TableViewContentMorph superclass: Morph.
public class TableViewRowMorph superclass: Morph.

public class TableViewMorph superclass: BorderedMorph; definition: {
    protected field dataSource => DataSource.
    protected field columns => OrderedCollection.
    protected field headerMorph => TableViewHeaderMorph.
    protected field contentMorph => TableViewContentMorph.
    protected field minimalRowExtent => Float32x2.
    protected field selectedRows => TableRowSelection.

    public override method initialize => Void := {
        super initialize.
        columns := OrderedCollection new.
        contentMorph := TableViewContentMorph new.
        selectedRows := TableRowSelection new.
        self addMorph: contentMorph.

        self layout: (MorphVerticalBoxLayout new
            add: contentMorph proportion: 1f32 borderWidth: 2f32;
            yourself)
    }.

    public override method defaultColor => Color
        := Color transparent.

    public method withColumnHeaders => Void := {
        headerMorph ifNotNil: {return: void}.

        headerMorph := TableViewHeaderMorph new.
        self addMorph: headerMorph.

        self layout: (MorphVerticalBoxLayout new
            add: headerMorph;
            add: contentMorph proportion: 1f32 borderWidth: 2f32;
            yourself)
    }.

    public method columns => OrderedCollection
        := columns.

    public method rowHeight => Float32
        := minimalRowExtent y max: 1f32.

    public method addColumn: (newColumn: TableViewColumn) ::=> Void := {
        columns add: newColumn.

        let minimalCellExtent := newColumn minimalCellExtent.
        minimalRowExtent := Float32x2 x: minimalRowExtent x + minimalCellExtent x y: (minimalRowExtent y max: minimalCellExtent y)
    }.

    public method dataSource => DataSource
        := dataSource.

    public method dataSource: (newDataSource: DataSource) ::=> Void := {
        dataSource := newDataSource.
        dataSource onUpdate: {:: Void |
            self onDataUpdate
        }.
        self changed.
    }.

    public method isRowSelected: (rowIndex: Size) ::=> Boolean
        := selectedRows isNotNil && (selectedRows includesRowIndex: rowIndex).

    public method onDataUpdate => Void := {
        contentMorph updateContent.
        self changed
    }.

    public method computeNewColumnWidths => Void := {
        columns isEmpty ifTrue: {return: void}.

        let totalProportion mutable := 0f32.
        let fixedWidth mutable := 0f32.
        columns do: {:(TableViewColumn)eachColumn :: Void |
            let columnProportion := eachColumn proportion.
            columnProportion = 0f32 ifTrue: {
                fixedWidth := fixedWidth + eachColumn minimalCellExtent x
            } ifFalse: {
                totalProportion := totalProportion + columnProportion
            }.
        }.

        let availableWidth := self extent x - fixedWidth max: 0f32.
        columns do: {:(TableViewColumn)eachColumn :: Void |
            let columnProportion := eachColumn proportion.
            columnProportion = 0f32 ifTrue: {
                eachColumn width: eachColumn minimalCellExtent x
            } ifFalse: {
                eachColumn width: (availableWidth * columnProportion / totalProportion) floor
            }.
        }
    }.

    public override method updateLayout => Void := {
        self computeNewColumnWidths.
        super updateLayout
    }.

    public method selectedRows => TableRowSelection
        := selectedRows.

    public method selectedRows: (newSelectedRows: TableRowSelection) ::=> Void := {
        selectedRows := newSelectedRows.
        self selectionChanged
    }.

    public method rowClicked: (rowIndex: Size) ::=> Void := {
        (self isRowSelected: rowIndex) ifTrue: {
            self selectedRows: TableRowSelection new
        } ifFalse: {
            self selectedRows: (TableRowSelection with: rowIndex)
        }
    }.

    public method rowActivated: (rowIndex: Size) ::=> Void := {
        self announce: ((TableViewRowActivatedAnnouncement for: self)
            rowIndex: rowIndex;
            yourself)
    }.

    public method selectionChanged => Void := {
        self changed.
        self announce: ((TableViewSelectionChangedAnnouncement for: self)
            selection: selectedRows;
            yourself)
    }.
}.
