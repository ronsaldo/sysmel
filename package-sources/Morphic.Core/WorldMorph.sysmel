public class WorldMorph superclass: Morph; definition: {
    protected field keyboardFocus => Morph.

    public method newKeyboardFocus: (newKeyboardFocus: Morph) ::=> Void := {
        keyboardFocus == newKeyboardFocus ifTrue: {return: void}.
        keyboardFocus ifNotNil: {
            keyboardFocus processLostFocusEvent: LostFocusEvent new
        }.
        
        keyboardFocus := newKeyboardFocus.

        keyboardFocus ifNotNil: {
            keyboardFocus processGotFocusEvent: GotFocusEvent new
        }.
    }.

    public override method processKeyPressedEvent: (event: KeyPressedEvent) ::=> Void := {
        keyboardFocus ifNotNil: {
            keyboardFocus processKeyPressedEvent: event
        } ifNil: {
            super processKeyPressedEvent: event
        }.
    }.

    public override method processKeyReleasedEvent: (event: KeyReleasedEvent) ::=> Void := {
        keyboardFocus ifNotNil: {
            keyboardFocus processKeyReleasedEvent: event
        } ifNil: {
            super processKeyReleasedEvent: event
        }.
    }.

    public override method processTextInputEvent: (event: TextInputEvent) ::=> Void := {
        keyboardFocus ifNotNil: {
            keyboardFocus processTextInputEvent: event
        } ifNil: {
            super processTextInputEvent: event
        }.
    }.

    public override method processTextEditingEvent: (event: TextEditingEvent) ::=> Void := {
        keyboardFocus ifNotNil: {
            keyboardFocus processTextEditingEvent: event
        } ifNil: {
            super processTextEditingEvent: event
        }.
    }.
}.

Morph definition: {
    public virtual method worldMorph => WorldMorph
        := owner ifNotNil: owner worldMorph.
}.

WorldMorph definition: {
    public override method worldMorph => WorldMorph := self.
}.
