public class SourceCodeEditorMorph superclass: AbstractTextAreaMorph; definition: {

    public override method onKeyPressedEvent: (event: KeyPressedEvent) ::=> Void := {
        event modifiers hasCtrl ifTrue: {
            switch: event symbol withCases: #{
                KeySymbol D : {
                    event wasHandled: true.
                    model doIt.
                    return: void.
                }.
                KeySymbol P : {
                    event wasHandled: true.
                    model printIt.
                    self changed.
                    return: void.
                }.
                KeySymbol I : {
                    event wasHandled: true.
                    model inspectIt.
                    return: void.
                }.
                _: {}.
            }.
        }.

        super onKeyPressedEvent: event
    }.
}.
