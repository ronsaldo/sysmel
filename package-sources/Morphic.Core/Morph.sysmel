public class Morph superclass: MorphLayoutElement; definition: {
    protected field bounds => RectangleF32.
    public field owner => Morph.
    public field submorphs => Array.
    public field color => Color.
    public field announcer => Announcer.
    protected field visible => Boolean.
    protected field layout => MorphLayout.

    public override method initialize => Void := {
        super initialize.
        submorphs := #().
        bounds := self defaultBounds.
        color := self defaultColor
    }.

    public method layout => MorphLayout := layout.

    public virtual method colorToUse => Color := color.

    public virtual method defaultColor => Color
        := Color blue.

    public virtual method defaultBounds => RectangleF32
        := 0f32x2 extent: 50f32 @ 40f32.

    public inline method localBounds => RectangleF32
        := 0f32x2 extent: bounds extent.

    public inline method position => Float32x2
        := bounds min.

    public inline override method position: (newPosition: Float32x2) ::=> Void := {
        bounds := newPosition extent: bounds extent.
    }.

    public inline method extent => Float32x2
        := bounds extent.

    public inline method center => Float32x2
        := bounds center.

    public override method bounds ::=> RectangleF32
        := bounds.

    public override method bounds: (newBounds: RectangleF32) ::=> Void := {
        bounds := newBounds.
        self updateLayout
    }.

    public virtual method extent: (newExtent: Float32x2) ::=> Void := {
        bounds := bounds min extent: newExtent.
        self updateLayout
    }.

    public virtual method layout: (newLayout: MorphLayout) ::=> Void := {
        layout := newLayout.
        self updateLayout
    }.

    public virtual method innerLayoutBounds => RectangleF32
        := self localBounds.

    public virtual method updateLayout => Void := {
        layout ifNil: {return: void}.

        layout bounds: self innerLayoutBounds.
    }.

    public virtual method buildFullSceneGraphWith: (builder: FormSGBuilder) ::=> FormSGNode := {
        let localSceneGraph := self buildSceneGraphWith: builder.
        let childrenSceneGraph := self buildChildrenSceneGraphWith: builder.

        builder translate: localSceneGraph -- childrenSceneGraph with: self position
    }.

    public virtual method validSubmorphs => Array
        := submorphs.

    public virtual method buildChildrenSceneGraphWith: (builder: FormSGBuilder) ::=> FormSGNode := {
        self validSubmorphs isEmpty ifTrue: {return: builder null}.

        let nodeSceneGraphList := Array new: self validSubmorphs size.
        self validSubmorphs doWithIndex: {:(Morph)childMorph :(Size)childMorphIndex :: Void |
            nodeSceneGraphList at: childMorphIndex put: (childMorph buildFullSceneGraphWith: builder)
        }.

        builder containerWith: nodeSceneGraphList
    }.

    public virtual method buildSceneGraphWith: (builder: FormSGBuilder) ::=> FormSGNode
        := builder rectangle: self localBounds color: self colorToUse.

    public virtual method addMorph: (morph: Morph) ::=> Void
        := self addMorphFront: morph.

    public method addMorphFront: (morph: Morph) ::=> Void
        := self privateAddMorph: morph atIndex: submorphs size.

    public method addMorphBack: (morph: Morph) ::=> Void
        := self privateAddMorph: morph atIndex: 0sz.

    public method privateAddMorph: (morph: Morph) atIndex: (morphIndex: Size) ::=> Void := {
        self assert: morph owner isNil.
        self assert: morphIndex <= submorphs size.

        let oldSubmorphCount := submorphs size.
        let newSubmorphs := Array new: oldSubmorphCount + 1sz.

        ## Lower half
        {
            let lowerHalfSize := oldSubmorphCount min: morphIndex.
            let i mutable := 0sz.
            while: (i < lowerHalfSize) do: {
                newSubmorphs at: i put: (submorphs at: i)
            } continueWith: (i := i + 1sz).
        }.

        ## The new morph
        newSubmorphs at: morphIndex put: morph.

        ## Upper half.
        {
            let i mutable := morphIndex.
            while: (i < oldSubmorphCount) do: {
                newSubmorphs at: i + 1sz put: (submorphs at: i)
            } continueWith: (i := i + 1sz).
        }.

        morph owner: self.
        submorphs := newSubmorphs
    }.

    public method removeAllMorphs => Void := {
        submorphs do: {:(Morph)each :: Void |
            each owner: nil
        }.

        submorphs := #().
    }.

    public method replaceAllMorphsWith: (newMorphs: Collection) ::=> Void := {
        self removeAllMorphs.

        let newSubmorphs := Array new: newMorphs size.
        newMorphs doWithIndex: {:(Morph)each :(Size)index :: Void |
            each owner: self.
            newSubmorphs at: index put: each.
        }.

        submorphs := newSubmorphs.
    }.

    public method removeMorph: (morph: Morph) ::=> Void := {
        self assert: morph owner == self.
        submorphs := submorphs copyWithout: morph
    }.

    public virtual method delete => Void := {
        owner ifNotNil: (owner removeMorph: self).
    }.

    public virtual method processMouseButtonPressedEvent: (event: MouseButtonPressedEvent) ::=> Void := {
        event withLocalTranslation: self position do: {:: Void |
            self validSubmorphs reverseDo: {:(Morph)each :: Void |
                (each bounds includesPoint: event position) ifTrue: {
                    each processMouseButtonPressedEvent: event
                }
            }.

            (self handlesMouseButtonPressedEvent: event) ifTrue: {
                self onMouseButtonPressedEvent: event
            }
        }.
    }.

    public virtual method handlesMouseButtonPressedEvent: (event: MouseButtonPressedEvent) ::=> Boolean := false.
    public virtual method onMouseButtonPressedEvent: (event: MouseButtonPressedEvent) ::=> Void := {
    }.

    public virtual method processMouseButtonReleasedEvent: (event: MouseButtonReleasedEvent) ::=> Void := {
        event withLocalTranslation: self position do: {:: Void |
            self validSubmorphs reverseDo: {:(Morph)each :: Void |
                (each bounds includesPoint: event position) ifTrue: {
                    each processMouseButtonReleasedEvent: event
                }
            }.

            (self handlesMouseButtonReleasedEvent: event) ifTrue: {
                self onMouseButtonReleasedEvent: event
            }
        }.
    }.

    public virtual method handlesMouseButtonReleasedEvent: (event: MouseButtonReleasedEvent) ::=> Boolean := false.
    public virtual method onMouseButtonReleasedEvent: (event: MouseButtonReleasedEvent) ::=> Void := {
    }.

    public virtual method processMouseMoveEvent: (event: MouseMoveEvent) ::=> Void := {
        event withLocalTranslation: self position do: {:: Void |
            self validSubmorphs reverseDo: {:(Morph)each :: Void |
                (each bounds includesPoint: event position) ifTrue: {
                    each processMouseMoveEvent: event
                }
            }.

            (self handlesMouseMoveEvent: event) ifTrue: {
                self onMouseMoveEvent: event
            }
        }.
    }.

    public virtual method handlesMouseMoveEvent: (event: MouseMoveEvent) ::=> Boolean := false.
    public virtual method onMouseMoveEvent: (event: MouseMoveEvent) ::=> Void := {
    }.

    public virtual method processKeyPressedEvent: (event: KeyPressedEvent) ::=> Void := {
        (self handlesKeyPressedEvent: event) ifTrue: {
            self onKeyPressedEvent: event
        }
    }.

    public virtual method handlesKeyPressedEvent: (event: KeyPressedEvent) ::=> Boolean := false.
    public virtual method onKeyPressedEvent: (event: KeyPressedEvent) ::=> Void := {
    }.

    public virtual method processKeyReleasedEvent: (event: KeyReleasedEvent) ::=> Void := {
        (self handlesKeyReleasedEvent: event) ifTrue: {
            self onKeyReleasedEvent: event
        }
    }.

    public virtual method handlesKeyReleasedEvent: (event: KeyReleasedEvent) ::=> Boolean := false.
    public virtual method onKeyReleasedEvent: (event: KeyReleasedEvent) ::=> Void := {
    }.

    public virtual method processTextInputEvent: (event: TextInputEvent) ::=> Void := {
        (self handlesTextInputEvent: event) ifTrue: {
            self onTextInputEvent: event
        }
    }.

    public virtual method handlesTextInputEvent: (event: TextInputEvent) ::=> Boolean := false.
    public virtual method onTextInputEvent: (event: TextInputEvent) ::=> Void := {
    }.

    public virtual method processTextEditingEvent: (event: TextEditingEvent) ::=> Void := {
        (self handlesTextEditingEvent: event) ifTrue: {
            self onTextEditingEvent: event
        }
    }.

    public virtual method handlesTextEditingEvent: (event: TextEditingEvent) ::=> Boolean := false.
    public virtual method onTextEditingEvent: (event: TextEditingEvent) ::=> Void := {
    }.

    public virtual method processGotFocusEvent: (event: GotFocusEvent) ::=> Void := {
        self onGotFocusEvent: event
    }.

    public virtual method onGotFocusEvent: (event: GotFocusEvent) ::=> Void := {
    }.

    public virtual method processLostFocusEvent: (event: LostFocusEvent) ::=> Void := {
        self onLostFocusEvent: event
    }.
    public virtual method onLostFocusEvent: (event: LostFocusEvent) ::=> Void := {
    }.

    public virtual method enabled => Boolean := true.
    public virtual method enabled: (aBoolean: Boolean) ::=> Void := {
        ## By default do nothing.
    }.

    public virtual method visible => Boolean := visible.
    public virtual method visible: (aBoolean: Boolean) ::=> Void := {
        visible := aBoolean.
        self changed.
    }.

    public virtual method changed => Void := {
        owner ifNotNil: owner changed
    }.

    public virtual method takeKeyboardFocus => Void := {
        self worldMorph ifNotNil: {:(WorldMorph)worldMorph :: Void |
            worldMorph newKeyboardFocus: self
        }.
    }.

    public virtual method takesKeyboardFocus => Boolean
        := false.

    public virtual method wantsKeyboardFocus => Boolean
        := self takesKeyboardFocus && self visible && self enabled.

    public method validAnnouncer => Announcer
        := announcer ifNil: {announcer := Announcer new}.

    public method when: (anAnnouncementClass: Announcement class) do: aValuable ::=> AnnouncementSubscription
        := self validAnnouncer when: anAnnouncementClass do: aValuable.

    public method announce: (anAnnouncement: Announcement) ::=> Void := {
        announcer ifNotNil: {
            announcer announce: anAnnouncement
        }
    }.
}.
