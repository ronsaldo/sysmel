public class FunctionIRInspector superclass: PanelMorph; definition: {
    protected field inspectedFunction => FunctionDefinition.
    protected field bytecodeListView => ListViewMorph.
    protected field hirTreeView => TreeViewMorph.
    protected field mirTreeView => TreeViewMorph.
    protected field assemblyTreeView => TreeViewMorph.
    protected field sourceCodeEditor => SourceCodeEditorMorph.

    public override method initialize => Void := {
        super initialize.

        bytecodeListView := ListViewMorph new
            addColumn: ((StringTableViewColumn named: "PC") proportion: 0.25f32; display: {:listElement :: String | listElement key }; yourself);
            addColumn: ((StringTableViewColumn named: "Instruction") display: {:listElement :: String | listElement value}; yourself);
            yourself.

        hirTreeView := TreeViewMorph new
            addColumn: ((StringTableViewColumn named: "IR") display: {:element :: String | element treeElementPrintString}; yourself);
            children: {:element :: Collection | element treeChildren};
            yourself.
        mirTreeView := TreeViewMorph new
            addColumn: ((StringTableViewColumn named: "IR") display: {:element :: String | element treeElementPrintString}; yourself);
            children: {:element :: Collection | element treeChildren};
            yourself.
        assemblyTreeView := TreeViewMorph new
            addColumn: ((StringTableViewColumn named: "IR") display: {:element :: String | element treeElementPrintString}; yourself);
            children: {:element :: Collection | element treeChildren};
            yourself.

        self
            addMorph: bytecodeListView;
            addMorph: hirTreeView;
            addMorph: mirTreeView;
            addMorph: assemblyTreeView;
            layout: (MorphVerticalBoxLayout new
                add: bytecodeListView proportion: 1f32 borderWidth: 1f32;
                add: hirTreeView proportion: 1f32 borderWidth: 1f32;
                add: mirTreeView proportion: 1f32 borderWidth: 1f32;
                add: assemblyTreeView proportion: 1f32 borderWidth: 1f32;
                yourself
            )
    }.

    public override method defaultExtent => Float32x2 := 640f32@480f32.

    public method on: (newFunctionDefinition: FunctionDefinition) ::=> Void := {
        inspectedFunction := newFunctionDefinition.
        inspectedFunction ensureAnalysis.

        bytecodeListView removeAll.
        hirTreeView roots: #().
        mirTreeView roots: #().
        assemblyTreeView roots: #().

        let bytecode := inspectedFunction bytecode.
        bytecode ifNotNil: {
            bytecode decodedInstructionsDo: {:(UInt8)opcode :(Array)operands :(Size)pc :(Size)nextPC :: Void |
                let pcString := pc printString padLeft: 4sz with: '0'c8.

                let formattedInstruction := String streamContents: {:(StringStream)stream :: Void |
                    bytecode printOpcodeMnemonic: opcode on: stream.
                    let isBranchInstruction := bytecode isBranchOpcode: opcode.
                    operands doWithIndex: {:(Int16)each :(Size)operandIndex :: Void |
                        stream nextPut: ' 'c8.
                        if: isBranchInstruction && ((operandIndex + 1sz) = operands size) then: {
                            stream print: each; nextPut: '|'c8; nextPutAll: ((nextPC asSize + each asSize) printString padLeft: 4sz with: '0'c8)
                        } else: {
                            let operandVector := each & FunctionBytecode::OperandVectorName::BitMask.
                            let operandIndex := each >> FunctionBytecode::OperandVectorName::Bits.
                            stream nextPutAll: (FunctionBytecode::OperandVectorNameDictionary at: operandVector); nextPut: '@'c8; print: operandIndex.
                            if: operandVector = FunctionBytecode::OperandVectorName::Literal
                                then: (stream nextPut: ':'c8; print: (bytecode literalVector at: operandIndex asSize)).
                        }.
                    }.
                }.

                bytecodeListView addItem: pcString -> formattedInstruction
            }.
        }.

        ## HIR.
        let asmCompilationTarget := AsmCompilationTarget x86_64 setForLinux.
        let mirCompilationTarget := asmCompilationTarget asMirCompilationTarget.
        let hirCompilationTarget := mirCompilationTarget asHIRCompilationTarget.

        let hirModule := (HIRModuleCompilationContext forTarget: hirCompilationTarget)
            exclusiveCompilationMode: true;
            compileFunctionDefinition: inspectedFunction;
            finish.

        hirModule performStandardOptimizations.


        ## MIR.
        let mirModule := HIRModuleMIRCodeGenerator new
            initializeWithTarget: mirCompilationTarget;
            importRuntimeFunction: true;
            importTrampolines: true;
            compileHIRModule: hirModule patchingFunctions: #() definitions: (Array with: inspectedFunction);
            finish.
        mirModule performStandardOptimizations.

        let nativeCodeIR := mirModule asTargetNativeCodeIR.

        hirTreeView roots: (Array with: hirModule); expandAll.
        mirTreeView roots: (Array with: mirModule); expandAll.
        assemblyTreeView roots: (Array with: nativeCodeIR); expandAll.
    }.
}.

Function extend: {
    public method inspectIR => Void := {
        definition ifNotNil: definition inspectIR
    }.
}.

FunctionDefinition extend: {
    public method inspectIR => Void := {
        FunctionIRInspector new
            on: self;
            openInWindowSystem
    }.
}