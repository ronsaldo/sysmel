public class AbstractTextAreaMorph superclass: BorderedMorph; definition: {
    protected field model => TextEditorModel.
    public field fontFace => FontFace.
    public field backgroundColor => Color.

    public override method initialize => Void := {
        super initialize.
        model := TextEditorModel new.
        backgroundColor := Color white.
    }.

    public method model => TextEditorModel := model.

    public method model: (newModel: TextEditorModel) ::=> Void := {
        model := newModel.
        self changed.
    }.

    public method contents => String
        := model contents.

    public method contents: (newContents: String) ::=> Void := {
        model contents: newContents
    }.

    public virtual method backgroundColorToUse => Color
        := backgroundColor.

    public override method defaultColor => Color
        := Color black.

    public method fontFaceToUse => FontFace
        := fontFace ifNil: FontFace default.

    public override method takesKeyboardFocus => Boolean := true.

    public override method handlesMouseButtonPressedEvent: (event: MouseButtonPressedEvent) ::=> Boolean
        := event wasHandled not.

    public override method onMouseButtonPressedEvent: (event: MouseButtonPressedEvent) ::=> Void := {
        event wasHandled: true.
        self takeKeyboardFocus.
    }.

    public override method handlesMouseButtonReleasedEvent: (event: MouseButtonPressedEvent) ::=> Boolean
        := event wasHandled not.

    public override method onMouseButtonReleasedEvent: (event: MouseButtonPressedEvent) ::=> Void := {
        event wasHandled: true.
    }.

    public override method handlesKeyPressedEvent: (event: KeyPressedEvent) ::=> Boolean
        := event wasHandled not.

    public override method onKeyPressedEvent: (event: KeyPressedEvent) ::=> Void := {
        printLine("AbstractTextAreaMorph onKeyPressed ", event symbol).
    }.

    public override method handlesKeyReleasedEvent: (event: KeyReleasedEvent) ::=> Boolean
        := event wasHandled not.

    public override method onKeyReleasedEvent: (event: KeyReleasedEvent) ::=> Void := {
        printLine("AbstractTextAreaMorph onKeyReleased ", event symbol).
    }.

    public override method handlesTextInputEvent: (event: TextInputEvent) ::=> Boolean
        := event wasHandled not.

    public override method onTextInputEvent: (event: TextInputEvent) ::=> Void := {
        model insertString: event text.
        event wasHandled: true.
        self changed
    }.

    public override method handlesTextEditingEvent: (event: TextEditingEvent) ::=> Boolean
        := event wasHandled not.

    public override method onTextEditingEvent: (event: TextEditingEvent) ::=> Void := {
        ##printLine("AbstractTextAreaMorph onTextEditing ", event text, " ", event start, " ", event length).
    }.

    public override method buildSceneGraphWith: (builder: FormSGBuilder) ::=> FormSGNode := {
        let nodes := OrderedCollection new.
        nodes add: (builder rectangle: self localBounds color: self backgroundColorToUse).

        let fontFace := self fontFaceToUse.
        let textColor := self colorToUse.

        model textBuffer stringSpansDo: {:(String)string :(Size)startIndex :(Size)endIndex :: Void |
            nodes add: (builder string: string from: startIndex until: endIndex
                in: self localBounds
                fontFace: fontFace color: textColor
            )
        }.

        let cursorExtent := 1f32 @ fontFace height.
        let cursorColor := Color cyan.

        model cursors do: {:(TextEditorCursor)each :: Void |
            let cursorPosition := (each position asFloat32*fontFace width)@0f32.
            nodes add: (builder rectangle: (cursorPosition extent: cursorExtent) color: cursorColor)
        }.

        nodes add: (builder borderRectangle: self localBounds color: self borderColorToUse width: borderWidth).

        builder containerWith: nodes
    }.
}.
