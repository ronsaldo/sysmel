public class StringCellMorph superclass: Morph; definition: {
    public field contents => String.

    public override method hasClippedContent => Boolean
        := true.
        
    public override method buildSceneGraphWith: (builder: FormSGBuilder) ::=> FormSGNode
        := builder string: (contents ifNil: "") in: self localBounds fontFace: FontFace default color: Color black.
}.

public class StringTableViewColumn superclass: TableViewColumn; definition: {
    let DisplayBlockType := (AnyValue) => String.
    
    public field display => DisplayBlockType.

    public override method initialize => Void := {
        super initialize.
        proportion := 1f32.
        display := {:element :: String | element asString }.
    }.
    
    public override method createCellMorphForElement: element model: elementModel ::=> Morph
        := StringCellMorph new contents: display(element); changed; yourself.

    public override method updateCellMorph: (morph: Morph) withElement: element model: elementModel ::=> Void := {
        (morph downCastTo: StringCellMorph) contents: display(element); changed
    }.
}.
