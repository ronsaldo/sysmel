public final class TextEditorCursor definition: {
    public field textBuffer => AbstractTextBuffer.

    public field startLine => Size.
    public field startColumn => Size.
    public field endLine => Size.
    public field endColumn => Size.

    public method startIndex => Size
        := textBuffer computeIndexForLine: startLine andColumn: startColumn.

    public method endIndex => Size
        := textBuffer computeIndexForLine: endLine andColumn: endColumn.

    public method insertString: (string: String) ::=> Void := {
        let startIndex := self startIndex.
        let endIndex := self endIndex.
        self position: (textBuffer replaceFrom: (startIndex min: endIndex) until: (startIndex max: endIndex) withString: string).
    }.

    public method deleteNext ::=> Void := {
        let startIndex := self startIndex.
        let endIndex := self endIndex.

        startIndex = endIndex ifTrue: {
            startIndex < textBuffer size ifTrue: {
                self position: (textBuffer replaceFrom: startIndex until: startIndex + 1sz withString: "")
            }
        } ifFalse: {
            self position: (textBuffer replaceFrom: (startIndex min: endIndex) until: (startIndex max: endIndex) withString: "").
        }.
    }.

    public method deletePrevious ::=> Void := {
        let startIndex := self startIndex.
        let endIndex := self endIndex.

        startIndex = endIndex ifTrue: {
            startIndex > 0sz ifTrue: {
                self position: (textBuffer replaceFrom: startIndex - 1sz until: startIndex withString: "")
            }
        } ifFalse: {
            self position: (textBuffer replaceFrom: (startIndex min: endIndex) until: (startIndex max: endIndex) withString: "").
        }.
    }.

    public method position: (newPosition: Size) ::=> Void := {
        textBuffer forIndex: newPosition computeLine: startLine andColumn: startColumn.
        endLine := startLine.
        endColumn := startColumn.
    }.

    public method expandUp => Void := {
        endLine > 0sz ifTrue: {
            endLine := endLine - 1sz
        }.
    }.

    public method expandDown => Void := {
        endLine + 1sz < textBuffer numberOfLines ifTrue: {
            endLine := endLine + 1sz
        }.
    }.

    public method expandLeft => Void := {
        endColumn := endColumn min: (textBuffer numberOfColumnsInLine: endLine).

        endColumn > 0sz ifTrue: {
            endColumn := endColumn - 1sz
        } ifFalse: {
            endLine > 0sz ifTrue: {
                endLine := endLine - 1sz.
                endColumn := textBuffer numberOfColumnsInLine: endLine
            }.
        }.
    }.

    public method expandRight => Void := {
        let currentLineSize := textBuffer numberOfColumnsInLine: endLine.
        endColumn := endColumn min: currentLineSize.

        endColumn < currentLineSize ifTrue: {
            endColumn := endColumn + 1sz
        } ifFalse: {
            endLine + 1sz < textBuffer numberOfLines ifTrue: {
                endLine := endLine + 1sz.
                endColumn := 0sz
            }.
        }.
    }.

    public method expandToStartOfLine => Void := {
        endColumn := 0sz.
    }.

    public method expandToEndOfLine => Void := {
        endColumn := textBuffer numberOfColumnsInLine: endLine.
    }.

    public method moveUp => Void := {
        self expandUp.

        startLine := endLine.
        startColumn := endColumn.
    }.

    public method moveDown => Void := {
        self expandDown.

        startLine := endLine.
        startColumn := endColumn.
    }.

    public method moveLeft => Void := {
        self expandLeft.

        startLine := endLine.
        startColumn := endColumn.
    }.

    public method moveRight => Void := {
        self expandRight.

        startLine := endLine.
        startColumn := endColumn.
    }.

    public method moveToStartOfLine => Void := {
        self expandToStartOfLine.

        startLine := endLine.
        startColumn := endColumn.
    }.

    public method moveToEndOfLine => Void := {
        self expandToEndOfLine.

        startLine := endLine.
        startColumn := endColumn.
    }.
}.
