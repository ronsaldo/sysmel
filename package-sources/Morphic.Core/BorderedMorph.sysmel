public class BorderedMorph superclass: Morph; definition: {
    public field borderColor => Color.
    public field borderWidth => Float32.

    public override method initialize => Void := {
        super initialize.

        borderColor := self defaultBorderColor.
        borderWidth := self defaultBorderWidth.
    }.

    public virtual method defaultBorderColor => Color
        := Color black.

    public virtual method defaultBorderWidth => Float32
        := 1f32.

    public override method buildSceneGraphWith: (builder: FormSGBuilder) ::=> FormSGNode
        := (super buildSceneGraphWith: builder)
        -- (builder borderRectangle: self localBounds color: borderColor width: borderWidth).
}.
