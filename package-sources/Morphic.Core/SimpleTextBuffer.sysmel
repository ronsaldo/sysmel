public class SimpleTextBuffer superclass: AbstractTextBuffer; definition: {
    public field contents => String.

    public override method initialize => Void := {
        super initialize.
        contents := "".
    }.

    public override method size => Size
        := contents size.

    public override method replaceFrom: (startIndex: Size) until: (endIndex: Size) withString: (replacement: String) ::=> Size := {
        let contentsSize := contents size .
        let lowerSize := startIndex min: contentsSize.
        let replacementSize := replacement size.
        let upperSize := endIndex <= contentsSize ifTrue: contentsSize - endIndex ifFalse: 0sz.

        let newContentSize := lowerSize + replacementSize + upperSize.
        newContentSize > 0sz ifTrue: {
            let newContents := String basicAllocate: newContentSize.
            memcpy(newContents __rawContentsBytePointer__, contents __rawContentsBytePointer__, lowerSize).
            memcpy(newContents __rawContentsBytePointer__ + lowerSize asIntPointer, replacement __rawContentsBytePointer__, replacementSize).
            memcpy(newContents __rawContentsBytePointer__ + (lowerSize + replacementSize) asIntPointer, contents __rawContentsBytePointer__ + endIndex asIntPointer, upperSize).
            contents := newContents
        } ifFalse: {
            contents := ""
        }.

        lowerSize + replacementSize
    }.

    public method computeIndexForLine: (lineIndex: Size) ::=> Size := {
        let currentLineIndex mutable := 0sz.

        let i mutable := 0sz.
        let lastIsCr mutable := false.
        while: i < contents size do: {
            let c := contents char8At: i.
            switch: c withCases: #{
                '\r'c8 : {
                    currentLineIndex >= lineIndex ifTrue: (return: i).

                    currentLineIndex := currentLineIndex + 1sz.
                    lastIsCr := true.
                }.
                '\n'c8 : {
                    lastIsCr ifFalse: {
                        currentLineIndex >= lineIndex ifTrue: (return: i).
                        currentLineIndex := currentLineIndex + 1sz
                    }.
                    lastIsCr := false.
                }.
                _: {
                    currentLineIndex >= lineIndex ifTrue: (return: i).
                    lastIsCr := false.
                }
            }
        } continueWith: (i := i + 1sz).

        i
    }.

    public override method computeIndexForLine: (lineIndex: Size) andColumn: (columnIndex: Size) ::=> Size := {
        let index mutable := self computeIndexForLine: lineIndex.

        let currentColumnIndex mutable := 0sz.
        while: index < contents size do: {
            currentColumnIndex >= columnIndex ifTrue: {
                return: index
            }.

            let c := contents char8At: index.
            switch: c withCases: #{
                '\r'c8 : {
                    return: index.
                }.
                '\n'c8 : {
                    return: index.
                }.
                '\t'c8 : {
                    currentColumnIndex := currentColumnIndex + self tabWidth - 1sz alignedTo: self tabWidth.
                }.
                _: {
                    currentColumnIndex := currentColumnIndex + 1sz.
                }
            }
        } continueWith: (index := index + 1sz).

        index
    }.

    public override method forIndex: (index: Size) computeLine: (outLine: Size ref) andColumn: (outColumn: Size ref) ::=> Void := {
        outLine := 0sz.
        outColumn := 0sz.

        let i mutable := 0sz.
        let lastIsCr mutable := false.
        let loopEnd := index min: contents size.
        while: i < loopEnd do: {
            let c := contents char8At: i.
            switch: c withCases: #{
                '\r'c8 : {
                    outLine := outLine + 1sz.
                    outColumn := 0sz.
                    lastIsCr := true.
                }.
                '\n'c8 : {
                    lastIsCr ifFalse: {
                        outLine := outLine + 1sz.
                        outColumn := 0sz.
                    }.
                    lastIsCr := false.
                }.
                '\t'c8 : {
                    lastIsCr := false.
                    outColumn := outColumn + self tabWidth - 1sz alignedTo: self tabWidth.
                }.
                _: {
                    lastIsCr := false.
                    outColumn := outColumn + 1sz.
                }
            }

        } continueWith: (i := i + 1sz).
    }.

    public override method numberOfLines ::=> Size := {
        let lineCount mutable := 1sz.

        let i mutable := 0sz.
        let lastIsCr mutable := false.
        while: i < contents size do: {
            let c := contents char8At: i.
            switch: c withCases: #{
                '\r'c8 : {
                    lineCount := lineCount + 1sz.
                    lastIsCr := true.
                }.
                '\n'c8 : {
                    lastIsCr ifFalse: {
                        lineCount := lineCount + 1sz
                    }.
                    lastIsCr := false.
                }.
                _: {
                    lastIsCr := false.
                }
            }

        } continueWith: (i := i + 1sz).

        lineCount.
    }.

    public override method numberOfColumnsInLine: (lineIndex: Size) ::=> Size := {
        let index mutable := self computeIndexForLine: lineIndex.

        let currentColumnIndex mutable := 0sz.
        while: index < contents size do: {
            let c := contents char8At: index.
            switch: c withCases: #{
                '\r'c8 : {
                    return: currentColumnIndex.
                }.
                '\n'c8 : {
                    return: currentColumnIndex.
                }.
                '\t'c8 : {
                    currentColumnIndex := currentColumnIndex + self tabWidth - 1sz alignedTo: self tabWidth.
                }.
                _: {
                    currentColumnIndex := currentColumnIndex + 1sz.
                }
            }
        } continueWith: (index := index + 1sz).

        currentColumnIndex
    }.

    let StringSpanIterationFunction := (String, Size, Size) => Void.
    public override method stringSpansDo: (aBlock: StringSpanIterationFunction) ::=> Void := {
        aBlock(contents, 0sz, contents size)
    }.
}.
