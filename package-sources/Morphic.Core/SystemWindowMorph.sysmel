public class SystemWindowMorph superclass: WorldMorph; definition: {
    private field title => String.
    public field window => Window.
    protected field windowRenderer => WindowFormRenderer.
    protected field renderbuffer => Form.
    protected field hasDirtyRendering => Boolean.

    public method renderOnWindow => Void := {
        let windowExtent := window extent.
        self extent: windowExtent asFloat32x2.

        let renderbufferExtent := windowRenderer drawableSurfaceExtent.
        renderbuffer isNil || (renderbuffer extent ~= renderbufferExtent) ifTrue: {
            renderbuffer := Form forRenderingWithExtent: renderbufferExtent
        }.

        renderbuffer fillWithColor: self color.

        let windowScaleFactor := renderbufferExtent asFloat32x2 / windowExtent asFloat32x2.

        let builder := FormSGBuilder new.
        let sceneGraph := self buildChildrenSceneGraphWith: builder.
        FormSGFormRenderer new renderSceneGraph: sceneGraph scaleFactor: windowScaleFactor onForm: renderbuffer.

        windowRenderer presentForm: renderbuffer.
        hasDirtyRendering := false.
    }.

    public override method defaultExtent => Float32x2
        := 640f32 @ 480f32.

    public override method defaultColor => Color
        := Color white.

    public method onWindowCloseRequest => Void := {
        window close
    }.

    public override method changed => Void := {
        hasDirtyRendering := true.
        window ifNotNil: {window markDirtyRendering}.
    }.
}.

public class SystemWindowMorphEventHandler superclass: EventHandler; definition: {
    public field morph => SystemWindowMorph.

    public override method onExposeEvent: (event: ExposeEvent) ::=> Void := {
        morph renderOnWindow
    }.

    public override method onValidateRenderingEvent: (event: ValidateRenderingEvent) ::=> Void := {
        morph renderOnWindow
    }.

    public override method onWindowCloseRequestEvent: (event: WindowCloseRequestEvent) ::=> Void := {
        morph onWindowCloseRequest
    }.

    public override method onWindowResizeEvent: (event: WindowResizeEvent) ::=> Void := {
        morph renderOnWindow
    }.
    
    public override method onWindowSizeChangedEvent: (event: WindowSizeChangedEvent) ::=> Void := {
        morph renderOnWindow
    }.

    public override method onMouseButtonPressedEvent: (event: MouseButtonPressedEvent) ::=> Void := {
        morph processMouseButtonPressedEvent: event
    }.

    public override method onMouseButtonReleasedEvent: (event: MouseButtonReleasedEvent) ::=> Void := {
        morph processMouseButtonReleasedEvent: event
    }.

    public override method onMouseMoveEvent: (event: MouseMoveEvent) ::=> Void := {
        morph processMouseMoveEvent: event
    }.

    public override method onMouseWheelEvent: (event: MouseWheelEvent) ::=> Void := {
        morph processMouseWheelEvent: event
    }.

    public override method onKeyPressedEvent: (event: KeyPressedEvent) ::=> Void := {
        morph processKeyPressedEvent: event
    }.

    public override method onKeyReleasedEvent: (event: KeyReleasedEvent) ::=> Void := {
        morph processKeyReleasedEvent: event
    }.

    public override method onTextInputEvent: (event: TextInputEvent) ::=> Void := {
        morph processTextInputEvent: event
    }.

    public override method onTextEditingEvent: (event: TextEditingEvent) ::=> Void := {
        morph processTextEditingEvent: event
    }.
}.

Morph definition: {
    public virtual method openInWindowSystem: (windowSystem: WindowSystem) ::=> SystemWindowMorph := {
        let windowMorph := SystemWindowMorph new.
        windowMorph extent: self extent.
        windowMorph addMorph: self.
        windowMorph layout: (MorphFullLayout for: self).
        windowMorph openInWindowSystem: windowSystem
    }.

    public virtual method openInWindowSystem ::=> SystemWindowMorph
        := self openInWindowSystem: WindowSystem default.
}.

SystemWindowMorph definition: {
    public override method openInWindowSystem: (windowSystem: WindowSystem) ::=> SystemWindowMorph := {
        window := windowSystem createWindowWithTitle: (title ifNil: "") extent: (self extent ceiling asUInt32x2 max: 1u32x2).
        window eventHandler: (SystemWindowMorphEventHandler new
            morph: self;
            yourself).
        windowRenderer := window newFormRenderer.
        self
    }.
}.
