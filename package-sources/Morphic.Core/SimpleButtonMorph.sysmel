public class SimpleButtonMorph superclass: BorderedMorph; definition: {
    protected field label => StringMorph.
    protected field state => Boolean.

    public override method initialize => Void := {
        super initialize.
    	self color: (Color r: 0.4f32 g: 0.8f32 b: 0.6f32).
        self setDefaultLabel.
    }.

    public override method colorToUse => Color
        := state ifTrue: Color white ifFalse: color.

    public method label ::=> String
        := label contents.

    public method label: (aString: String) ::=> Void := {
        label ifNotNil: (label delete).

        label := StringMorph contents: aString.
        self extent: label extent + 12f32x2.
        self addMorph: label.

        self updateLayout
    }.

    public override method updateLayout => Void := {
        label ifNotNil: {
            label position: (self extent - label extent) / 2f32x2.
        }.

        super updateLayout
    }.

    public method setDefaultLabel => Void := {
        self label: self defaultLabel
    }.

    public virtual method defaultLabel => String
        := "Flash".

    public override method handlesMouseButtonPressedEvent: (event: MouseButtonPressedEvent) ::=> Boolean
        := event wasHandled not.

    public override method onMouseButtonPressedEvent: (event: MouseButtonPressedEvent) ::=> Void := {
        event wasHandled: true.
        state := true.
        self changed.
        printLine("Button pressed")
    }.

    public override method handlesMouseButtonReleasedEvent: (event: MouseButtonPressedEvent) ::=> Boolean
        := event wasHandled not.

    public override method onMouseButtonReleasedEvent: (event: MouseButtonPressedEvent) ::=> Void := {
        event wasHandled: true.
        state := false.
        self changed.
        printLine("Button released")
    }.
}.
