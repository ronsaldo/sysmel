public class SystemBrowser superclass: PanelMorph; definition: {
    protected field programEntityTreeView => TreeViewMorph.

    public override method initialize => Void := {
        super initialize.

        programEntityTreeView := TreeViewMorph new
            addColumn: ((StringTableViewColumn named: "Name") display: {:element :: String | element shortPrintString}; yourself);
            children: {:element :: Collection | element children };
            roots: (Array with: __Global__);
            when: TableViewRowActivatedAnnouncement do: {:(TableViewRowActivatedAnnouncement)announcement :: Void |
                self onActivatedProgramEntityTreeViewElement: announcement rowElement
            };
            when: TableViewSelectionChangedAnnouncement do: {:(TableViewSelectionChangedAnnouncement)announcement :: Void |
                self onProgramEntityTreeViewSelectionChanged: announcement selection
            };
            yourself.

        self
            addMorph: programEntityTreeView;
            layout: (MorphVerticalBoxLayout new
                add: programEntityTreeView proportion: 1f32 borderWidth: 2f32;
                yourself)
    }.

    public override method defaultExtent => Float32x2 := 600f32@400f32.

    public method onActivatedProgramEntityTreeViewElement: (programEntity: ProgramEntity) ::=> Void := {
        programEntity inspect
    }.

    public method onProgramEntityTreeViewSelectionChanged: (newSelection: TableRowSelection) ::=> Void := {
    }.
}.
