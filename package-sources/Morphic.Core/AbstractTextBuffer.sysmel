public abstract class AbstractTextBuffer definition: {
    public abstract method contents => String
        := self subclassResponsibility.

    public abstract method contents: (newContents: String) ::=> Void
        := self subclassResponsibility.

    public abstract method size => Size
        := self subclassResponsibility.

    public abstract method replaceFrom: (startIndex: Size) until: (endIndex: Size) withString: (replacement: String) ::=> Size
        := self subclassResponsibility.

    public abstract method computeIndexForLine: (lineIndex: Size) andColumn: (columnIndex: Size) ::=> Size
        := self subclassResponsibility.

    public abstract method forIndex: (index: Size) computeLine: (outLine: Size ref) andColumn: (outColumn: Size ref) ::=> Void
        := self subclassResponsibility.

    public abstract method numberOfLines ::=> Size
        := self subclassResponsibility.

    public abstract method numberOfColumnsInLine: (lineIndex: Size) ::=> Size
        := self subclassResponsibility.

    let StringSpanIterationFunction := (String, Size, Size) => Void.
    public abstract method stringSpansDo: (aBlock: StringSpanIterationFunction) ::=> Void
        := self subclassResponsibility.

    public virtual method tabWidth => Size
        := 4sz.
}.
