TableViewRowMorph definition: {
    public field rowIndex => Size.
    protected field cells => Array.

    public method tableViewMorph => TableViewMorph
        := (owner downCastTo: TableViewContentMorph) tableViewMorph.

    public method dataSource => DataSource
        := self tableViewMorph dataSource.

    public method columns => OrderedCollection
        := self tableViewMorph columns.

    public override method defaultColor => Color
        := Color transparent.

    public override method colorToUse => Color := {
        self isSelected ifTrue: {
            Color cyan
        } ifFalse: {
            super colorToUse
        }
    }.

    public method isSelected => Boolean
        := self tableViewMorph isRowSelected: rowIndex.

    public method createCells => Void := {
        let dataSource := self dataSource.
        dataSource ifNil: {return: void}.

        let element := dataSource elementAtRow: rowIndex.
        let elementModel := dataSource elementModelAtRow: rowIndex.
        cells := self columns collect: {:(TableViewColumn)eachColumn :: Morph |
            let cellMorph := eachColumn createCellMorphForElement: element model: elementModel.
            self addMorph: cellMorph.
            cellMorph
        } as: Array.
    }.

    public method updateContent => Void := {
        let dataSource := self dataSource.
        dataSource ifNil: {return: void}.

        let columns := self columns.
        let element := dataSource elementAtRow: rowIndex.
        let elementModel := dataSource elementModelAtRow: rowIndex.
        cells doWithIndex: {:(Morph)cellMorph :(Size)cellIndex :: Void |
            let viewColumn => TableViewColumn := columns at: cellIndex.
            viewColumn updateCellMorph: cellMorph withElement: element model: elementModel
        }.
    }.

    public override method updateLayout => Void := {
        let rowDepth := self dataSource depthOfRow: rowIndex.
        let spaceWidth := FontFace default measureWidthForString: " ".

        let cellX mutable := rowDepth asFloat32 * spaceWidth.
        let cellHeight := self extent y.

        let columns := self columns.
        cells doWithIndex: {:(Morph)cellMorph :(Size)cellIndex :: Void |
            let viewColumn => TableViewColumn := columns at: cellIndex.
            let cellWidth := viewColumn width.

            cellMorph bounds: (cellX@0f32 extent: cellWidth@cellHeight).
            cellX := cellX + cellWidth.
        }.
    }.

    public override method handlesMouseButtonPressedEvent: (event: MouseButtonPressedEvent) ::=> Boolean
        := event wasHandled not.

    public override method takesKeyboardFocus => Boolean
        := true.

    public override method onMouseButtonPressedEvent: (event: MouseButtonPressedEvent) ::=> Void := {
        super onMouseButtonPressedEvent: event.
        event isLeftButton ifTrue: {
            self tableViewMorph rowClicked: rowIndex.
            event wasHandled: true.
            self takeKeyboardFocus
        }.
    }.

    public override method handlesKeyPressedEvent: (event: KeyPressedEvent) ::=> Boolean
        := event wasHandled not.

    public override method onKeyPressedEvent: (event: KeyPressedEvent) ::=> Void := {
        switch: event symbol withCases: #{
            KeySymbol Return : {
                self isSelected ifTrue: {
                    self tableViewMorph rowActivated: rowIndex.
                    event wasHandled: true.
                }
            }.
            _: {}
        }
    }.

}.
