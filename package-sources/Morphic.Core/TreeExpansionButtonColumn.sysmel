public class TreeExpansionButtonMorph superclass: Morph; definition: {
    public field treeElement => SimpleTreeDataSourceElement.

    public override method defaultExtent => Float32x2
        := FontFace default measureExtentForString: "+ ".

    public override method buildSceneGraphWith: (builder: FormSGBuilder) ::=> FormSGNode
        := (builder string: (treeElement hasChildren
                ifTrue: (treeElement isExpanded ifTrue: "- " ifFalse: "+ ")
                ifFalse: "  ")
            in: self localBounds fontFace: FontFace default color: Color black).

    public override method handlesMouseButtonPressedEvent: (event: MouseButtonPressedEvent) ::=> Boolean
        := event wasHandled not.

    public override method onMouseButtonPressedEvent: (event: MouseButtonPressedEvent) ::=> Void := {
        super onMouseButtonPressedEvent: event.
        event isLeftButton ifTrue: {
            event wasHandled: true.
            treeElement toggleExpansion.
            self changed
        }.
    }.
}.

public class TreeExpansionButtonColumn superclass: TableViewColumn; definition: {
    public virtual method minimalCellExtent ::=> Float32x2
        := FontFace default measureExtentForString: "+ ".

    public override method createCellMorphForElement: element model: elementModel ::=> Morph
        := TreeExpansionButtonMorph new treeElement: elementModel; yourself.

    public override method updateCellMorph: (morph: Morph) withElement: element model: elementModel ::=> Void := {
        (morph downCastTo: TreeExpansionButtonMorph)
            treeElement: elementModel;
            changed
    }.
}.
