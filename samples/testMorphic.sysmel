#*
let treeView := TreeViewMorph new
    addColumn: ((StringTableViewColumn named: "Name") display: {:element :: String | element shortPrintString}; yourself);
    children: {:element :: Collection | element subtypes};
    roots: (Array with: AnyValue);
    yourself.

BorderedMorph new
    extent: 300f32x2;
    color: Color white;
    addMorph: treeView;
    layout: (MorphVerticalBoxLayout new
        add: treeView proportion: 1f32 borderWidth: 2f32;
        yourself);
    openInWindowSystem.
*#

BasicDevelopmentEnvironment new openInWindowSystem.
WindowSystem default run.
