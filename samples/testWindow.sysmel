let windowSystem := WindowSystem default.
let window := windowSystem createWindowWithTitle: "Hello World" extent: 640u32 @ 480u32.
window isAnimated: true.

let renderbuffer := Form forRenderingWithExtent: 640u32 @ 480u32.

let renderer := window newFormRenderer.
let sgBuilder := FormSGBuilder new.

let frameCount mutable := 0u32,
let frameTime mutable := 0f64.
let bmpFontForm := FontFace defaultPixelFont form.

public class TestWindowEventHandler superclass: EventHandler; definition: {
    public method render => Void := {
        let currentTime := Time::Timestamp::microsecondsNow() asFloat64 * 1.0e-6.
        let phase := currentTime *0.3.
        let gray := phase - phase floor.
        let grayColor := Color gray: gray asFloat32.
        renderbuffer fillWithColor: grayColor.

        let sceneGraph :=
            (sgBuilder rectangle: (0f32@0f32 extent: 200f32@100f32)
                linearGradientStart: 0f32@0f32 color: Color cyan
                end: 200f32@0f32 color: Color magenta)
            -- (sgBuilder rectangle: (20f32@30f32 extent: 64f32@32f32) color: Color blue)
            -- (sgBuilder borderRectangle: (20f32@30f32 extent: 64f32@32f32) color: Color red width: 4f32)
            -- (sgBuilder textureForm: bmpFontForm at: 70f32@120f32)
            -- (sgBuilder texturedRectangle: (300f32@150f32 extent: 256f32x2) form: bmpFontForm color: Color magenta)
            -- (sgBuilder string: "Hello World" at: 20f32@50f32 fontFace: FontFace defaultPixelFont color: Color green).

        FormSGFormRenderer new renderSceneGraph: sceneGraph onForm: renderbuffer.

        renderer presentForm: renderbuffer.
    }.

    public override method onTickEvent: (event: TickEvent) ::=> Void := {
        let delta := event deltaSeconds.
        printLine("Frame time ", delta * 1000.0f64, " ms ", 1.0f64 / delta).
        self render
    }.

    public override method onExposeEvent: (event: ExposeEvent) ::=> Void := {
        self render
    }.

    public override method onWindowCloseRequestEvent: (event: WindowCloseRequestEvent) ::=> Void := {
        window close
    }.
}.

window eventHandler: TestWindowEventHandler new.
windowSystem run