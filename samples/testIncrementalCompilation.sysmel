#*
*#


{
#*

public function addVector32x2(a: Int32x2, b: Int32x2) => Int32x2
    := a + b.

public function addVector32x3(a: Int32x3, b: Int32x3) => Int32x3
    := a + b.

public function addVector32x4(a: UInt32x4, b: UInt32x4) => UInt32x4
    := a + b.

public function addVector64x2(a: Int32x2, b: Int32x2) => Int32x2
    := a + b.

public function addVector64x3(a: Int32x3, b: Int32x3) => Int32x3
    := a + b.

public function addVector64x4(a: UInt32x4, b: UInt32x4) => UInt32x4
    := a + b.
*#

public function makeInt32WithAll(element: UInt32) => UInt32x4
    := UInt32x4 withAll: element.

public function makeVectorWithAll(element: Boolean64) => Boolean64x2
    := Boolean64x2 withAll: element.

##public function ones() => Boolean64x2
##    := Boolean64x2 ones.

public function getVectorX(v: Boolean64x2) => Boolean64
    := v x.

public function makeVectorX(x: Boolean64) => Boolean64x2
    := Boolean64x2 x: x.

public function makeVector(x: Boolean64, y: Boolean64) => Boolean64x2
    := Boolean64x2 x: x y: y.

public function vectorAt(v: Boolean64x2, index: Size) => Boolean64
    := v at: index.

public function myVectorY(v: Boolean64x2) => Boolean64
    := v at: 1sz.

public function negated(v: UInt32x4) => UInt32x4
    := v negated.

public function add(a: UInt32x4, b: UInt32x4) => UInt32x4
    := a + b.

public function sub(a: UInt32x4, b: UInt32x4) => UInt32x4
    := a - b.

public function mul(a: UInt32x4, b: UInt32x4) => UInt32x4
    := a * b.

public function shiftLeft(a: UInt32x4, b: UInt32x4) => UInt32x4
    := a << b.

public function shiftRight(a: UInt32x4, b: UInt32x4) => UInt32x4
    := a >> b.

public function min(a: UInt32x4, b: UInt32x4) => UInt32x4
    := a min: b.

public function max(a: UInt32x4, b: UInt32x4) => UInt32x4
    := a max: b.

public function bitInvert(v: UInt32x4) => UInt32x4
    := v bitInvert.

public function bitAnd(a: UInt32x4, b: UInt32x4) => UInt32x4
    := a & b.

public function bitOr(a: UInt32x4, b: UInt32x4) => UInt32x4
    := a | b.

public function bitXor(a: UInt32x4, b: UInt32x4) => UInt32x4
    := a ^ b.

public function abs(v: Int32x4) => Int32x4
    := v abs.

##public function myOnes() => Boolean64x2
##    := Boolean64x2 withAll: 1i32.

public enum TestEnum valueType: UInt8; values: #{
    First: 0u8.
    Second: 1u8.
}.

public function enumIdentity(v: TestEnum) => TestEnum
    := v.

public function enumGetValue(v: TestEnum) => UInt8
    := v value.
    
let asmCompilationTarget := AsmCompilationTarget x86_64 setForLinux.

let hirModule := (HIRModuleCompilationContext forTarget: asmCompilationTarget asMirCompilationTarget asHIRCompilationTarget)
    exclusiveCompilationMode: true;
    compileFunctionsWithDefinitions: (
        enumIdentity,);
    finish.

hirModule performStandardOptimizations.
##printLine(hirModule fullPrintString).

##let nativeCodes := hirModule asNativeCodesFor: AsmCompilationTarget x86_64 setForLinux asMirCompilationTarget keepingIRTextForDebugging: true.
##printLine(nativeCodes fullPrintString).

let nativeCode := hirModule asNativeCodeFor: asmCompilationTarget asMirCompilationTarget keepingIRTextForDebugging: true.
printLine(nativeCode hirTextIR).
printLine(nativeCode mirTextIR).
printLine(nativeCode asmTextIR).

let nativeObjectCode := nativeCode asAsmObjectCodeWithTarget: asmCompilationTarget.
let nativeLinkedObjectCode := AsmProgramEntity new
    compilationTarget: asmCompilationTarget;
    ##buildTargetUnwindingInfoForObjectCode: nativeObjectCode;
    buildDebugInfoForObjectCode: nativeObjectCode;
    assembleAppendingNewSectionsToObjectObject: nativeObjectCode.

##printLine(nativeObjectCode fullPrintString).
nativeLinkedObjectCode writeObjectToFileNamed: "test.o".

}.
